---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, agenda, track, type Sesi } from '../data/acara';

const ruang = (kode?: string) => track.find((t) => t.kode === kode)?.ruang ?? 'Aula Utama';

/** Sesi dengan jam yang sama digabung jadi satu slot supaya track paralel tampil berdampingan. */
const slot = (sesi: Sesi[]) =>
  sesi.reduce<{ jam: string; isi: Sesi[] }[]>((acc, s) => {
    const last = acc[acc.length - 1];
    if (last && last.jam === s.jam) last.isi.push(s);
    else acc.push({ jam: s.jam, isi: [s] });
    return acc;
  }, []);
---
<Base title={`Agenda — ${acara.nama} ${acara.tahun}`} description={`Jadwal lengkap ${acara.nama} ${acara.tahun}: ${agenda.length} hari, ${track.length} track, di ${acara.venue}, ${acara.kota}.`}>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pt-12 md:px-6 md:pt-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{acara.tanggalPendek} · {acara.venue}</p>
        <h1 class="mt-4 font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight md:text-8xl">Agenda</h1>
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-12 md:items-end">
          <p class="max-w-[58ch] text-[15px] leading-relaxed text-[#f5f5f0]/75 md:col-span-7 md:text-base">
            Sesi paralel berjalan di tiga ruang yang berjarak satu lorong. Semua jam dalam WIB; jadwal bisa bergeser 5–10 menit, pengumuman di layar lobi.
          </p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2 md:col-span-5 md:justify-end" aria-label="Kode track">
            {track.map((t) => (
              <li class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70"><span class="text-[#e2ff4d]">{t.kode}</span> {t.ruang}</li>
            ))}
          </ul>
        </div>
        <!-- Tab hari -->
        <div class="mt-10 flex" role="tablist" aria-label="Pilih hari">
          {agenda.map((h, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${i}`}
              aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab-hari -mb-px min-h-[44px] flex-1 border-b-2 border-transparent pb-4 pr-6 text-left text-[#f5f5f0]/70 transition-colors duration-150 hover:text-[#f5f5f0] aria-selected:border-[#e2ff4d] aria-selected:text-[#e2ff4d] sm:flex-none sm:pr-12"
            >
              <span class="block font-display text-2xl font-extrabold uppercase tracking-tight md:text-3xl">{h.hari}</span>
              <span class="block font-mono text-xs">{h.tanggal}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-16">
      {agenda.map((h, i) => (
        <ol id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} tabindex="0" data-panel={i} class:list={['border-t border-[#f5f5f0]/15', i !== 0 && 'hidden']}>
          {slot(h.sesi).map((sl) => {
            const jeda = sl.isi.every((s) => s.jenis === 'istirahat');
            const paralel = sl.isi.length > 1;
            return (
              <li class:list={['grid grid-cols-1 gap-3 border-b border-[#f5f5f0]/15 py-5 md:grid-cols-12 md:gap-6', jeda ? 'md:py-3' : 'md:py-7']}>
                <span class:list={['font-mono tabular-nums md:col-span-2', jeda ? 'text-sm text-[#f5f5f0]/60' : 'text-base text-[#e2ff4d] md:text-lg']}>{sl.jam}</span>
                {jeda ? (
                  <p class="text-sm text-[#f5f5f0]/60 md:col-span-10">{sl.isi[0].judul}</p>
                ) : (
                  <div class:list={['md:col-span-10', paralel && 'grid grid-cols-1 gap-px bg-[#f5f5f0]/15 md:grid-cols-3']}>
                    {sl.isi.map((s) => (
                      <div class:list={[paralel && 'bg-[#0b0b0b] py-3 first:pt-0 md:px-5 md:py-0 md:first:pl-0']}>
                        <p class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/60">
                          {s.jenis === 'keynote' ? 'Semua · Aula Utama' : <><span class="text-[#e2ff4d]">{s.track}</span> · {ruang(s.track)}</>}
                        </p>
                        <p class:list={['mt-2 font-display font-bold leading-snug', paralel ? 'text-lg' : 'text-xl md:text-2xl']}>{s.judul}</p>
                        {s.pembicara && <p class="mt-1 text-sm text-[#f5f5f0]/70">{s.pembicara}</p>}
                      </div>
                    ))}
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      ))}
      <p class="mt-8 text-sm text-[#f5f5f0]/70">Belum punya tiket? <a href="/tiket/" class="text-[#e2ff4d] underline underline-offset-4">Daftar sebelum {acara.earlyBirdTutup}</a> untuk harga early bird.</p>
    </section>
  </main>
  <Footer />

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-hari'));
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    const pilih = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const aktif = t === tab;
        t.setAttribute('aria-selected', String(aktif));
        t.tabIndex = aktif ? 0 : -1;
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.id !== tab.getAttribute('aria-controls')));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => pilih(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        pilih(next);
        next.focus();
      });
    });
  </script>
</Base>
