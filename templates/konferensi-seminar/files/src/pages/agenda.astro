---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, agenda, track } from '../data/acara';

const ruang = (kode?: string) => track.find((t) => t.kode === kode)?.ruang ?? 'Aula Utama';
---
<Base title={`Agenda — ${acara.nama} ${acara.tahun}`} description={`Jadwal lengkap ${acara.nama} ${acara.tahun}: ${agenda.length} hari, ${track.length} track, di ${acara.venue}, ${acara.kota}.`}>
  <Fonts />
  <Header />
  <main>
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 md:px-6 md:pt-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{acara.tanggalPendek} · {acara.venue}</p>
        <h1 class="mt-4 font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight md:text-8xl">Agenda</h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-[#f5f5f0]/70 md:text-base">
          Sesi paralel berjalan di tiga ruang yang berjarak satu lorong. Semua jam dalam WIB; jadwal bisa bergeser 5–10 menit, pengumuman di layar lobi.
        </p>
        <!-- Tab hari -->
        <div class="mt-10 flex gap-0 border-b border-[#f5f5f0]/15" role="tablist" aria-label="Pilih hari">
          {agenda.map((h, i) => (
            <button
              type="button"
              role="tab"
              data-hari={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="tab-hari -mb-px min-h-[44px] border-b-2 border-transparent px-1 pb-3 pr-8 text-left transition-colors duration-150 hover:text-[#e2ff4d] aria-pressed:border-[#e2ff4d] aria-pressed:text-[#e2ff4d]"
            >
              <span class="block font-display text-2xl font-extrabold uppercase tracking-tight md:text-3xl">{h.hari}</span>
              <span class="block font-mono text-xs text-[#f5f5f0]/60">{h.tanggal}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-16">
      {agenda.map((h, i) => (
        <ol data-panel={i} class:list={['divide-y divide-[#f5f5f0]/15 border-b border-[#f5f5f0]/15', i !== 0 && 'hidden']}>
          {h.sesi.map((s) => (
            <li class:list={['grid grid-cols-1 gap-2 py-5 sm:grid-cols-12 sm:gap-6', s.jenis === 'istirahat' && 'bg-[#141414] px-3 sm:-mx-3']}>
              <span class="font-mono text-sm text-[#e2ff4d] sm:col-span-2 md:text-base">{s.jam}</span>
              <div class="sm:col-span-7">
                <p class:list={['leading-snug', s.jenis === 'istirahat' ? 'text-sm text-[#f5f5f0]/60' : 'font-display text-lg font-bold md:text-xl']}>{s.judul}</p>
                {s.pembicara && <p class="mt-1 text-sm text-[#f5f5f0]/70">{s.pembicara}</p>}
              </div>
              <div class="sm:col-span-3 sm:text-right">
                {s.jenis !== 'istirahat' && (
                  <p class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/60">
                    {s.jenis === 'keynote' ? 'SEMUA · Aula Utama' : `${s.track} · ${ruang(s.track)}`}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      ))}
    </section>
  </main>
  <Footer />

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-hari');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== tab.dataset.hari));
      });
    });
  </script>
</Base>
