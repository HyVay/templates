---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, track, alasan, pembicara, sponsor, tiket, rupiah, img } from '../data/acara';

const earlyBird = tiket[0];
const reguler = tiket[1];
const utama = pembicara.filter((p) => p.utama).slice(0, 4);
const stub = [acara.tanggalPendek, acara.kota.toUpperCase(), '2 HARI', `${track.length} TRACK`, acara.kapasitas.toUpperCase()];
---
<Base title={`${acara.nama} ${acara.tahun} — ${acara.tanggalTeks}, ${acara.kota}`} description={acara.deskripsi}>
  <Fonts />
  <Header />
  <main id="konten">
    <!-- Hero -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pb-12 pt-12 md:px-6 md:pb-16 md:pt-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">Konferensi engineering &amp; produk · edisi ke-4</p>
        <div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-8">
            <h1 class="font-display text-[3.25rem] font-extrabold uppercase leading-[0.9] tracking-tight sm:text-7xl md:text-8xl xl:text-[7.25rem]">
              Nusantara<br />Dev<br />Summit <span class="text-[#e2ff4d]">{acara.tahun}</span>
            </h1>
            <p class="mt-8 max-w-[58ch] text-base leading-relaxed text-[#f5f5f0]/80 md:text-lg">{acara.tagline} {acara.deskripsi}</p>
          </div>
          <!-- Kartu tiket: harga, batas, dan aksi utama di satu tempat -->
          <aside class="border border-[#f5f5f0]/25 lg:col-span-4" aria-label="Tiket early bird">
            <div class="flex items-center justify-between border-b border-dashed border-[#f5f5f0]/25 px-5 py-3 font-mono text-xs uppercase tracking-widest">
              <span class="text-[#f5f5f0]/70">Early bird</span>
              <span class="text-[#e2ff4d]">s.d. {acara.earlyBirdTutupPendek}</span>
            </div>
            <div class="px-5 pt-5">
              <p class="font-display text-4xl font-extrabold tabular-nums tracking-tight md:text-5xl">{rupiah(earlyBird.harga)}</p>
              <p class="mt-2 text-sm leading-snug text-[#f5f5f0]/70">Dua hari, makan siang, rekaman sesi, dan kaus. Setelah {acara.earlyBirdTutup} jadi {rupiah(reguler.harga)}.</p>
            </div>
            <div class="flex flex-col gap-2 p-5">
              <a href="/tiket/" class="inline-flex min-h-[48px] items-center justify-center bg-[#e2ff4d] px-6 font-mono text-sm uppercase tracking-widest text-[#0b0b0b] transition-colors duration-150 hover:bg-[#f5f5f0]">Ambil tiket</a>
              <a href="/agenda/" class="inline-flex min-h-[48px] items-center justify-center border border-[#f5f5f0]/40 px-6 font-mono text-sm uppercase tracking-widest transition-colors duration-150 hover:border-[#e2ff4d] hover:text-[#e2ff4d]">Lihat agenda</a>
            </div>
          </aside>
        </div>
      </div>
      <!-- Ticket stub -->
      <div class="border-t border-[#f5f5f0]/15">
        <ul class="mx-auto grid max-w-7xl grid-cols-2 px-4 sm:flex sm:flex-wrap md:px-6">
          {stub.map((s, i) => (
            <li class:list={[
              'border-[#f5f5f0]/15 py-3 font-mono text-xs tabular-nums tracking-widest text-[#f5f5f0]/80 md:text-sm',
              'border-b sm:border-b-0 sm:px-4 sm:first:pl-0 sm:[&:not(:first-child)]:border-l',
              i % 2 === 1 && 'border-l pl-4 sm:pl-4',
              i === stub.length - 1 && 'border-b-0',
            ]}>{s}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Foto audiens -->
    <div class="relative overflow-hidden border-b border-[#f5f5f0]/15 bg-[#1a1a1a]">
      <img
        src={img(acara.fotoAudiens, 1600, 686)}
        srcset={`${img(acara.fotoAudiens, 800, 343)} 800w, ${img(acara.fotoAudiens, 1600, 686)} 1600w, ${img(acara.fotoAudiens, 2400, 1029)} 2400w`}
        sizes="100vw"
        width="1600"
        height="686"
        alt="Peserta konferensi tahun lalu di aula utama"
        decoding="async"
        class="aspect-[16/10] w-full object-cover grayscale sm:aspect-[21/9]"
      />
      <div class="absolute inset-0 z-0 bg-[#e2ff4d] mix-blend-multiply opacity-60 pointer-events-none"></div>
      <p class="absolute bottom-4 left-4 z-10 bg-[#0b0b0b] px-2 py-1 font-mono text-xs uppercase tracking-widest text-[#f5f5f0] md:left-6">Aula utama, edisi 2025</p>
    </div>

    <!-- Mengapa datang -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <div class="md:col-span-4"><h2 class="font-display text-3xl font-extrabold uppercase leading-none tracking-tight md:sticky md:top-24 md:text-5xl">Kenapa<br />datang</h2></div>
          <ol class="divide-y divide-[#f5f5f0]/15 border-y border-[#f5f5f0]/15 md:col-span-8">
            {alasan.map((a, i) => (
              <li class="grid grid-cols-1 gap-3 py-7 sm:grid-cols-12 sm:gap-6">
                <span class="font-mono text-sm text-[#e2ff4d] sm:col-span-2">0{i + 1}</span>
                <div class="sm:col-span-10">
                  <h3 class="font-display text-xl font-bold leading-tight md:text-2xl">{a.judul}</h3>
                  <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[#f5f5f0]/75 md:text-base">{a.isi}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Pembicara utama -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none tracking-tight md:text-5xl">Pembicara utama</h2>
          <a href="/pembicara/" class="inline-flex min-h-[44px] shrink-0 items-center font-mono text-xs uppercase tracking-widest underline underline-offset-4 transition-colors duration-150 hover:text-[#e2ff4d]">Semua {pembicara.length} pembicara</a>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4 md:gap-x-6">
          {utama.map((p) => (
            <article class="group">
              <div class="overflow-hidden bg-[#1a1a1a]">
                <img src={img(p.foto, 600, 800)} alt={`Foto ${p.nama}`} width="600" height="800" loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover grayscale transition-[filter] duration-300 group-hover:grayscale-0" />
              </div>
              <p class="mt-4 font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{p.track}</p>
              <h3 class="mt-1 font-display text-lg font-bold leading-tight">{p.nama}</h3>
              <p class="text-sm text-[#f5f5f0]/70">{p.jabatan}, {p.perusahaan}</p>
              <p class="mt-3 border-t border-[#f5f5f0]/15 pt-3 text-sm leading-snug text-[#f5f5f0]/90">“{p.topik}”</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Sponsor -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-10 md:px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/60">Didukung oleh</p>
        <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          {sponsor.map((s) => <li class="font-display text-xl font-extrabold uppercase tracking-tight text-[#f5f5f0]/70">{s}</li>)}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#e2ff4d] text-[#0b0b0b]">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-16 md:grid-cols-12 md:items-center md:px-6 md:py-20">
        <div class="md:col-span-8">
          <h2 class="font-display text-4xl font-extrabold uppercase leading-[0.95] tracking-tight md:text-6xl">Early bird tutup<br />{acara.earlyBirdTutup}.</h2>
          <p class="mt-4 font-mono text-sm tracking-wide">{rupiah(earlyBird.harga)} untuk 2 hari, termasuk makan siang. Setelah itu {rupiah(reguler.harga)}.</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/tiket/" class="inline-flex min-h-[52px] w-full items-center justify-center bg-[#0b0b0b] px-8 sm:w-auto font-mono text-sm uppercase tracking-widest text-[#f5f5f0] transition-colors duration-150 hover:bg-[#333]">Daftar sekarang</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
