---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, track, alasan, pembicara, sponsor } from '../data/acara';

const utama = pembicara.filter((p) => p.utama).slice(0, 4);
const stub = [acara.tanggalPendek, acara.kota.toUpperCase(), '2 HARI', `${track.length} TRACK`, acara.kapasitas.toUpperCase()];
---
<Base title={`${acara.nama} ${acara.tahun} — ${acara.tanggalTeks}, ${acara.kota}`} description={acara.deskripsi}>
  <Fonts />
  <Header />
  <main>
    <!-- Hero -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 md:px-6 md:pb-12 md:pt-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">Konferensi engineering &amp; produk · edisi ke-4</p>
        <h1 class="mt-6 font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight sm:text-7xl md:text-[6.75rem]">
          Nusantara<br />Dev<br />Summit <span class="text-[#e2ff4d]">{acara.tahun}</span>
        </h1>
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end">
          <p class="max-w-xl text-base leading-relaxed text-[#f5f5f0]/80 md:col-span-7 md:text-lg">{acara.tagline} {acara.deskripsi}</p>
          <div class="flex flex-col gap-3 sm:flex-row md:col-span-5 md:justify-end">
            <a href="/tiket/" class="inline-flex items-center justify-center bg-[#e2ff4d] px-6 py-3.5 font-mono text-sm uppercase tracking-widest text-[#0b0b0b] transition-colors duration-150 hover:bg-[#f5f5f0]">Ambil tiket</a>
            <a href="/agenda/" class="inline-flex items-center justify-center border border-[#f5f5f0]/40 px-6 py-3.5 font-mono text-sm uppercase tracking-widest transition-colors duration-150 hover:border-[#e2ff4d] hover:text-[#e2ff4d]">Lihat agenda</a>
          </div>
        </div>
      </div>
      <!-- Ticket stub -->
      <div class="border-t border-[#f5f5f0]/15">
        <ul class="mx-auto flex max-w-7xl flex-wrap divide-x divide-[#f5f5f0]/15 px-4 md:px-6">
          {stub.map((s) => <li class="py-3 pr-4 font-mono text-xs tracking-widest text-[#f5f5f0]/80 [&:not(:first-child)]:pl-4 md:text-sm">{s}</li>)}
        </ul>
      </div>
    </section>

    <!-- Foto audiens -->
    <div class="relative overflow-hidden border-b border-[#f5f5f0]/15">
      <img
        src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1600&q=80"
        alt="Peserta konferensi tahun lalu di aula utama"
        class="aspect-[16/10] w-full object-cover grayscale sm:aspect-[21/9]"
      />
      <div class="absolute inset-0 z-0 bg-[#e2ff4d] mix-blend-multiply opacity-60 pointer-events-none"></div>
      <p class="absolute bottom-4 left-4 z-10 font-mono text-xs uppercase tracking-widest text-[#0b0b0b] md:left-6">Aula utama, edisi 2025</p>
    </div>

    <!-- Mengapa datang -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none tracking-tight md:col-span-4 md:text-5xl">Kenapa<br />datang</h2>
          <ol class="divide-y divide-[#f5f5f0]/15 border-y border-[#f5f5f0]/15 md:col-span-8">
            {alasan.map((a, i) => (
              <li class="grid grid-cols-1 gap-3 py-7 sm:grid-cols-12 sm:gap-6">
                <span class="font-mono text-sm text-[#e2ff4d] sm:col-span-2">0{i + 1}</span>
                <div class="sm:col-span-10">
                  <h3 class="font-display text-xl font-bold leading-tight md:text-2xl">{a.judul}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-[#f5f5f0]/70 md:text-base">{a.isi}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Pembicara utama -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none tracking-tight md:text-5xl">Pembicara utama</h2>
          <a href="/pembicara/" class="shrink-0 font-mono text-xs uppercase tracking-widest underline underline-offset-4 transition-colors duration-150 hover:text-[#e2ff4d]">Semua {pembicara.length} pembicara</a>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4 md:gap-x-6">
          {utama.map((p) => (
            <article class="group">
              <div class="overflow-hidden bg-[#1a1a1a]">
                <img src={p.foto} alt={p.nama} loading="lazy" class="aspect-[3/4] w-full object-cover grayscale transition-all duration-300 group-hover:grayscale-0" />
              </div>
              <p class="mt-4 font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{p.track}</p>
              <h3 class="mt-1 font-display text-lg font-bold leading-tight">{p.nama}</h3>
              <p class="text-sm text-[#f5f5f0]/70">{p.jabatan}, {p.perusahaan}</p>
              <p class="mt-2 text-sm leading-snug text-[#f5f5f0]/90">{p.topik}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Sponsor -->
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 py-10 md:px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/50">Didukung oleh</p>
        <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          {sponsor.map((s) => <li class="font-display text-xl font-extrabold uppercase tracking-tight text-[#f5f5f0]/60">{s}</li>)}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#e2ff4d] text-[#0b0b0b]">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-16 md:grid-cols-12 md:items-center md:px-6 md:py-20">
        <div class="md:col-span-8">
          <h2 class="font-display text-4xl font-extrabold uppercase leading-[0.95] tracking-tight md:text-6xl">Early bird tutup<br />30 September.</h2>
          <p class="mt-4 font-mono text-sm tracking-wide">Rp 350.000 untuk 2 hari, termasuk makan siang. Setelah itu Rp 550.000.</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/tiket/" class="inline-flex items-center justify-center bg-[#0b0b0b] px-8 py-4 font-mono text-sm uppercase tracking-widest text-[#f5f5f0] transition-colors duration-150 hover:bg-[#333]">Daftar sekarang</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
