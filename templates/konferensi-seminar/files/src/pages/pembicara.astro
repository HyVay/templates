---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, pembicara, track, img } from '../data/acara';
---
<Base title={`Pembicara — ${acara.nama} ${acara.tahun}`} description={`${pembicara.length} pembicara ${acara.nama} ${acara.tahun} dari tim engineering, data, dan produk di Indonesia.`}>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 md:px-6 md:pt-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{pembicara.length} pembicara · {track.length} track</p>
        <h1 class="mt-4 font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight md:text-8xl">Pembicara</h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-[#f5f5f0]/70 md:text-base">
          Semua pembicara masih mengerjakan hal yang mereka presentasikan. Tidak ada sesi berbayar dari sponsor.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-20">
      <div class="grid grid-cols-2 gap-x-4 gap-y-12 md:grid-cols-4 md:gap-x-6">
        {pembicara.map((p, i) => (
          <article class="group">
            <div class="overflow-hidden bg-[#1a1a1a]">
              <img src={img(p.foto, 600, 800)} alt={`Foto ${p.nama}`} width="600" height="800" loading={i < 4 ? undefined : 'lazy'} decoding="async" class="aspect-[3/4] w-full object-cover grayscale transition-[filter] duration-300 group-hover:grayscale-0" />
            </div>
            <div class="mt-4 flex items-baseline justify-between">
              <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{p.track}</p>
              <p class="font-mono text-xs text-[#f5f5f0]/60">{String(i + 1).padStart(2, '0')}</p>
            </div>
            <h2 class="mt-1 font-display text-lg font-bold leading-tight md:text-xl">{p.nama}</h2>
            <p class="text-sm text-[#f5f5f0]/70">{p.jabatan}, {p.perusahaan}</p>
            <p class="mt-3 border-t border-[#f5f5f0]/15 pt-3 text-sm leading-snug">“{p.topik}”</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
