---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { acara, tiket, fiturTiket, rupiah } from '../data/acara';
---
<Base title={`Tiket — ${acara.nama} ${acara.tahun}`} description={`Harga tiket ${acara.nama} ${acara.tahun}: Early Bird, Reguler, dan Pelajar. Daftar lewat WhatsApp panitia.`}>
  <Fonts />
  <Header />
  <main>
    <section class="border-b border-[#f5f5f0]/15">
      <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 md:px-6 md:pt-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{acara.tanggalPendek} · {acara.kapasitas}</p>
        <h1 class="mt-4 font-display text-5xl font-extrabold uppercase leading-[0.92] tracking-tight md:text-8xl">Tiket</h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-[#f5f5f0]/70 md:text-base">
          Satu tiket berlaku dua hari. Pembayaran lewat transfer setelah panitia membalas pesan WhatsApp Anda dengan nomor rekening dan kode registrasi.
        </p>
      </div>
    </section>

    <!-- Tabel perbandingan -->
    <section class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-20">
      <!-- HP: daftar bertumpuk per tier -->
      <div class="divide-y divide-[#f5f5f0]/15 border-y border-[#f5f5f0]/15 md:hidden">
        {tiket.map((t, i) => (
          <div class="py-6">
            <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{t.nama}</p>
            <p class="mt-2 font-display text-3xl font-extrabold tracking-tight">{rupiah(t.harga)}</p>
            <p class="mt-1 text-xs leading-snug text-[#f5f5f0]/60">{t.catatan}</p>
            <ul class="mt-4 space-y-1.5 text-sm">
              {fiturTiket.map((f) => (
                <li class:list={['flex gap-3', !f.termasuk[i] && 'text-[#f5f5f0]/35 line-through']}>
                  <span class="font-mono text-[#e2ff4d]">{f.termasuk[i] ? 'YA' : '—'}</span>{f.nama}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <!-- Desktop: tabel perbandingan -->
      <div class="hidden md:block">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-[#f5f5f0]/15 align-bottom">
              <th class="w-1/3 pb-5 pr-4 font-mono text-xs font-normal uppercase tracking-widest text-[#f5f5f0]/50">Termasuk</th>
              {tiket.map((t) => (
                <th class="pb-5 pr-4">
                  <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">{t.nama}</p>
                  <p class="mt-2 font-display text-2xl font-extrabold tracking-tight md:text-3xl">{rupiah(t.harga)}</p>
                  <p class="mt-1 text-xs font-normal leading-snug text-[#f5f5f0]/60">{t.catatan}</p>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-[#f5f5f0]/15">
            {fiturTiket.map((f) => (
              <tr>
                <td class="py-4 pr-4 text-sm">{f.nama}</td>
                {f.termasuk.map((ya) => (
                  <td class="py-4 pr-4 font-mono text-sm">
                    {ya ? <span class="text-[#e2ff4d]">YA</span> : <span class="text-[#f5f5f0]/30">—</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Form -->
    <section class="border-t border-[#f5f5f0]/15">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-5">
          <h2 class="font-display text-3xl font-extrabold uppercase leading-none tracking-tight md:text-5xl">Daftar</h2>
          <ol class="mt-8 space-y-4 border-t border-[#f5f5f0]/15 pt-6 text-sm text-[#f5f5f0]/70">
            <li class="flex gap-4"><span class="font-mono text-[#e2ff4d]">01</span> Isi formulir, pesan terbuka di WhatsApp.</li>
            <li class="flex gap-4"><span class="font-mono text-[#e2ff4d]">02</span> Panitia membalas dengan nomor rekening dan kode registrasi dalam 1×24 jam.</li>
            <li class="flex gap-4"><span class="font-mono text-[#e2ff4d]">03</span> Transfer, kirim bukti, e-tiket dikirim ke email Anda.</li>
          </ol>
        </div>
        <form id="daftar-form" class="space-y-5 md:col-span-7">
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="nama" class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70">Nama lengkap</label>
              <input id="nama" name="nama" required placeholder="Sesuai kartu identitas" class="mt-2 w-full border border-[#f5f5f0]/30 bg-transparent px-3 py-3 text-sm outline-none transition-colors duration-150 placeholder:text-[#f5f5f0]/30 focus:border-[#e2ff4d]" />
            </div>
            <div>
              <label for="email" class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70">Email</label>
              <input id="email" name="email" type="email" required placeholder="untuk e-tiket" class="mt-2 w-full border border-[#f5f5f0]/30 bg-transparent px-3 py-3 text-sm outline-none transition-colors duration-150 placeholder:text-[#f5f5f0]/30 focus:border-[#e2ff4d]" />
            </div>
            <div>
              <label for="tier" class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70">Jenis tiket</label>
              <select id="tier" name="tier" class="mt-2 w-full border border-[#f5f5f0]/30 bg-[#0b0b0b] px-3 py-3 text-sm outline-none transition-colors duration-150 focus:border-[#e2ff4d]">
                {tiket.filter((t) => t.tersedia).map((t) => <option value={t.nama}>{t.nama} — {rupiah(t.harga)}</option>)}
              </select>
            </div>
            <div>
              <label for="jumlah" class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70">Jumlah</label>
              <input id="jumlah" name="jumlah" type="number" min="1" max="10" value="1" required class="mt-2 w-full border border-[#f5f5f0]/30 bg-transparent px-3 py-3 text-sm outline-none transition-colors duration-150 focus:border-[#e2ff4d]" />
            </div>
          </div>
          <div>
            <label for="catatan" class="font-mono text-xs uppercase tracking-widest text-[#f5f5f0]/70">Catatan (opsional)</label>
            <textarea id="catatan" name="catatan" rows="3" placeholder="Nama peserta lain kalau beli lebih dari satu, kebutuhan khusus, dll." class="mt-2 w-full border border-[#f5f5f0]/30 bg-transparent px-3 py-3 text-sm outline-none transition-colors duration-150 placeholder:text-[#f5f5f0]/30 focus:border-[#e2ff4d]"></textarea>
          </div>
          <button type="submit" class="w-full bg-[#e2ff4d] px-6 py-4 font-mono text-sm uppercase tracking-widest text-[#0b0b0b] transition-colors duration-150 hover:bg-[#f5f5f0] sm:w-auto">Kirim via WhatsApp</button>
          <p class="font-mono text-xs text-[#f5f5f0]/50">Situs ini statis. Formulir hanya menyusun pesan dan membukanya di WhatsApp panitia; tidak ada data yang disimpan di sini.</p>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: acara.wa, nama: acara.nama }}>
    const form = document.getElementById('daftar-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo panitia ${nama}, saya mau daftar.`,
        `Nama: ${d.get('nama')}`,
        `Email: ${d.get('email')}`,
        `Tiket: ${d.get('tier')} × ${d.get('jumlah')}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</Base>
