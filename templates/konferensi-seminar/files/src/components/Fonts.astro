---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<style is:global>
  html { -webkit-text-size-adjust: 100%; scroll-padding-top: 5rem; }
  body { font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif; background: #0b0b0b; color: #f5f5f0; -webkit-font-smoothing: antialiased; }
  .font-display { font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif; }
  .font-body { font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif; }
  .font-mono { font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }
  h1, h2, h3 { text-wrap: balance; }
  p, li { text-wrap: pretty; }
  ::selection { background: #e2ff4d; color: #0b0b0b; }
  /* Fokus keyboard yang selalu terlihat, di atas latar gelap maupun kuning. */
  :focus-visible { outline: 2px solid #e2ff4d; outline-offset: 3px; }
  .bg-\[\#e2ff4d\] :focus-visible, .bg-\[\#e2ff4d\]:focus-visible { outline-color: #f5f5f0; }
  section.bg-\[\#e2ff4d\] :focus-visible { outline-color: #0b0b0b; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
