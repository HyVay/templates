---
import { acara, track } from '../data/acara';
---
<footer class="border-t border-[#f5f5f0]/15">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-2xl font-extrabold uppercase tracking-tight">{acara.nama} <span class="text-[#e2ff4d]">{acara.tahun}</span></p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#f5f5f0]/70">{acara.tagline}</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">Lokasi</p>
      <p class="mt-3 text-sm">{acara.venue}</p>
      <p class="text-sm text-[#f5f5f0]/70">{acara.alamat}</p>
      <a href={acara.maps} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#e2ff4d]">Buka di Google Maps</a>
    </div>
    <div class="md:col-span-2">
      <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">Track</p>
      <ul class="mt-3 space-y-1 text-sm">
        {track.map((t) => <li><span class="font-mono text-[#f5f5f0]/50">{t.kode}</span> {t.nama}</li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-mono text-xs uppercase tracking-widest text-[#e2ff4d]">Kontak</p>
      <ul class="mt-3 space-y-1 text-sm">
        <li><a href={`https://wa.me/${acara.wa}`} class="transition-colors duration-150 hover:text-[#e2ff4d]">WhatsApp panitia</a></li>
        <li><a href={`mailto:${acara.email}`} class="transition-colors duration-150 hover:text-[#e2ff4d]">{acara.email}</a></li>
        <li class="text-[#f5f5f0]/70">{acara.instagram}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[#f5f5f0]/15 px-4 py-5 md:px-6">
    <p class="mx-auto max-w-7xl font-mono text-xs text-[#f5f5f0]/50">
      {acara.tanggalPendek} · {acara.kota.toUpperCase()} · © {new Date().getFullYear()} {acara.nama}
    </p>
  </div>
</footer>
