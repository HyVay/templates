---
import { acara } from '../data/acara';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/agenda/', label: 'Agenda' },
  { href: '/pembicara/', label: 'Pembicara' },
  { href: '/tiket/', label: 'Tiket' },
];
const here = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-[#f5f5f0]/15 bg-[#0b0b0b]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 md:h-16 md:px-6">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-base font-extrabold uppercase tracking-tight text-[#f5f5f0]">{acara.nama}</span>
      <span class="font-mono text-xs text-[#e2ff4d]">{acara.tahun}</span>
    </a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'font-mono text-xs uppercase tracking-widest transition-colors duration-150 hover:text-[#e2ff4d]',
            here === l.href ? 'text-[#e2ff4d]' : 'text-[#f5f5f0]/80',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/tiket/"
        class="bg-[#e2ff4d] px-4 py-2 font-mono text-xs uppercase tracking-widest text-[#0b0b0b] transition-colors duration-150 hover:bg-[#f5f5f0]"
      >
        Daftar
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center text-[#f5f5f0] transition-colors duration-150 hover:bg-[#f5f5f0]/10 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#f5f5f0]/15 bg-[#0b0b0b] md:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col divide-y divide-[#f5f5f0]/10 px-4">
      {links.map((l) => (
        <a href={l.href} class="block py-3.5 font-mono text-sm uppercase tracking-widest text-[#f5f5f0] transition-colors duration-150 hover:text-[#e2ff4d]">
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
