---
import { rental } from '../data/rental';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/armada/', label: 'Armada' },
  { href: '/syarat/', label: 'Syarat Sewa' },
  { href: '/booking/', label: 'Booking' },
];
const here = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-[#1C1C1C]/15 bg-[#FAFAFA]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 md:h-16 md:px-6">
    <a href="/" class="font-display text-xl font-semibold uppercase tracking-wide text-[#1C1C1C] md:text-2xl">{rental.nama}</a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'font-display text-base font-medium uppercase tracking-wide transition-colors duration-150 hover:text-[#1E5EFF]',
            here === l.href ? 'text-[#1E5EFF]' : 'text-[#1C1C1C]/80',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href={`https://wa.me/${rental.telepon}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-[#1C1C1C] px-4 py-2 font-display text-base font-medium uppercase tracking-wide text-white transition-colors duration-150 hover:bg-[#1E5EFF]"
      >
        WhatsApp
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-md text-[#1C1C1C] transition-colors duration-150 hover:bg-[#1C1C1C]/5 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#1C1C1C]/15 bg-[#FAFAFA] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <a href={l.href} class="block rounded-md px-2 py-3 font-display text-lg font-medium uppercase tracking-wide text-[#1C1C1C] transition-colors duration-150 hover:bg-[#1C1C1C]/5">
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
