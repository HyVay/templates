---
import { rental } from '../data/rental';
---
<footer class="bg-[#1C1C1C] text-white">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-3xl font-semibold uppercase tracking-wide">{rental.nama}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/70">{rental.tagline}.</p>
      <p class="mt-5 text-sm leading-relaxed text-white/85">{rental.alamat}</p>
      <p class="mt-1 text-sm text-white/60">{rental.jam}</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-mono text-xs uppercase tracking-widest text-white/50">Area antar-jemput gratis</p>
      <ul class="mt-3 divide-y divide-white/10 text-sm">
        {rental.areaAntar.map((a) => <li class="py-2">{a}</li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-mono text-xs uppercase tracking-widest text-white/50">Booking</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a href={`https://wa.me/${rental.telepon}`} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:text-[#8fb0ff]">WhatsApp {rental.telepon}</a></li>
        <li><a href="/armada/" class="transition-colors duration-150 hover:text-[#8fb0ff]">Lihat armada & harga</a></li>
        <li><a href="/syarat/" class="transition-colors duration-150 hover:text-[#8fb0ff]">Syarat sewa</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-5 text-xs text-white/50 md:px-6">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} {rental.nama}</span>
      <span>Harga per 24 jam, belum termasuk BBM. Unit tunduk pada ketersediaan.</span>
    </div>
  </div>
</footer>
