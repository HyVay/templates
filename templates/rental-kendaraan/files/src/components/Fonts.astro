---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Public+Sans:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Public Sans', ui-sans-serif, system-ui, sans-serif; background: #FAFAFA; color: #1C1C1C; }
  .font-display { font-family: 'Oswald', 'Arial Narrow', sans-serif; }
  .font-body { font-family: 'Public Sans', ui-sans-serif, system-ui, sans-serif; }
  h1, h2, h3 { text-wrap: balance; }
  p, li, dd { text-wrap: pretty; }
  /* Fokus keyboard: biru aksen di latar terang, putih di latar gelap (.on-dark). */
  :focus-visible { outline: 2px solid #1E5EFF; outline-offset: 3px; }
  .on-dark :focus-visible { outline-color: #FFFFFF; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
