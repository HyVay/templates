---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarisUnit from '../components/BarisUnit.astro';
import { rental, unit } from '../data/rental';

const filter = ['Semua', 'Mobil', 'Motor'];
---
<Base
  title={`Armada — ${rental.nama}`}
  description={`Daftar ${unit.length} unit mobil dan motor ${rental.nama} dengan harga per hari lepas kunci dan dengan sopir.`}
>
  <Fonts />
  <Header />
  <main>
    <section class="border-b border-[#1C1C1C]/15 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#1E5EFF]">{unit.length} unit · harga per 24 jam</p>
        <h1 class="mt-3 font-display text-5xl font-semibold uppercase leading-none tracking-wide text-[#1C1C1C] md:text-7xl">Armada</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#1C1C1C]/75 md:text-base">
          Semua unit milik sendiri, servis rutin di bengkel resmi. Harga lepas kunci belum termasuk BBM; harga dengan sopir sudah termasuk jasa sopir 12 jam, belum BBM dan makan sopir.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter jenis kendaraan">
        {filter.map((f, i) => (
          <button
            type="button"
            data-filter={f}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn min-h-11 rounded-md border border-[#1C1C1C] px-4 py-2 font-display text-base font-medium uppercase tracking-wide text-[#1C1C1C] transition-colors duration-150 hover:bg-[#1C1C1C]/5 aria-pressed:border-[#1C1C1C] aria-pressed:bg-[#1C1C1C] aria-pressed:text-white"
          >
            {f}
          </button>
        ))}
      </div>
      <ul id="daftar-unit" class="mt-6 divide-y divide-[#1C1C1C]/15 border-y border-[#1C1C1C]/15">
        {unit.map((u) => <BarisUnit u={u} />)}
      </ul>
      <p class="mt-4 text-sm text-[#1C1C1C]/60">Sewa 3 hari atau lebih dapat potongan 10%, sewa mingguan 20%. Sebutkan saat booking.</p>
      <div class="mt-8">
        <a href="/booking/" class="inline-flex w-full items-center justify-center rounded-md bg-[#1E5EFF] px-6 py-4 font-display text-lg font-medium uppercase tracking-wide text-white transition-colors duration-150 hover:bg-[#1C1C1C] sm:w-auto">Booking unit</a>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const rows = document.querySelectorAll<HTMLElement>('#daftar-unit [data-jenis]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pilihan = btn.dataset.filter ?? 'Semua';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        rows.forEach((row) => row.classList.toggle('hidden', !(pilihan === 'Semua' || row.dataset.jenis === pilihan)));
      });
    });
  </script>
</Base>
