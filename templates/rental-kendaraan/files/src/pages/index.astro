---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarisUnit from '../components/BarisUnit.astro';
import { rental, unit, foto, rupiah } from '../data/rental';

const mobil = unit.filter((u) => u.jenis === 'Mobil');
const motor = unit.filter((u) => u.jenis === 'Motor');
const unggulan = [mobil[0], mobil[1], motor[0], motor[2]].filter(Boolean);
const termurahMobil = Math.min(...mobil.filter((u) => u.lepasKunci > 0).map((u) => u.lepasKunci));
const termurahMotor = Math.min(...motor.map((u) => u.lepasKunci));
---
<Base title={`${rental.nama} — ${rental.tagline}`} description={rental.deskripsi}>
  <Fonts />
  <Header />
  <main id="konten">
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pt-10 md:px-6 md:pt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-[#1E5EFF]">{rental.kota} · sejak {rental.sejak} · {unit.length} unit milik sendiri</p>
      <div class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end">
        <h1 class="font-display text-5xl font-semibold uppercase leading-[0.95] tracking-wide text-[#1C1C1C] sm:text-6xl md:col-span-8 md:text-8xl">
          Sewa mobil &amp; motor, diantar ke bandara
        </h1>
        <div class="md:col-span-4">
          <p class="text-base leading-relaxed text-[#1C1C1C]/75">{rental.deskripsi}</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row md:flex-col">
            <a href="/booking/" class="inline-flex items-center justify-center rounded-md bg-[#1E5EFF] px-6 py-3.5 font-display text-lg font-medium uppercase tracking-wide text-white transition-colors duration-150 hover:bg-[#1C1C1C]">Booking sekarang</a>
            <a href="/armada/" class="inline-flex items-center justify-center rounded-md border border-[#1C1C1C] px-6 py-3.5 font-display text-lg font-medium uppercase tracking-wide text-[#1C1C1C] transition-colors duration-150 hover:bg-[#1C1C1C] hover:text-white">Lihat armada</a>
          </div>
        </div>
      </div>
    </section>
    <div class="mt-10 md:mt-14">
      <img src={foto.hero} alt="Jalan berkelok di antara perbukitan hijau" width="2000" height="857" fetchpriority="high" class="aspect-[16/9] w-full object-cover md:aspect-[21/9]" />
    </div>

    <!-- Strip harga -->
    <section class="border-b border-[#1C1C1C]/15">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-[#1C1C1C]/15 md:grid-cols-4">
        {[
          { label: 'Mobil mulai', nilai: `${rupiah(termurahMobil)}/hari` },
          { label: 'Motor mulai', nilai: `${rupiah(termurahMotor)}/hari` },
          { label: 'Antar-jemput', nilai: 'Gratis bandara' },
          { label: 'Serah terima', nilai: '24 jam' },
        ].map((s) => (
          <div class="bg-[#FAFAFA] px-4 py-6 md:px-6 md:py-8">
            <p class="font-mono text-[11px] uppercase tracking-widest text-[#1C1C1C]/75">{s.label}</p>
            <p class="mt-1 font-display text-2xl font-semibold uppercase tracking-wide text-[#1C1C1C] md:text-3xl">{s.nilai}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Unggulan -->
    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-[#1E5EFF]">Paling sering dipesan</p>
          <h2 class="mt-2 font-display text-4xl font-semibold uppercase tracking-wide text-[#1C1C1C] md:text-5xl">Empat unit andalan</h2>
        </div>
        <a href="/armada/" class="font-display text-lg font-medium uppercase tracking-wide text-[#1C1C1C] underline decoration-[#1E5EFF] decoration-2 underline-offset-4 transition-colors duration-150 hover:text-[#1E5EFF]">Semua {unit.length} unit</a>
      </div>
      <ul class="mt-6 divide-y divide-[#1C1C1C]/15 border-y border-[#1C1C1C]/15">
        {unggulan.map((u) => <BarisUnit u={u} />)}
      </ul>
    </section>

    <!-- Cara kerja -->
    <section class="border-y border-[#1C1C1C]/15 bg-white">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
        <div class="md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-[#1E5EFF]">Cara sewa</p>
          <h2 class="mt-2 font-display text-4xl font-semibold uppercase tracking-wide text-[#1C1C1C]">Tiga langkah, tanpa aplikasi</h2>
          <ol class="mt-8 divide-y divide-[#1C1C1C]/15 border-y border-[#1C1C1C]/15">
            {[
              ['Pilih unit dan tanggal', 'Kirim lewat form booking atau langsung WhatsApp. Kami konfirmasi ketersediaan dalam 15 menit pada jam kerja.'],
              ['Bayar DP 30%', 'Transfer ke rekening atas nama usaha. Sisanya dibayar saat serah terima, tunai atau transfer.'],
              ['Terima unit', 'Diantar ke bandara, hotel, atau alamat Anda. Cek bersama, foto kondisi, tanda tangan nota, jalan.'],
            ].map(([judul, isi], i) => (
              <li class="flex gap-4 py-5">
                <span class="w-12 shrink-0 font-display text-3xl font-semibold text-[#1E5EFF]">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex-1">
                  <h3 class="font-display text-xl font-medium uppercase tracking-wide text-[#1C1C1C]">{judul}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-[#1C1C1C]/75">{isi}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="md:col-span-7">
          <img src={foto.jalan} alt="Jalan raya di Bali dengan Gunung Agung di kejauhan" width="900" height="900" loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-md object-cover object-[center_40%] md:aspect-square" />
          <p class="mt-3 font-mono text-xs uppercase tracking-widest text-[#1C1C1C]/75">Area antar-jemput: {rental.areaAntar.slice(0, 4).join(' · ')}</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="grid grid-cols-1 gap-6 rounded-md bg-[#1C1C1C] p-6 text-white md:grid-cols-12 md:items-center md:p-10">
        <div class="md:col-span-8">
          <h2 class="font-display text-3xl font-semibold uppercase tracking-wide md:text-5xl">Cek ketersediaan tanggal Anda</h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/70 md:text-base">Kirim tanggal ambil dan kembali, kami balas unit yang tersedia dan total biayanya.</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/booking/" class="inline-flex w-full items-center justify-center rounded-md bg-[#1E5EFF] px-6 py-4 font-display text-lg font-medium uppercase tracking-wide text-white transition-colors duration-150 hover:bg-white hover:text-[#1C1C1C] md:w-auto">Booking</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
