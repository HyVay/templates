---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { rental, syarat } from '../data/rental';
---
<Base
  title={`Syarat Sewa — ${rental.nama}`}
  description={`Syarat sewa kendaraan di ${rental.nama}: dokumen, usia, deposit, BBM, keterlambatan, dan kebijakan pembatalan.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#1C1C1C]/15 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#1E5EFF]">{syarat.length} poin, dibaca 2 menit</p>
        <h1 class="mt-3 font-display text-5xl font-semibold uppercase leading-none tracking-wide text-[#1C1C1C] md:text-7xl">Syarat sewa</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#1C1C1C]/75 md:text-base">
          Ditulis supaya tidak ada kejutan saat serah terima. Semua poin ini juga tercetak di nota sewa yang Anda tanda tangani.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <ol class="divide-y divide-[#1C1C1C]/15 border-y border-[#1C1C1C]/15">
        {syarat.map((s, i) => (
          <li class="grid grid-cols-1 gap-2 py-6 md:grid-cols-12 md:gap-6">
            <span class="font-display text-3xl font-semibold text-[#1E5EFF] md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="font-display text-2xl font-medium uppercase tracking-wide text-[#1C1C1C] md:col-span-4">{s.judul}</h2>
            <p class="text-sm leading-relaxed text-[#1C1C1C]/80 md:col-span-7 md:text-base">{s.isi}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col gap-4 rounded-md border border-[#1C1C1C]/15 bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-[#1C1C1C]/75">Ada yang belum jelas? Tanyakan sebelum booking, kami jawab lewat WhatsApp.</p>
        <a href={`https://wa.me/${rental.telepon}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md bg-[#1C1C1C] px-5 py-3 font-display text-base font-medium uppercase tracking-wide text-white transition-colors duration-150 hover:bg-[#1E5EFF]">Tanya dulu</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
