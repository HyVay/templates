---
/**
 * Satu baris paket: foto kiri, judul + chip tanggal + harga kanan.
 * `detail`=true menambahkan itinerary (<details>) dan daftar termasuk/tidak termasuk.
 */
import { rupiah, tanggalPendek, type Paket } from '../data/trip';

interface Props { p: Paket; detail?: boolean }
const { p, detail = false } = Astro.props;
const terdekat = p.keberangkatan.filter((k) => k.sisa > 0);
const sisaTerdekat = terdekat[0]?.sisa;
---
<li id={p.slug} class="grid grid-cols-1 gap-6 py-8 md:grid-cols-12 md:gap-8">
  <div class="md:col-span-4">
    <img src={p.foto} alt={`${p.nama}, ${p.destinasi}`} loading="lazy" class="aspect-[4/3] w-full rounded-lg object-cover" />
  </div>
  <div class="md:col-span-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">{p.destinasi} · {p.durasi}</p>
        <h3 class="mt-1 font-display text-3xl font-extrabold tracking-tight text-[#0B3C5D] md:text-4xl">
          {detail ? p.nama : <a href={`/paket/#${p.slug}`} class="transition-colors duration-150 hover:text-[#F26B1D]">{p.nama}</a>}
        </h3>
      </div>
      <div class="sm:text-right">
        <p class="font-display text-3xl font-extrabold tabular-nums tracking-tight text-[#0B3C5D]">{rupiah(p.harga)}</p>
        <p class="font-mono text-[11px] uppercase tracking-widest text-[#0B3C5D]/60">per orang</p>
      </div>
    </div>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#0B3C5D]/80 md:text-base">{p.ringkas}</p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {p.keberangkatan.map((k) => (
        <span class:list={['rounded-lg border px-3 py-1.5 font-mono text-xs tabular-nums', k.sisa > 0 ? 'border-[#0B3C5D]/30 text-[#0B3C5D]' : 'border-[#0B3C5D]/15 text-[#0B3C5D]/40 line-through']}>
          {tanggalPendek(k.tanggal)}
        </span>
      ))}
      {sisaTerdekat !== undefined && sisaTerdekat <= 5 && (
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-[#F26B1D]">Sisa {sisaTerdekat} kursi di tanggal terdekat</span>
      )}
    </div>

    {detail && (
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">Itinerary</p>
          <div class="mt-2 divide-y divide-[#0B3C5D]/15 border-y border-[#0B3C5D]/15">
            {p.itinerary.map((h, i) => (
              <details class="group" open={i === 0}>
                <summary class="flex min-h-11 cursor-pointer list-none items-center gap-4 py-3 marker:hidden">
                  <span class="font-mono text-xs uppercase tracking-widest text-[#F26B1D]">{h.hari}</span>
                  <span class="flex-1 font-semibold text-[#0B3C5D]">{h.judul}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#0B3C5D]/60 transition-transform duration-150 group-open:rotate-45" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round" /></svg>
                </summary>
                <p class="pb-4 text-sm leading-relaxed text-[#0B3C5D]/80">{h.isi}</p>
              </details>
            ))}
          </div>
          <p class="mt-3 text-sm text-[#0B3C5D]/70"><span class="font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">Meeting point</span><br />{p.meetingPoint}</p>
        </div>
        <div class="md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">Termasuk</p>
          <ul class="mt-2 space-y-1 text-sm text-[#0B3C5D]/85">
            {p.termasuk.map((t) => <li class="flex gap-2"><span class="text-[#F26B1D]">+</span><span>{t}</span></li>)}
          </ul>
          <p class="mt-4 font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">Tidak termasuk</p>
          <ul class="mt-2 space-y-1 text-sm text-[#0B3C5D]/70">
            {p.tidakTermasuk.map((t) => <li class="flex gap-2"><span>−</span><span>{t}</span></li>)}
          </ul>
          <a href={`/booking/?paket=${p.slug}`} class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-[#0B3C5D] px-5 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#F26B1D] sm:w-auto">
            Booking {p.nama}
          </a>
        </div>
      </div>
    )}
  </div>
</li>
