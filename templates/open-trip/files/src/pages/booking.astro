---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { travel, paket, rupiah, tanggalPendek } from '../data/trip';

const input = 'mt-1 w-full rounded-lg border border-[#0B3C5D]/30 bg-white px-3 py-3 text-sm text-[#0B3C5D] outline-none transition-colors duration-150 placeholder:text-[#0B3C5D]/40 focus:border-[#0B3C5D]';
const label = 'font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/70';
// Daftar tanggal gabungan: value "slug|tanggal" supaya satu <select> cukup.
const pilihan = paket.flatMap((p) =>
  p.keberangkatan.filter((k) => k.sisa > 0).map((k) => ({
    value: `${p.slug}|${k.tanggal}`,
    label: `${p.nama} · ${tanggalPendek(k.tanggal)} · sisa ${k.sisa} · ${rupiah(p.harga)}/orang`,
    slug: p.slug,
  })),
);
---
<Base
  title={`Booking — ${travel.nama}`}
  description={`Booking kursi open trip ${travel.nama}: pilih paket dan tanggal keberangkatan, jumlah peserta, lalu konfirmasi lewat WhatsApp.`}
>
  <Fonts />
  <Header />
  <main>
    <section class="border-b border-[#0B3C5D]/15 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#F26B1D]">Kursi dikunci setelah DP diterima</p>
        <h1 class="mt-3 font-display text-5xl font-extrabold leading-none tracking-tight text-[#0B3C5D] md:text-7xl">Booking</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0B3C5D]/75 md:text-base">
          Isi form, pesan terbuka di WhatsApp. Kami balas dengan konfirmasi kursi, nomor rekening DP, dan invoice.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="md:col-span-7">
          <form id="booking-form" class="space-y-5">
            <div>
              <label for="jadwal" class={label}>Paket & tanggal keberangkatan</label>
              <select id="jadwal" name="jadwal" required class={input}>
                {pilihan.map((o) => <option value={o.value} data-slug={o.slug}>{o.label}</option>)}
              </select>
            </div>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="jumlah" class={label}>Jumlah peserta</label>
                <input id="jumlah" name="jumlah" type="number" min="1" max="14" value="2" required class={input} />
              </div>
              <div>
                <label for="nama" class={label}>Nama pemesan</label>
                <input id="nama" name="nama" required placeholder="Sesuai KTP" class={input} />
              </div>
            </div>
            <div>
              <label for="kota" class={label}>Berangkat dari kota</label>
              <input id="kota" name="kota" placeholder="Untuk saran penerbangan, opsional" class={input} />
            </div>
            <div>
              <label for="catatan" class={label}>Catatan</label>
              <textarea id="catatan" name="catatan" rows="3" placeholder="Alergi makanan, permintaan kamar, pertanyaan" class={input}></textarea>
            </div>
            <button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-[#0B3C5D] px-6 py-4 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#F26B1D] sm:w-auto">
              Kirim via WhatsApp
            </button>
          </form>
          <p class="mt-3 text-xs text-[#0B3C5D]/60">Situs ini statis tanpa basis data. Form hanya menyusun pesan WhatsApp; tidak ada pembayaran yang diproses di sini.</p>
        </div>

        <div class="md:col-span-5">
          <div class="rounded-lg border border-[#0B3C5D]/15 bg-white">
            <div class="border-b border-[#0B3C5D]/15 px-5 py-3 font-mono text-xs uppercase tracking-widest text-[#0B3C5D]/60">Setelah kirim</div>
            <ol class="divide-y divide-[#0B3C5D]/10 px-5">
              {[
                ['Konfirmasi kursi', 'Kami cek sisa kursi di tanggal yang dipilih dan balas dalam jam kerja.'],
                ['Bayar DP 30%', 'Nomor rekening atas nama usaha dikirim lewat WhatsApp. Kursi dikunci begitu DP masuk.'],
                ['Pelunasan', '14 hari sebelum berangkat. Setelah itu Anda masuk grup WhatsApp peserta.'],
              ].map(([judul, isi], i) => (
                <li class="flex gap-4 py-4">
                  <span class="w-8 shrink-0 font-display text-xl font-extrabold text-[#F26B1D]">{i + 1}</span>
                  <div>
                    <p class="font-semibold text-[#0B3C5D]">{judul}</p>
                    <p class="mt-0.5 text-sm text-[#0B3C5D]/75">{isi}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-[#0B3C5D]/75">Kantor: {travel.alamat}. {travel.jam}.</p>
          <a href={`https://wa.me/${travel.telepon}`} target="_blank" rel="noopener noreferrer" class="mt-4 flex items-center justify-center gap-2 rounded-lg bg-[#F26B1D] px-5 py-4 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#0B3C5D]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 2a8 8 0 11-4.1 14.9l-.4-.2-2.9.8.8-2.8-.2-.4A8 8 0 0112 4z" /></svg>
            Chat langsung tanpa form
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: travel.telepon }}>
    const form = document.getElementById('booking-form');
    const select = document.getElementById('jadwal');

    // Pra-pilih paket dari ?paket=slug (tautan dari halaman paket).
    const slug = new URLSearchParams(location.search).get('paket');
    if (slug && select) {
      const opt = [...select.options].find((o) => o.dataset.slug === slug);
      if (opt) select.value = opt.value;
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const teks = select?.selectedOptions[0]?.textContent?.trim() ?? String(d.get('jadwal'));
      const text = [
        `Halo, saya ${d.get('nama')}, mau booking:`,
        teks,
        `Jumlah peserta: ${d.get('jumlah')}`,
        `Berangkat dari: ${d.get('kota') || '-'}`,
        `Catatan: ${d.get('catatan') || '-'}`,
        'Mohon konfirmasi kursi dan info DP.',
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</Base>
