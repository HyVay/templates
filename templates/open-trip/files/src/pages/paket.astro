---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarisPaket from '../components/BarisPaket.astro';
import { travel, paket } from '../data/trip';
---
<Base
  title={`Paket Trip — ${travel.nama}`}
  description={`${paket.length} paket open trip ${travel.nama}: ${paket.map((p) => p.nama).join(', ')}. Itinerary, harga, tanggal keberangkatan, dan sisa kursi.`}
>
  <Fonts />
  <Header />
  <main>
    <section class="border-b border-[#0B3C5D]/15 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#F26B1D]">{paket.length} paket · harga per orang</p>
        <h1 class="mt-3 font-display text-5xl font-extrabold leading-none tracking-tight text-[#0B3C5D] md:text-7xl">Paket trip</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0B3C5D]/75 md:text-base">
          Semua paket berangkat terjadwal dengan rombongan gabungan. Tanggal yang dicoret sudah penuh; tanggal lain bisa diminta untuk rombongan privat minimal 8 orang.
        </p>
        <nav class="mt-6 flex flex-wrap gap-2" aria-label="Lompat ke paket">
          {paket.map((p) => (
            <a href={`#${p.slug}`} class="rounded-lg border border-[#0B3C5D]/30 px-3 py-2 text-sm font-medium text-[#0B3C5D] transition-colors duration-150 hover:border-[#0B3C5D] hover:bg-[#0B3C5D] hover:text-white">{p.nama}</a>
          ))}
        </nav>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-6 md:px-6 md:py-10">
      <ul class="divide-y divide-[#0B3C5D]/15">
        {paket.map((p) => <BarisPaket p={p} detail={true} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Base>
