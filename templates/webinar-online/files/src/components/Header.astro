---
import { webinar } from '../data/webinar';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/materi/', label: 'Materi' },
  { href: '/daftar/', label: 'Daftar' },
];
const here = Astro.url.pathname;
---
<a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[60] focus:rounded-sm focus:bg-[#3B2A1A] focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-[#FAF7F2]">Langsung ke konten</a>
<header class="sticky top-0 z-50 border-b border-[#3B2A1A]/15 bg-[#FAF7F2]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 md:h-16 md:px-6">
    <a href="/" class="font-display text-lg font-semibold md:text-xl">{webinar.penyelenggara}</a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'text-sm font-medium transition-colors duration-150 hover:text-[#B5452E]',
            here === l.href ? 'text-[#B5452E]' : 'text-[#3B2A1A]/70',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/daftar/" class="rounded-sm bg-[#3B2A1A] px-4 py-2 text-sm font-semibold text-[#FAF7F2] transition-colors duration-150 hover:bg-[#B5452E]">
        Daftar sekarang
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-sm transition-colors duration-150 hover:bg-[#3B2A1A]/5 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#3B2A1A]/15 bg-[#FAF7F2] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="block rounded-sm px-2 py-3 text-base font-medium aria-[current=page]:text-[#B5452E] transition-colors duration-150 hover:bg-[#3B2A1A]/5">{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
