---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&family=Figtree:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif; background: #FAF7F2; color: #3B2A1A; }
  .font-display { font-family: 'Newsreader', Georgia, serif; }
  .font-body { font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif; }
</style>
