---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { webinar, paket, rupiah } from '../data/webinar';

const langkah = [
  'Isi formulir. Pesan terbuka di WhatsApp panitia dengan data Anda.',
  'Panitia membalas dengan nomor rekening dan total biaya. Transfer dalam 1×24 jam.',
  'Setelah bukti transfer diterima, Anda masuk grup WhatsApp peserta. Tautan Zoom dikirim H-1.',
];
const field = 'mt-1.5 w-full rounded-sm border border-[#3B2A1A]/30 bg-white px-3 py-3 text-sm outline-none transition-colors duration-150 focus:border-[#B5452E]';
---
<Base title={`Daftar — ${webinar.judul}`} description={`Pendaftaran ${webinar.judul}. Early bird ${rupiah(webinar.hargaEarly)} sampai ${webinar.batasEarly}, pembayaran transfer dikonfirmasi lewat WhatsApp.`}>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#3B2A1A]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#B5452E]">Sisa {webinar.sisaKursi} kursi</p>
        <h1 class="font-display mt-4 text-4xl font-medium leading-tight md:text-6xl">Pendaftaran</h1>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-12 md:grid-cols-12 md:px-6 md:py-16">
      <form id="daftar-form" class="space-y-5 md:col-span-7">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="nama" class="block text-sm font-semibold">Nama lengkap</label>
            <input id="nama" name="nama" autocomplete="name" required placeholder="Nama Anda" class={field} />
          </div>
          <div>
            <label for="kota" class="block text-sm font-semibold">Kota</label>
            <input id="kota" name="kota" autocomplete="address-level2" required placeholder="Kota domisili" class={field} />
          </div>
        </div>
        <div>
          <label for="usaha" class="block text-sm font-semibold">Nama dan jenis usaha</label>
          <input id="usaha" name="usaha" autocomplete="organization" required placeholder="Misalnya: Warung Bu Sri, kelontong" class={field} />
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="paket" class="block text-sm font-semibold">Paket</label>
            <select id="paket" name="paket" class={field}>
              {paket.map((p) => <option value={p.nama}>{p.nama} · {rupiah(p.harga)}</option>)}
            </select>
          </div>
          <div>
            <label for="jumlah" class="block text-sm font-semibold">Jumlah peserta</label>
            <input id="jumlah" name="jumlah" type="number" inputmode="numeric" min="1" max="20" required value="1" class={field} />
          </div>
        </div>
        <button type="submit" class="inline-flex min-h-[48px] w-full items-center justify-center rounded-sm bg-[#B5452E] px-6 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#953823] sm:w-auto">Kirim via WhatsApp</button>
        <p id="status" role="status" aria-live="polite" class="hidden border-l-2 border-[#B5452E] pl-3 text-sm"></p>
        <p class="text-xs leading-relaxed text-[#3B2A1A]/70">Situs ini statis dan tidak menyimpan data. Isian disusun menjadi pesan WhatsApp ke panitia ({webinar.wa}). Pembayaran via transfer, dikonfirmasi lewat WhatsApp yang sama.</p>
      </form>

      <aside class="md:col-span-5">
        <p class="font-mono text-xs uppercase tracking-widest text-[#3B2A1A]/70">Alur pendaftaran</p>
        <ol class="mt-4 divide-y divide-[#3B2A1A]/10 border-y border-[#3B2A1A]/10">
          {langkah.map((l, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-3 py-4">
              <span class="font-display text-2xl text-[#B5452E]">0{i + 1}</span>
              <p class="text-sm leading-relaxed text-[#3B2A1A]/80">{l}</p>
            </li>
          ))}
        </ol>
        <div class="mt-8 rounded-sm bg-[#3B2A1A] p-6 text-[#FAF7F2]">
          <p class="font-mono text-[11px] uppercase tracking-widest text-[#FAF7F2]/75">Termasuk dalam biaya</p>
          <ul class="mt-3 space-y-2 text-sm">
            {webinar.bonus.map((b) => <li class="flex gap-2"><span class="text-[#B5452E]">+</span>{b}</li>)}
          </ul>
        </div>
      </aside>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: webinar.wa, judul: webinar.judul }}>
    const form = document.getElementById('daftar-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Pendaftaran: ${judul}`,
        `Nama: ${d.get('nama')} (${d.get('kota')})`,
        `Usaha: ${d.get('usaha')}`,
        `Paket: ${d.get('paket')} × ${d.get('jumlah')} peserta`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
      const status = document.getElementById('status');
      if (status) {
        status.textContent = 'WhatsApp dibuka di tab baru. Kirim pesannya; panitia membalas dengan nomor rekening dan total biaya.';
        status.classList.remove('hidden');
      }
    });
  </script>
</Base>
