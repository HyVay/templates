---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { webinar, sesi, faq } from '../data/webinar';
---
<Base title={`Materi — ${webinar.judul}`} description={`Silabus lengkap ${webinar.judul}: ${sesi.map((s) => s.tema).join(', ')}. Plus jawaban pertanyaan yang sering diajukan.`}>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#3B2A1A]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#B5452E]">Silabus</p>
        <h1 class="font-display mt-4 text-4xl font-medium leading-tight md:text-6xl">Materi per sesi</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#3B2A1A]/75">Tiap sesi berisi penjelasan singkat lalu praktik langsung di template. Pekerjaan rumah antar sesi: mencatat transaksi warung Anda sendiri selama seminggu.</p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
      {sesi.map((s, i) => (
        <article class:list={['grid grid-cols-1 gap-6 py-10 md:grid-cols-12 md:gap-8', i > 0 ? 'border-t border-[#3B2A1A]/15' : '']}>
          <div class="md:col-span-4">
            <p class="font-mono text-xs uppercase tracking-widest text-[#3B2A1A]/70">{s.nomor}</p>
            <h2 class="font-display mt-2 text-3xl font-medium leading-tight">{s.tema}</h2>
            <p class="mt-3 text-sm text-[#3B2A1A]/70">{s.tanggal}<br />{s.jam}</p>
          </div>
          <ol class="divide-y divide-[#3B2A1A]/10 md:col-span-8">
            {s.silabus.map((p, j) => (
              <li class="grid grid-cols-[3rem_1fr] gap-3 py-4">
                <span class="font-mono text-sm text-[#B5452E]">{i + 1}.{j + 1}</span>
                <p class="text-base leading-relaxed">{p}</p>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </section>

    <section class="border-t border-[#3B2A1A]/15 bg-[#3B2A1A]/[0.03]">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-4">
          <p class="font-mono text-xs uppercase tracking-widest text-[#B5452E]">Pertanyaan</p>
          <h2 class="font-display mt-3 text-3xl font-medium md:text-4xl">Sering ditanyakan</h2>
        </div>
        <div class="divide-y divide-[#3B2A1A]/15 border-y border-[#3B2A1A]/15 md:col-span-8">
          {faq.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-1 text-base font-medium md:text-lg">
                {f.q}
                <span class="mt-1 shrink-0 font-display text-2xl leading-none text-[#B5452E] transition-transform duration-150 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#3B2A1A]/75">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
