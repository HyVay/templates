---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import { orang, pengalaman, proyek, keahlian, pendidikan, sertifikasi, bahasa } from '../data/cv';

const label = 'font-mono text-xs uppercase tracking-[0.16em] text-[#111827]/70';
const bagian = [
  { id: 'h-pengalaman', label: 'Pengalaman' },
  { id: 'h-proyek', label: 'Proyek' },
  { id: 'h-keahlian', label: 'Keahlian' },
  { id: 'h-pendidikan', label: 'Pendidikan' },
];
const judul = 'font-display text-2xl font-bold tracking-tight text-[#111827]';
---
<Base title={`${orang.nama} — ${orang.jabatan}`} description={orang.ringkas}>
  <Fonts />
  <main id="konten" class="min-h-[100dvh] bg-white text-[#111827]">
    <div class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
        <!-- Kolom kiri: identitas, menempel saat digulir di desktop -->
        <aside class="md:col-span-4 md:sticky md:top-8 md:self-start">
          <p class={label}>Curriculum vitae · {orang.diperbarui}</p>
          <h1 class="mt-4 text-balance font-display text-5xl font-bold leading-[0.95] tracking-tight">{orang.nama}</h1>
          <p class="mt-3 text-lg text-[#111827]/75">{orang.jabatan}</p>
          <p class="mt-1 text-sm text-[#111827]/70">{orang.lokasi}</p>
          {orang.status && (
            <p class="mt-5 inline-flex items-start gap-2 border border-[#111827]/15 px-3 py-2 text-sm leading-snug">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#2F855A]" aria-hidden="true"></span>
              {orang.status}
            </p>
          )}

          <p class="mt-6 text-pretty text-[15px] leading-relaxed text-[#111827]/85">{orang.ringkas}</p>

          <dl class="mt-8 divide-y divide-[#111827]/15 border-y border-[#111827]/15 text-sm">
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class={label}>Email</dt>
              <dd><a href={`mailto:${orang.email}`} class="text-[#1D3557] underline underline-offset-4 transition-colors duration-150 hover:text-[#111827]">{orang.email}</a></dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class={label}>WhatsApp</dt>
              <dd><a href={`https://wa.me/${orang.telepon}`} target="_blank" rel="noopener noreferrer" class="text-[#1D3557] underline underline-offset-4 transition-colors duration-150 hover:text-[#111827]">{orang.telepon}</a></dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class={label}>Situs</dt>
              <dd><a href={`https://${orang.situs}`} target="_blank" rel="noopener noreferrer" class="text-[#1D3557] underline underline-offset-4 transition-colors duration-150 hover:text-[#111827]">{orang.situs}</a></dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class={label}>LinkedIn</dt>
              <dd class="truncate"><a href={`https://${orang.linkedin}`} target="_blank" rel="noopener noreferrer" class="text-[#1D3557] underline underline-offset-4 transition-colors duration-150 hover:text-[#111827]">{orang.linkedin.replace('linkedin.com/in/', '')}</a></dd>
            </div>
          </dl>

          <div class="cv-tombol mt-6 flex flex-col gap-2 sm:flex-row md:flex-col lg:flex-row">
            <a href={orang.pdf} class="inline-flex min-h-11 flex-1 items-center justify-center bg-[#111827] px-4 text-sm font-medium text-white transition-colors duration-150 hover:bg-[#1D3557]">
              Unduh PDF
            </a>
            <button id="cetak" type="button" class="inline-flex min-h-11 flex-1 items-center justify-center border border-[#111827] px-4 text-sm font-medium text-[#111827] transition-colors duration-150 hover:bg-[#111827] hover:text-white">
              Cetak halaman
            </button>
          </div>

          <nav aria-label="Bagian CV" class="cv-tombol mt-10 hidden md:block">
            <p class={label}>Di halaman ini</p>
            <ul class="mt-3 text-sm">
              {bagian.map((b) => (
                <li><a href={`#${b.id}`} class="block py-1.5 text-[#111827]/80 transition-colors duration-150 hover:text-[#1D3557]">{b.label}</a></li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Kolom kanan: isi -->
        <div class="space-y-14 md:col-span-8">
          <!-- Pengalaman -->
          <section aria-labelledby="h-pengalaman">
            <div class="flex items-baseline justify-between border-b border-[#111827] pb-3">
              <h2 id="h-pengalaman" class={judul}>Pengalaman</h2>
              <span class={label}>{pengalaman.length} posisi</span>
            </div>
            <ol class="mt-2">
              {pengalaman.map((p) => (
                <li class="grid grid-cols-1 gap-2 border-b border-[#111827]/15 py-6 md:grid-cols-12 md:gap-6">
                  <p class="font-mono text-xs tabular-nums text-[#111827]/70 md:col-span-3 md:pt-1">
                    {p.mulai} – {p.selesai}
                  </p>
                  <div class="md:col-span-9 md:border-l md:border-[#111827]/20 md:pl-6">
                    <h3 class="font-display text-lg font-bold leading-tight">{p.jabatan}</h3>
                    <p class="mt-0.5 text-sm text-[#111827]/75">{p.perusahaan} · {p.lokasi}</p>
                    <ul class="mt-3 space-y-2 text-pretty text-[15px] leading-relaxed text-[#111827]/85">
                      {p.capaian.map((c) => (
                        <li class="flex gap-3"><span class="mt-[0.6em] h-px w-3 shrink-0 bg-[#111827]/50" aria-hidden="true"></span><span>{c}</span></li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <!-- Proyek -->
          <section aria-labelledby="h-proyek">
            <div class="flex items-baseline justify-between border-b border-[#111827] pb-3">
              <h2 id="h-proyek" class={judul}>Proyek pilihan</h2>
              <span class={label}>{proyek.length} proyek</span>
            </div>
            <ol class="divide-y divide-[#111827]/15">
              {proyek.map((pr, i) => (
                <li class="grid grid-cols-1 gap-2 py-5 md:grid-cols-12 md:gap-6">
                  <p class="font-mono text-xs tabular-nums text-[#111827]/70 md:col-span-3">{String(i + 1).padStart(2, '0')} · {pr.tahun}</p>
                  <div class="md:col-span-9 md:border-l md:border-[#111827]/20 md:pl-6">
                    <h3 class="font-display text-lg font-bold leading-tight">
                      {pr.href ? (
                        <a href={pr.href} target="_blank" rel="noopener noreferrer" class="underline decoration-[#111827]/30 underline-offset-4 transition-colors duration-150 hover:decoration-[#1D3557] hover:text-[#1D3557]">{pr.nama}</a>
                      ) : pr.nama}
                    </h3>
                    <p class="mt-0.5 text-sm text-[#111827]/75">{pr.peran}</p>
                    <p class="mt-2 text-pretty text-[15px] leading-relaxed text-[#111827]/85">{pr.ringkas}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <!-- Keahlian -->
          <section aria-labelledby="h-keahlian">
            <div class="border-b border-[#111827] pb-3">
              <h2 id="h-keahlian" class={judul}>Keahlian</h2>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3">
              {keahlian.map((k) => (
                <div>
                  <p class={label}>{k.kelompok}</p>
                  <ul class="mt-3 space-y-1.5 text-sm text-[#111827]/85">
                    {k.daftar.map((d) => <li>{d}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <!-- Pendidikan + sertifikasi + bahasa -->
          <section aria-labelledby="h-pendidikan" class="grid grid-cols-1 gap-10 md:grid-cols-2">
            <div>
              <div class="border-b border-[#111827] pb-3">
                <h2 id="h-pendidikan" class={judul}>Pendidikan</h2>
              </div>
              <ul class="divide-y divide-[#111827]/15">
                {pendidikan.map((p) => (
                  <li class="py-4">
                    <p class="font-mono text-xs tabular-nums text-[#111827]/70">{p.tahun}</p>
                    <p class="mt-1 font-display font-bold leading-tight">{p.gelar}</p>
                    <p class="mt-0.5 text-sm text-[#111827]/70">{p.institusi}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <div class="border-b border-[#111827] pb-3">
                <h2 class={judul}>Sertifikasi & bahasa</h2>
              </div>
              <ul class="divide-y divide-[#111827]/15">
                {sertifikasi.map((s) => (
                  <li class="flex items-baseline gap-4 py-4">
                    <p class="w-12 shrink-0 font-mono text-xs tabular-nums text-[#111827]/70">{s.tahun}</p>
                    <p class="text-sm leading-snug">{s.nama}</p>
                  </li>
                ))}
                {bahasa.map((b) => (
                  <li class="flex items-baseline justify-between gap-4 py-4">
                    <p class="text-sm">{b.nama}</p>
                    <p class="font-mono text-xs text-[#111827]/70">{b.tingkat}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <footer class="flex flex-col gap-1 border-t border-[#111827]/15 pt-6 sm:flex-row sm:items-baseline sm:justify-between">
            <p class={label}>{orang.nama}</p>
            <p class={label}>Diperbarui {orang.diperbarui}</p>
          </footer>
        </div>
      </div>
    </div>
  </main>

  <style is:global>
    /* Cetak: satu kolom, tanpa tombol, tautan tetap terbaca. */
    @media print {
      @page { margin: 16mm; }
      body { background: #fff; color: #000; }
      .cv-tombol { display: none !important; }
      .md\:sticky { position: static !important; }
      main > div { padding: 0 !important; }
      .md\:grid-cols-12 { display: block !important; }
      .md\:col-span-4, .md\:col-span-8 { width: 100% !important; }
      .md\:col-span-8 { margin-top: 2rem; }
      a { color: #000; text-decoration: none; }
      section { break-inside: avoid; }
    }
  </style>

  <script>
    document.getElementById('cetak')?.addEventListener('click', () => window.print());
  </script>
</Base>
