---
interface Props { target: string }
const { target } = Astro.props;
const unit = ['Hari', 'Jam', 'Menit', 'Detik'];
---
<div id="countdown" data-target={target} role="timer" aria-label="Hitung mundur menuju hari pernikahan" class="flex justify-center divide-x divide-white/25 text-center">
  {unit.map((label) => (
    <div class="min-w-0 flex-1 px-2 sm:px-6">
      <p class="font-display text-4xl tabular-nums leading-none sm:text-5xl" data-unit={label}>00</p>
      <p class="label mt-2 opacity-80">{label}</p>
    </div>
  ))}
</div>
<script>
  const root = document.getElementById('countdown');
  const target = new Date(root?.dataset.target ?? '').getTime();
  const cell = (u: string) => root?.querySelector(`[data-unit="${u}"]`);
  const tick = () => {
    const s = Math.floor(Math.max(0, target - Date.now()) / 1000);
    const map: Record<string, number> = { Hari: Math.floor(s / 86400), Jam: Math.floor((s % 86400) / 3600), Menit: Math.floor((s % 3600) / 60), Detik: s % 60 };
    for (const [u, v] of Object.entries(map)) { const el = cell(u); if (el) el.textContent = String(v).padStart(2, '0'); }
  };
  tick();
  setInterval(tick, 1000);
</script>
