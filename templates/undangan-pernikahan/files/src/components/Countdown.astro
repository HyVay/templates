---
interface Props { target: string }
const { target } = Astro.props;
---
<div id="countdown" data-target={target} class="grid grid-cols-2 gap-3 text-center sm:grid-cols-4">
  {['Hari', 'Jam', 'Menit', 'Detik'].map((label) => (
    <div class="rounded-xl border border-stone-200 bg-white/70 px-2 py-3 backdrop-blur">
      <p class="text-2xl font-semibold tabular-nums text-stone-800" data-unit={label}>0</p>
      <p class="mt-0.5 text-[11px] uppercase tracking-wider text-stone-500">{label}</p>
    </div>
  ))}
</div>
<script>
  const root = document.getElementById('countdown');
  const target = new Date(root?.dataset.target ?? '').getTime();
  const cell = (u: string) => root?.querySelector(`[data-unit="${u}"]`);
  const tick = () => {
    const left = Math.max(0, target - Date.now());
    const s = Math.floor(left / 1000);
    const map: Record<string, number> = {
      Hari: Math.floor(s / 86400),
      Jam: Math.floor((s % 86400) / 3600),
      Menit: Math.floor((s % 3600) / 60),
      Detik: s % 60,
    };
    for (const [u, v] of Object.entries(map)) {
      const el = cell(u);
      if (el) el.textContent = String(v).padStart(2, '0');
    }
  };
  tick();
  setInterval(tick, 1000);
</script>
