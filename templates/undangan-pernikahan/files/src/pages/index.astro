---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';

const acara = {
  pria: 'Andi Pratama',
  wanita: 'Sari Wulandari',
  tanggalISO: '2026-12-20T09:00:00+07:00',
  tanggalTeks: 'Sabtu, 20 Desember 2026',
  akad: '09.00 WIB',
  resepsi: '11.00 - 14.00 WIB',
  tempat: 'Gedung Graha Wisata',
  alamat: 'Jl. Melati No. 21, Bandung',
  maps: 'https://maps.google.com/?q=Graha+Wisata+Bandung',
  wa: '6281234567890',
};

const galeri = [
  'https://images.unsplash.com/photo-1519741497674-611481863552?w=800&q=80',
  'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=800&q=80',
  'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=800&q=80',
];
---
<Base
  title={`Undangan Pernikahan ${acara.pria} & ${acara.wanita}`}
  description={`Kami mengundang Anda ke pernikahan ${acara.pria} dan ${acara.wanita}, ${acara.tanggalTeks} di ${acara.tempat}, ${acara.alamat}.`}
>
  <main class="bg-stone-50 text-stone-800">
    <!-- Pembuka -->
    <section class="relative flex min-h-[100dvh] items-center justify-center overflow-hidden px-4">
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img
          src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1600&q=80"
          alt=""
          class="h-full w-full object-cover opacity-25"
        />
      </div>
      <div class="relative z-10 mx-auto max-w-xl text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-stone-500">Undangan Pernikahan</p>
        <h1 class="mt-5 font-serif text-4xl leading-tight text-stone-900 md:text-6xl">
          {acara.pria}<span class="mx-2 text-emerald-700">&</span>{acara.wanita}
        </h1>
        <p class="mt-4 text-sm text-stone-600 md:text-base">{acara.tanggalTeks}</p>
        <div class="mx-auto mt-8 max-w-sm">
          <Countdown target={acara.tanggalISO} />
        </div>
        <a
          href="#acara"
          class="mt-10 inline-block rounded-lg bg-emerald-700 px-6 py-3 text-sm font-medium text-white transition-colors duration-150 hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
        >
          Lihat Detail Acara
        </a>
      </div>
    </section>

    <!-- Acara -->
    <section id="acara" class="px-4 py-16 md:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-serif text-2xl text-stone-900 md:text-3xl">Rangkaian Acara</h2>
        <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
          {[
            { judul: 'Akad Nikah', waktu: acara.akad },
            { judul: 'Resepsi', waktu: acara.resepsi },
          ].map((item) => (
            <div class="rounded-xl border border-stone-200 bg-white p-6">
              <h3 class="font-serif text-xl text-stone-900">{item.judul}</h3>
              <p class="mt-2 text-sm text-stone-600">{acara.tanggalTeks}</p>
              <p class="text-sm font-medium text-emerald-700">{item.waktu}</p>
              <p class="mt-4 text-sm text-stone-700">{acara.tempat}</p>
              <p class="text-sm text-stone-500">{acara.alamat}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a
            href={acara.maps}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-800 transition-colors duration-150 hover:bg-stone-100"
          >
            Buka Lokasi di Google Maps
          </a>
        </div>
      </div>
    </section>

    <!-- Galeri -->
    <section class="bg-white px-4 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center font-serif text-2xl text-stone-900 md:text-3xl">Galeri</h2>
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
          {galeri.map((src, i) => (
            <img
              src={src}
              alt={`Foto prewedding ${i + 1}`}
              loading="lazy"
              class="aspect-[4/5] w-full rounded-xl object-cover"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- RSVP -->
    <section class="px-4 py-16 md:py-24">
      <div class="mx-auto max-w-md">
        <h2 class="text-center font-serif text-2xl text-stone-900 md:text-3xl">Konfirmasi Kehadiran</h2>
        <p class="mt-3 text-center text-sm text-stone-600">
          Mohon konfirmasi agar kami dapat menyiapkan tempat dengan baik.
        </p>
        <form id="rsvp" class="mt-8 space-y-4">
          <div>
            <label for="nama" class="block text-sm font-medium text-stone-800">Nama</label>
            <input
              id="nama" name="nama" required placeholder="Nama lengkap"
              class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm outline-none transition-colors focus:border-emerald-700"
            />
          </div>
          <div>
            <label for="hadir" class="block text-sm font-medium text-stone-800">Kehadiran</label>
            <select
              id="hadir" name="hadir"
              class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm outline-none transition-colors focus:border-emerald-700"
            >
              <option>Hadir</option>
              <option>Tidak dapat hadir</option>
            </select>
          </div>
          <div>
            <label for="ucapan" class="block text-sm font-medium text-stone-800">Ucapan</label>
            <textarea
              id="ucapan" name="ucapan" rows="3" placeholder="Doa dan ucapan untuk mempelai"
              class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm outline-none transition-colors focus:border-emerald-700"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-lg bg-emerald-700 px-5 py-3 text-sm font-medium text-white transition-colors duration-150 hover:bg-emerald-800"
          >
            Kirim via WhatsApp
          </button>
        </form>
        <p class="mt-3 text-center text-xs text-stone-500">
          Konfirmasi dikirim sebagai pesan WhatsApp ke keluarga mempelai.
        </p>
      </div>
    </section>

    <footer class="border-t border-stone-200 px-4 py-10 text-center">
      <p class="font-serif text-lg text-stone-800">{acara.pria} & {acara.wanita}</p>
      <p class="mt-1 text-xs text-stone-500">{acara.tanggalTeks}</p>
    </footer>
  </main>

  <script define:vars={{ wa: acara.wa }}>
    const form = document.getElementById('rsvp');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = `Konfirmasi kehadiran:\nNama: ${d.get('nama')}\nKehadiran: ${d.get('hadir')}\nUcapan: ${d.get('ucapan') || '-'}`;
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</Base>
