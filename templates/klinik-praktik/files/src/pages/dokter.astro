---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JadwalPraktik from '../components/JadwalPraktik.astro';
import { klinik, dokter, hari, src } from '../data/klinik';
---
<Base
  title={`Dokter & Jadwal Praktik — ${klinik.nama}`}
  description={`${dokter.length} dokter tetap di ${klinik.nama} ${klinik.kota} beserta jadwal praktik Senin sampai Sabtu.`}
>
  <Fonts />
  <Header />
  <main id="konten" class="text-[#0F2A44]">
    <section class="border-b border-[#0F2A44]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#0F2A44]/75">Dokter & jadwal</p>
        <h1 class="font-display mt-3 text-4xl md:text-5xl">Empat dokter tetap</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0F2A44]/70 md:text-base">
          Jadwal berlaku untuk minggu berjalan. Saat dokter cuti, jadwal pengganti diumumkan lewat WhatsApp kepada pasien yang sudah membuat janji.
        </p>
      </div>
    </section>

    <!-- Ringkasan semua dokter: di HP jadwal sudah tercantum di tiap profil, jadi disembunyikan -->
    <section class="mx-auto hidden max-w-6xl px-4 py-12 md:block md:px-6 md:py-16">
      <JadwalPraktik />
    </section>

    <section class="border-t border-[#0F2A44]/15 bg-white">
      <div class="mx-auto max-w-6xl divide-y divide-[#0F2A44]/10 px-4 md:px-6">
        {dokter.map((d) => (
          <article id={d.slug} class="grid scroll-mt-20 grid-cols-[6.5rem_1fr] gap-x-5 gap-y-6 py-10 md:grid-cols-12 md:gap-8 md:py-16">
            <div class="md:col-span-3">
              <img src={src(d.foto, 600, 800)} width="600" height="800" alt={`Foto ${d.nama}`} loading="lazy" decoding="async" class="aspect-[3/4] w-full max-w-xs rounded-lg bg-[#0F2A44]/5 object-cover" />
            </div>
            <div class="md:col-span-5">
              <p class="font-mono text-xs uppercase tracking-widest text-[#2E7D6B]">{d.spesialisasi}</p>
              <h2 class="font-display mt-1 text-xl sm:text-2xl md:mt-2 md:text-3xl">{d.nama}</h2>
              <p class="mt-3 max-w-md text-pretty text-sm leading-relaxed text-[#0F2A44]/80 md:mt-4 md:text-base">{d.ringkas}</p>
              <a href={`/janji-temu/?dokter=${d.slug}`} class="mt-6 hidden items-center justify-center rounded-lg bg-[#2E7D6B] px-5 py-3 md:inline-flex text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#256655]">
                Janji temu dengan {d.nama.split(' ').slice(0, 2).join(' ')}
              </a>
            </div>
            <dl class="col-span-2 divide-y divide-[#0F2A44]/10 border-y border-[#0F2A44]/10 text-sm md:col-span-4">
              {hari.map((h) => (
                <div class="flex justify-between gap-4 py-2.5">
                  <dt class="text-[#0F2A44]/75">{h}</dt>
                  <dd class="tabular-nums">{d.jadwal[h] ?? <span class="text-[#0F2A44]/55">Tidak praktik</span>}</dd>
                </div>
              ))}
            </dl>
            <a href={`/janji-temu/?dokter=${d.slug}`} class="col-span-2 inline-flex min-h-11 items-center justify-center rounded-lg bg-[#2E7D6B] px-5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#256655] md:hidden">
              Janji temu dengan {d.nama.split(' ').slice(0, 2).join(' ')}
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
