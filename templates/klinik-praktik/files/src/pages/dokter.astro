---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JadwalPraktik from '../components/JadwalPraktik.astro';
import { klinik, dokter, hari } from '../data/klinik';
---
<Base
  title={`Dokter & Jadwal Praktik — ${klinik.nama}`}
  description={`${dokter.length} dokter tetap di ${klinik.nama} ${klinik.kota} beserta jadwal praktik Senin sampai Sabtu.`}
>
  <Fonts />
  <Header />
  <main class="text-[#0F2A44]">
    <section class="border-b border-[#0F2A44]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#0F2A44]/60">Dokter & jadwal</p>
        <h1 class="font-display mt-3 text-4xl md:text-5xl">Empat dokter tetap</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0F2A44]/70 md:text-base">
          Jadwal berlaku untuk minggu berjalan. Saat dokter cuti, jadwal pengganti diumumkan lewat WhatsApp kepada pasien yang sudah membuat janji.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
      <JadwalPraktik />
    </section>

    <section class="border-t border-[#0F2A44]/15 bg-white">
      <div class="mx-auto max-w-6xl divide-y divide-[#0F2A44]/10 px-4 md:px-6">
        {dokter.map((d) => (
          <article id={d.slug} class="grid scroll-mt-20 grid-cols-1 gap-6 py-12 md:grid-cols-12 md:gap-8 md:py-16">
            <div class="md:col-span-3">
              <img src={d.foto} alt={d.nama} loading="lazy" class="aspect-[3/4] w-full max-w-xs rounded-lg object-cover" />
            </div>
            <div class="md:col-span-5">
              <p class="font-mono text-xs uppercase tracking-widest text-[#2E7D6B]">{d.spesialisasi}</p>
              <h2 class="font-display mt-2 text-2xl md:text-3xl">{d.nama}</h2>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-[#0F2A44]/75 md:text-base">{d.ringkas}</p>
              <a href={`/janji-temu/?dokter=${d.slug}`} class="mt-6 inline-flex items-center justify-center rounded-lg bg-[#2E7D6B] px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#256655]">
                Janji temu dengan {d.nama.split(' ').slice(0, 2).join(' ')}
              </a>
            </div>
            <dl class="divide-y divide-[#0F2A44]/10 border-y border-[#0F2A44]/10 text-sm md:col-span-4">
              {hari.map((h) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-[#0F2A44]/60">{h}</dt>
                  <dd class="tabular-nums">{d.jadwal[h] ?? <span class="text-[#0F2A44]/30">Tidak praktik</span>}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
