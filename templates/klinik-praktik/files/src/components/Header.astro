---
import { klinik } from '../data/klinik';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/layanan/', label: 'Layanan' },
  { href: '/dokter/', label: 'Dokter & Jadwal' },
  { href: '/janji-temu/', label: 'Janji Temu' },
];
const here = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-[#0F2A44]/15 bg-[#FBFBF9]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 md:h-16 md:px-6">
    <a href="/" class="font-display text-lg text-[#0F2A44] md:text-xl">{klinik.nama}</a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'text-sm font-medium transition-colors duration-150 hover:text-[#0F2A44]',
            here === l.href ? 'text-[#0F2A44] underline decoration-[#2E7D6B] decoration-2 underline-offset-8' : 'text-[#0F2A44]/65',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href={`tel:+${klinik.teleponDarurat}`}
        class="inline-flex items-center gap-2 rounded-lg bg-[#C44536] px-4 py-2 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#a93a2d]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linejoin="round" /></svg>
        Darurat
      </a>
    </nav>
    <div class="flex items-center gap-1 md:hidden">
      <a
        href={`tel:+${klinik.teleponDarurat}`}
        aria-label="Telepon darurat"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-[#C44536] text-white transition-colors duration-150 hover:bg-[#a93a2d]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linejoin="round" /></svg>
      </a>
      <button
        id="nav-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-[#0F2A44] transition-colors duration-150 hover:bg-[#0F2A44]/5"
      >
        <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
        <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#0F2A44]/15 bg-[#FBFBF9] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <a href={l.href} class="block rounded-lg px-2 py-3 text-base font-medium text-[#0F2A44] transition-colors duration-150 hover:bg-[#0F2A44]/5">
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
