---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" />
<style is:global>
  body { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; background: #FBFBF9; }
  .font-display { font-family: 'DM Serif Display', Georgia, serif; }
  .font-body { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; }
  ::selection { background: #2E7D6B; color: #fff; }
  :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
    outline: 2px solid #2E7D6B !important;
    outline-offset: 2px;
    border-radius: 0.5rem;
  }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
