---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,500&family=Karla:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Karla', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Bodoni Moda', 'Didot', Georgia, serif; }
  .font-body { font-family: 'Karla', ui-sans-serif, system-ui, sans-serif; }
  /* Fokus keyboard selalu terlihat; selector ini mengalahkan .outline-none. */
  html :focus-visible { outline: 2px solid #B87333; outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
