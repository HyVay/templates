---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { toko, layanan, barber, slotJam, rupiah } from '../data/barber';

const input = 'mt-1 w-full border border-[#111111]/30 bg-white px-3 py-3 text-sm text-[#111111] outline-none transition-colors duration-150 focus:border-[#B87333]';
const slot = slotJam();
---
<Base title={`Booking — ${toko.nama}`} description={`Ambil jadwal di ${toko.nama}: pilih layanan, barber, tanggal, dan jam. Konfirmasi lewat WhatsApp, tanpa uang muka.`}>
  <Fonts />
  <div class="bg-[#111111] text-[#EFE9E1]">
    <Header />
    <section class="border-b border-[#EFE9E1]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#B87333]">Tanpa uang muka · slot 30 menit</p>
        <h1 class="mt-4 font-display text-5xl font-semibold leading-[0.95] tracking-tight md:text-7xl">Ambil jadwal</h1>
        <p class="mt-5 max-w-xl text-sm leading-relaxed text-[#EFE9E1]/75 md:text-base">
          Isi formulir, pesan terbuka di WhatsApp kami. Jadwal berlaku setelah kami balas "oke".
        </p>
      </div>
    </section>
  </div>
  <main class="bg-[#EFE9E1] text-[#111111]">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-12 md:grid-cols-12 md:px-6 md:py-16">
      <form id="booking-form" class="space-y-5 md:col-span-7">
        <div>
          <label for="nama" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Nama</label>
          <input id="nama" name="nama" required placeholder="Nama Anda" class={input} />
        </div>
        <div>
          <label for="layanan" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Layanan</label>
          <select id="layanan" name="layanan" class={input}>
            {layanan.map((l) => <option value={l.nama}>{l.nama} — {rupiah(l.harga)} · {l.durasi} mnt</option>)}
          </select>
        </div>
        <div>
          <label for="barber" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Barber</label>
          <select id="barber" name="barber" class={input}>
            <option value="Siapa saja">Siapa saja yang kosong</option>
            {barber.map((b) => <option value={b.nama} data-slug={b.slug}>{b.nama} — {b.spesialisasi} (libur {b.libur})</option>)}
          </select>
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="tanggal" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Tanggal</label>
            <input id="tanggal" name="tanggal" type="date" required class={input} />
          </div>
          <div>
            <label for="jam" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Jam</label>
            <select id="jam" name="jam" class={input}>
              {slot.map((s) => <option value={s}>{s.replace(':', '.')}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label for="catatan" class="text-xs uppercase tracking-[0.18em] text-[#111111]/65">Catatan</label>
          <textarea id="catatan" name="catatan" rows="3" placeholder="Referensi gaya, alergi produk, atau datang bersama anak" class={input}></textarea>
        </div>
        <button type="submit" class="inline-flex h-12 w-full items-center justify-center bg-[#111111] px-6 text-xs uppercase tracking-[0.18em] text-[#EFE9E1] transition-colors duration-150 hover:bg-[#B87333] sm:w-auto">
          Kirim via WhatsApp
        </button>
        <p class="text-xs leading-relaxed text-[#111111]/60">
          Situs ini statis dan tidak menyimpan data. Isian dikirim sebagai pesan WhatsApp ke {toko.nama}.
        </p>
      </form>

      <aside class="md:col-span-5">
        <dl class="divide-y divide-[#111111]/15 border-y border-[#111111]/15">
          {toko.jam.map((j) => (
            <div class="py-4">
              <dt class="text-xs uppercase tracking-[0.18em] text-[#111111]/55">{j.hari}</dt>
              <dd class="mt-1 font-display text-2xl">{j.buka}</dd>
            </div>
          ))}
          <div class="py-4">
            <dt class="text-xs uppercase tracking-[0.18em] text-[#111111]/55">Alamat</dt>
            <dd class="mt-1 font-display text-2xl leading-tight">{toko.alamat}</dd>
            <a href={toko.maps} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#B87333]">Buka di Google Maps</a>
          </div>
          <div class="py-4">
            <dt class="text-xs uppercase tracking-[0.18em] text-[#111111]/55">Langsung chat</dt>
            <dd class="mt-1"><a href={`https://wa.me/${toko.telepon}`} target="_blank" rel="noopener noreferrer" class="font-display text-2xl underline underline-offset-4 transition-colors duration-150 hover:text-[#B87333]">{toko.telepon}</a></dd>
          </div>
        </dl>
        <img src={toko.foto.alat} alt="Gunting, sisir, dan clipper di meja barber" loading="lazy" class="mt-8 aspect-[4/3] w-full object-cover" />
      </aside>
    </div>
  </main>
  <Footer />

  <script define:vars={{ wa: toko.telepon, nama: toko.nama }}>
    const form = document.getElementById('booking-form');
    // Pra-pilih barber dari tautan /booking/?barber=<slug> di halaman tim.
    const slug = new URLSearchParams(location.search).get('barber');
    if (slug) {
      const opt = form?.querySelector(`#barber option[data-slug="${slug}"]`);
      if (opt) opt.selected = true;
    }
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo ${nama}, saya ${d.get('nama')} mau booking.`,
        `Layanan: ${d.get('layanan')}`,
        `Barber: ${d.get('barber')}`,
        `Tanggal: ${d.get('tanggal')} pukul ${String(d.get('jam')).replace(':', '.')}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</Base>
