---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DaftarHarga from '../components/DaftarHarga.astro';
import { toko, layanan, barber, galeri } from '../data/barber';

const unggulan = layanan.slice(0, 4);
---
<Base title={`${toko.nama} — Barbershop di ${toko.kota}`} description={`${toko.tagline} ${toko.deskripsi}`}>
  <Fonts />
  <Header />
  <main id="konten">
  <div class="bg-[#111111] text-[#EFE9E1]">
      <!-- Hero -->
      <section class="border-b border-[#EFE9E1]/15">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:gap-8 md:px-6 md:py-20">
          <div class="flex flex-col md:col-span-7 md:justify-center">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#B87333]">Sejak {toko.sejak} · {toko.kota}</p>
              <h1 class="mt-5 font-display text-6xl font-semibold leading-[0.9] tracking-tight md:text-8xl">{toko.nama}</h1>
              <p class="mt-6 max-w-md font-display text-xl italic text-[#EFE9E1]/85 md:text-2xl [text-wrap:balance]">{toko.tagline}</p>
              <p class="mt-5 max-w-[46ch] text-[15px] leading-relaxed text-[#EFE9E1]/80">Empat kursi di Dago, jadwal per 30 menit, tanpa uang muka.</p>
            </div>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/booking/" class="inline-flex h-12 items-center justify-center bg-[#EFE9E1] px-6 text-xs uppercase tracking-[0.18em] text-[#111111] transition-colors duration-150 hover:bg-[#B87333]">
                Ambil jadwal
              </a>
              <a href="/layanan/" class="inline-flex h-12 items-center justify-center border border-[#EFE9E1]/40 px-6 text-xs uppercase tracking-[0.18em] transition-colors duration-150 hover:border-[#EFE9E1]">
                Lihat harga
              </a>
            </div>
            <dl class="mt-12 grid max-w-md grid-cols-2 gap-x-6 border-t border-[#EFE9E1]/15 pt-5 text-sm">
              {toko.jam.map((j) => (
                <div>
                  <dt class="text-xs uppercase tracking-[0.18em] text-[#EFE9E1]/75">{j.hari}</dt>
                  <dd class="mt-1 font-display text-xl tabular-nums">{j.buka}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="md:col-span-5">
            <img width="1200" height="1600" fetchpriority="high" src={toko.foto.hero} alt="Kursi barber kulit di ruang potong" class="aspect-[4/5] w-full object-cover md:aspect-[3/4]" />
          </div>
        </div>
      </section>

      <!-- Tentang -->
      <section class="border-b border-[#EFE9E1]/15">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#B87333] md:col-span-3">Tentang</p>
          <p class="font-display text-2xl leading-snug md:col-span-9 md:text-3xl">{toko.deskripsi}</p>
        </div>
      </section>
    </div>

  <!-- Bagian terang -->
  <div class="bg-[#EFE9E1] text-[#111111]">
    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">Harga</h2>
        <a href="/layanan/" class="inline-flex min-h-[44px] items-center text-xs uppercase tracking-[0.18em] underline underline-offset-4 transition-colors duration-150 hover:text-[#8E5524]">Semua layanan</a>
      </div>
      <div class="mt-8">
        <DaftarHarga items={unggulan} ringkas />
      </div>
    </section>

    <section class="border-t border-[#111111]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <div class="flex items-end justify-between">
          <h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">Barber</h2>
          <a href="/tim/" class="inline-flex min-h-[44px] items-center text-xs uppercase tracking-[0.18em] underline underline-offset-4 transition-colors duration-150 hover:text-[#8E5524]">Profil lengkap</a>
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4">
          {barber.map((b) => (
            <li>
              <img width="1200" height="1600" decoding="async" src={b.foto} alt={`Foto ${b.nama}`} loading="lazy" class="aspect-[3/4] w-full object-cover grayscale transition-all duration-150 hover:grayscale-0" />
              <p class="mt-3 font-display text-lg font-medium leading-tight">{b.nama}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.14em] text-[#111111]/75">{b.spesialisasi}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-[#111111]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <div class="flex items-end justify-between"><h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">Hasil</h2><span class="text-xs uppercase tracking-[0.18em] text-[#111111]/75 sm:hidden">Geser →</span></div>
        <div class="-mx-4 mt-8 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 sm:pb-0">
          {galeri.map((g) => (
            <img width="1200" height="1500" decoding="async" src={g.src} alt={g.alt} loading="lazy" class="aspect-[4/5] w-[78%] shrink-0 snap-start object-cover sm:w-full" />
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-[#111111]/15">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between md:px-6 md:py-20">
        <p class="max-w-xl font-display text-2xl leading-snug md:text-3xl">Pilih barber, pilih jam. Kursi menunggu Anda, bukan sebaliknya.</p>
        <a href="/booking/" class="inline-flex h-12 items-center justify-center bg-[#111111] px-6 text-xs uppercase tracking-[0.18em] text-[#EFE9E1] transition-colors duration-150 hover:bg-[#B87333]">
          Booking sekarang
        </a>
      </div>
    </section>
  </div>
  </main>
  <Footer />
</Base>
