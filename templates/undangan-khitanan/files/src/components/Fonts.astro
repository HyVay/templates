---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-arab.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Amiri:wght@400;700&family=Nunito:wght@400;600;700&display=swap"
/>
<style is:global>
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { font-family: 'Nunito', ui-sans-serif, system-ui, sans-serif; background: #E8F1F8; -webkit-font-smoothing: antialiased; }
  .font-display { font-family: 'Lora', Georgia, serif; }
  .font-arab { font-family: 'Amiri', 'Scheherazade New', serif; }
  .font-body { font-family: 'Nunito', ui-sans-serif, system-ui, sans-serif; }
  h1, h2, h3 { text-wrap: balance; }
  p, li, dd { text-wrap: pretty; }
  ::selection { background: #F2B544; color: #1B4965; }
  :focus-visible { outline: 2px solid #1B4965; outline-offset: 3px; border-radius: 6px; }
  .bg-\[\#1B4965\] :focus-visible, footer :focus-visible { outline-color: #F2B544; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
