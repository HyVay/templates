---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Hanken+Grotesk:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Syne', ui-sans-serif, system-ui, sans-serif; }
  .font-body { font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif; }
</style>
