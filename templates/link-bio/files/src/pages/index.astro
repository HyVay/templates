---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import { profil, tautan, sorotan, sosial, img, formatWa } from '../data/profil';

const tahun = new Date().getFullYear();
---
<Base title={`${profil.nama} — ${profil.peran}`} description={profil.bio}>
  <Fonts />
  <main class="min-h-[100dvh] bg-[#F3EFE6] text-[#141414]">
    <div class="mx-auto max-w-md px-4 pb-16 pt-6 sm:px-0 md:grid md:max-w-5xl md:grid-cols-12 md:gap-x-14 md:px-6 md:pt-12">
      <!-- Profil: di desktop menempel di kolom kiri, di HP jadi bagian atas -->
      <header class="md:col-span-5 md:self-start md:sticky md:top-12">
        <div class="relative overflow-hidden">
          <img
            src={img(profil.foto, 800, 800)}
            srcset={`${img(profil.foto, 500, 500)} 500w, ${img(profil.foto, 800, 800)} 800w, ${img(profil.foto, 1100, 1100)} 1100w`}
            sizes="(min-width: 768px) 420px, 100vw"
            width="800"
            height="800"
            fetchpriority="high"
            decoding="async"
            alt={`Foto ${profil.nama}`}
            class="aspect-square w-full bg-[#141414]/10 object-cover"
          />
          <p class="absolute left-0 top-0 z-10 bg-[#141414] px-3 py-1.5 text-[11px] uppercase tracking-[0.2em] text-[#F3EFE6]">
            {profil.kota}
          </p>
          <button
            id="bagikan"
            type="button"
            aria-label="Bagikan halaman ini"
            title="Bagikan"
            class="absolute right-0 top-0 z-10 inline-flex h-11 w-11 items-center justify-center bg-[#141414] text-[#F3EFE6] transition-colors duration-150 hover:bg-[#1F6F8B]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 002 2h10a2 2 0 002-2v-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
        <h1 class="relative z-10 -mt-8 inline-block bg-[#F3EFE6] pr-5 pt-3 font-display text-4xl font-extrabold leading-[0.95] tracking-tight sm:text-5xl">
          {profil.nama}
        </h1>
        <p class="mt-3 text-xs uppercase tracking-[0.2em] text-[#1F6F8B]">{profil.peran}</p>
        <p class="mt-3 text-base leading-relaxed text-[#141414]/80">{profil.bio}</p>
        <p id="status-bagikan" role="status" aria-live="polite" class="mt-2 text-sm text-[#1F6F8B] empty:hidden"></p>
      </header>

      <div class="md:col-span-7">
      <!-- Sosial -->
      <ul class="mt-4 flex md:mt-0 divide-x divide-[#141414]/15 border-y border-[#141414]/15">
        {sosial.map((s) => (
          <li class="flex-1">
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="flex h-12 items-center justify-center text-[#141414] transition-colors duration-150 hover:bg-[#1F6F8B] hover:text-white"
            >
              {s.jenis === 'instagram' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
              {s.jenis === 'tiktok' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M14 3h3a5 5 0 0 0 4 4v3a8 8 0 0 1-4-1.2V15a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3V3z" />
                </svg>
              )}
              {s.jenis === 'youtube' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="M10 9.5v5l4.5-2.5L10 9.5z" fill="currentColor" stroke="none" />
                </svg>
              )}
              {s.jenis === 'whatsapp' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 2a8 8 0 11-4.1 14.9l-.4-.2-2.9.8.8-2.8-.2-.4A8 8 0 0112 4z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>

      <!-- Tautan -->
      <section class="mt-8" aria-labelledby="judul-tautan">
        <h2 id="judul-tautan" class="text-xs uppercase tracking-[0.2em] text-[#141414]/70">Tautan</h2>
        <ol class="mt-3 divide-y divide-[#141414]/15 border-y border-[#141414]/15">
          {tautan.map((t, i) => (
            <li>
              <a
                href={t.href}
                target={t.luar ? '_blank' : undefined}
                rel={t.luar ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-4 py-4 transition-colors duration-150 hover:bg-[#1F6F8B] hover:text-white"
              >
                <span class="w-7 shrink-0 pl-1 font-mono text-xs tabular-nums text-[#141414]/70 group-hover:text-white/80">{String(i + 1).padStart(2, '0')}</span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-lg font-bold leading-tight">{t.judul}</span>
                  <span class="mt-0.5 block text-sm text-[#141414]/75 group-hover:text-white/85">{t.keterangan}</span>
                </span>
                <svg class="mr-2 shrink-0 transition-transform duration-150 group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Sorotan -->
      <section class="mt-10" aria-labelledby="judul-sorotan">
        <div class="flex items-baseline justify-between">
          <h2 id="judul-sorotan" class="text-xs uppercase tracking-[0.2em] text-[#141414]/70">Sorotan</h2>
          <span class="font-mono text-xs text-[#141414]/70">{sorotan.length} produk</span>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-4">
          {sorotan.map((p) => (
            <a href={p.href} target="_blank" rel="noopener noreferrer" class="group block">
              <div class="overflow-hidden bg-[#141414]/10"><img src={img(p.foto, 500, 625)} alt={p.nama} width="500" height="625" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" /></div>
              <p class="mt-3 font-display text-base font-bold leading-tight underline-offset-4 group-hover:underline">{p.nama}</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[#141414]/75">{p.keterangan}</p>
              <p class="mt-2 font-mono text-sm tabular-nums text-[#1F6F8B]">{p.harga}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Kontak -->
      <section class="mt-10 border-t border-[#141414]/15 pt-6">
        <p class="text-sm leading-relaxed text-[#141414]/70">
          Pertanyaan resep atau pesanan dalam jumlah banyak? Kirim pesan, saya balas sendiri.
        </p>
        <a
          href={`https://wa.me/${profil.telepon}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex min-h-[52px] items-center justify-between gap-3 bg-[#141414] px-4 font-display text-base font-bold text-[#F3EFE6] transition-colors duration-150 hover:bg-[#1F6F8B]"
        >
          <span>Chat WhatsApp</span>
          <span class="font-mono text-xs font-normal tabular-nums tracking-wide">{formatWa(profil.telepon)}</span>
        </a>
      </section>

      <footer class="mt-12 flex items-center justify-between text-xs text-[#141414]/70">
        <span>{profil.nama}</span>
        <span>{tahun}</span>
      </footer>
      </div>
    </div>
  </main>

  <script>
    // Bagikan lewat menu bawaan HP; di desktop, salin tautan ke clipboard.
    const btn = document.getElementById('bagikan');
    const status = document.getElementById('status-bagikan');
    btn?.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) {
          await navigator.share(data);
        } else {
          await navigator.clipboard.writeText(location.href);
          if (status) status.textContent = 'Tautan disalin. Tempel di bio atau chat.';
        }
      } catch {
        /* pengguna membatalkan menu bagikan */
      }
    });
  </script>
</Base>
