---
import { kedai } from '../data/kedai';
---
<footer class="border-t border-[#1F3D2B]/15 bg-[#1F3D2B] text-[#F6F1E7]">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-3xl">{kedai.nama}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#F6F1E7]/75">{kedai.tagline}</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs uppercase tracking-widest text-[#F6F1E7]/60">Jam buka</p>
      <ul class="mt-3 space-y-2 text-sm">
        {kedai.jam.map((j) => (
          <li>
            <span class="block text-[#F6F1E7]/75">{j.hari}</span>
            <span class="font-medium">{j.buka}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="text-xs uppercase tracking-widest text-[#F6F1E7]/60">Temukan kami</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>{kedai.alamat}</li>
        <li><a href={kedai.maps} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#F2B544]">Buka di Google Maps</a></li>
        <li><a href={`https://wa.me/${kedai.telepon}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#F2B544]">WhatsApp {kedai.telepon}</a></li>
        <li><a href={`https://instagram.com/${kedai.instagram}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#F2B544]">@{kedai.instagram}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[#F6F1E7]/15 px-4 py-5 text-xs text-[#F6F1E7]/60 md:px-6">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} {kedai.nama}, {kedai.kota}.</span>
      <span>{kedai.catatanJam}</span>
    </div>
  </div>
</footer>
