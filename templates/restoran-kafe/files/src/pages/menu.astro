---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DaftarMenu from '../components/DaftarMenu.astro';
import { kedai, menu } from '../data/kedai';

const jumlah = menu.reduce((n, k) => n + k.item.length, 0);
---
<Base
  title={`Menu — ${kedai.nama}`}
  description={`Daftar menu ${kedai.nama}, ${kedai.kota}: ${jumlah} pilihan kopi, minuman, makanan rumahan, dan camilan dengan harga.`}
>
  <Fonts />
  <div class="bg-[#F6F1E7] text-[#1F3D2B]">
    <Header />
    <main id="konten">
      <section class="border-b border-[#1F3D2B]/15">
        <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-[#A8432D]">{jumlah} pilihan · harga sudah termasuk pajak</p>
          <h1 class="mt-4 font-display text-6xl leading-[0.92] tracking-tight md:text-8xl">Menu</h1>
          <p class="mt-6 max-w-lg font-display text-lg italic text-[#1F3D2B]/85 md:text-xl [text-wrap:balance]">
            Porsi untuk satu orang yang lapar. Untuk berbagi, pesan dua lauk dan satu camilan.
          </p>
        </div>
      </section>

      <!-- Navigasi kategori, menempel di bawah header; kategori aktif ditandai saat scroll -->
      <nav aria-label="Kategori menu" class="sticky top-14 z-40 border-b border-[#1F3D2B]/15 bg-[#F6F1E7]/95 backdrop-blur md:top-16">
        <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-4 md:px-6">
          {menu.map((k) => (
            <a href={`#${k.id}`} data-kat={k.id} class="kat-link inline-flex min-h-[48px] shrink-0 items-center border-b-2 border-transparent text-sm transition-colors duration-150 hover:text-[#A8432D] aria-[current=true]:border-[#A8432D] aria-[current=true]:font-medium aria-[current=true]:text-[#A8432D]">
              {k.nama}
              <span class="ml-1.5 text-xs tabular-nums text-[#1F3D2B]/60">{k.item.length}</span>
            </a>
          ))}
        </div>
      </nav>

      <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
          <div class="space-y-16 md:col-span-8">
            {menu.map((k) => (
              <section id={k.id} class="kat scroll-mt-32">
                <div class="flex items-baseline justify-between border-b-2 border-[#1F3D2B] pb-3">
                  <h2 class="font-display text-3xl md:text-4xl">{k.nama}</h2>
                  <span class="text-xs uppercase tracking-widest text-[#1F3D2B]/75">{k.item.length} item</span>
                </div>
                {k.catatan && <p class="mt-3 max-w-prose text-sm leading-relaxed text-[#1F3D2B]/80">{k.catatan}</p>}
                <div class="mt-2">
                  <DaftarMenu item={k.item} />
                </div>
              </section>
            ))}
          </div>

          <aside class="md:col-span-4">
            <div class="space-y-6 md:sticky md:top-36">
              <div class="rounded-sm border border-[#1F3D2B]/15 bg-[#EFE8D9] p-6">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-[#A8432D]">Catatan dapur</p>
                <p class="mt-3 text-sm leading-relaxed text-[#1F3D2B]/85">
                  Punya alergi atau pantangan? Beri tahu kami saat memesan. Sambal selalu terpisah, pedasnya bisa diatur.
                </p>
                <p class="mt-3 text-sm leading-relaxed text-[#1F3D2B]/85">
                  Pesanan bawa pulang di atas 10 porsi, kabari sehari sebelumnya.
                </p>
                <a href={`https://wa.me/${kedai.telepon}`} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-sm bg-[#1F3D2B] px-5 text-sm font-medium text-[#F6F1E7] transition-colors duration-150 hover:bg-[#2C5A3F]">
                  Pesan bawa pulang via WhatsApp
                </a>
              </div>
              <dl class="divide-y divide-[#1F3D2B]/15 border-y border-[#1F3D2B]/15">
                {kedai.jam.map((j) => (
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="text-sm text-[#1F3D2B]/75">{j.hari}</dt>
                    <dd class="font-display text-lg tabular-nums">{j.buka}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </aside>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <script>
    const links = document.querySelectorAll<HTMLAnchorElement>('.kat-link');
    const set = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.kat === id)));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) set(e.target.id); }),
      { rootMargin: '-40% 0px -55% 0px' },
    );
    document.querySelectorAll('.kat').forEach((el) => io.observe(el));
  </script>
</Base>
