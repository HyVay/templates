---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DaftarMenu from '../components/DaftarMenu.astro';
import { kedai, menu } from '../data/kedai';

const jumlah = menu.reduce((n, k) => n + k.item.length, 0);
---
<Base
  title={`Menu — ${kedai.nama}`}
  description={`Daftar menu ${kedai.nama}, ${kedai.kota}: ${jumlah} pilihan kopi, minuman, makanan rumahan, dan camilan dengan harga.`}
>
  <Fonts />
  <div class="bg-[#F6F1E7] text-[#1F3D2B]">
    <Header />
    <main>
      <section class="border-b border-[#1F3D2B]/15">
        <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
          <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">{jumlah} pilihan · harga sudah termasuk pajak</p>
          <h1 class="mt-4 font-display text-5xl leading-[0.95] tracking-tight md:text-7xl">Menu</h1>
          <p class="mt-6 max-w-lg font-display text-lg italic text-[#1F3D2B]/75 md:text-xl">
            Porsi untuk satu orang yang lapar. Untuk berbagi, pesan dua lauk dan satu camilan.
          </p>
        </div>
      </section>

      <!-- Navigasi kategori, menempel di bawah header -->
      <nav aria-label="Kategori menu" class="sticky top-14 z-40 border-b border-[#1F3D2B]/15 bg-[#F6F1E7]/95 backdrop-blur md:top-16">
        <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-4 md:px-6">
          {menu.map((k) => (
            <a href={`#${k.id}`} class="shrink-0 border-b-2 border-transparent py-3 text-sm transition-colors duration-150 hover:border-[#C8553D] hover:text-[#C8553D]">
              {k.nama}
            </a>
          ))}
        </div>
      </nav>

      <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <div class="space-y-16 md:max-w-3xl">
          {menu.map((k) => (
            <section id={k.id} class="scroll-mt-32">
              <div class="flex items-baseline justify-between border-b-2 border-[#1F3D2B] pb-3">
                <h2 class="font-display text-3xl md:text-4xl">{k.nama}</h2>
                <span class="text-xs uppercase tracking-widest text-[#1F3D2B]/60">{k.item.length} item</span>
              </div>
              {k.catatan && <p class="mt-3 text-sm leading-relaxed text-[#1F3D2B]/70">{k.catatan}</p>}
              <div class="mt-2">
                <DaftarMenu item={k.item} />
              </div>
            </section>
          ))}
        </div>
        <div class="mt-16 border-t border-[#1F3D2B]/15 pt-8 md:max-w-3xl">
          <p class="text-sm leading-relaxed text-[#1F3D2B]/70">
            Punya alergi atau pantangan? Beri tahu kami saat memesan. Sambal selalu terpisah, pedasnya bisa diatur. Untuk pesanan bawa pulang di atas 10 porsi, hubungi WhatsApp sehari sebelumnya.
          </p>
          <a href={`https://wa.me/${kedai.telepon}`} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center justify-center rounded-sm bg-[#1F3D2B] px-5 py-3 text-sm font-medium text-[#F6F1E7] transition-colors duration-150 hover:bg-[#C8553D]">
            Pesan bawa pulang via WhatsApp
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
