---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { kedai, galeri } from '../data/kedai';

const kelas: Record<string, string> = {
  lebar: 'col-span-2 aspect-[16/9]',
  kotak: 'aspect-square',
  tinggi: 'aspect-[3/4]',
};
---
<Base title={`Galeri — ${kedai.nama}`} description={`Suasana ${kedai.nama} di ${kedai.kota}: ruang dalam, teras, dapur, dan sajian kami.`}>
  <Fonts />
  <div class="bg-[#F6F1E7] text-[#1F3D2B]">
    <Header />
    <main>
      <section class="border-b border-[#1F3D2B]/15">
        <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
          <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">Sekilas suasana</p>
          <h1 class="mt-4 font-display text-5xl leading-[0.95] tracking-tight md:text-7xl">Galeri</h1>
          <p class="mt-6 max-w-lg font-display text-lg italic text-[#1F3D2B]/75 md:text-xl">
            Tiga puluh dua kursi, satu teras, dan dapur yang terbuka. Foto diambil pada hari kerja biasa.
          </p>
        </div>
      </section>
      <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
          {galeri.map((g) => (
            <img src={g.src} alt={g.alt} loading="lazy" class:list={['w-full object-cover', kelas[g.bentuk]]} />
          ))}
        </div>
        <p class="mt-8 text-sm text-[#1F3D2B]/70">
          Mau memotret di sini untuk keperluan komersial? Kabari dulu lewat <a href={`https://wa.me/${kedai.telepon}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#C8553D]">WhatsApp</a>, biasanya kami oke.
        </p>
      </section>
    </main>
    <Footer />
  </div>
</Base>
