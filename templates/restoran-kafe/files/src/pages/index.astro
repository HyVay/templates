---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DaftarMenu from '../components/DaftarMenu.astro';
import { kedai, menu } from '../data/kedai';

const favorit = menu.flatMap((k) => k.item.filter((m) => m.favorit)).slice(0, 6);
---
<Base title={`${kedai.nama} — ${kedai.tagline}`} description={kedai.deskripsi}>
  <Fonts />
  <div class="bg-[#F6F1E7] text-[#1F3D2B]">
    <Header />
    <main>
      <!-- Hero: teks kiri, foto kanan -->
      <section class="border-b border-[#1F3D2B]/15">
        <div class="mx-auto grid max-w-6xl grid-cols-1 md:grid-cols-12">
          <div class="flex flex-col justify-between px-4 py-14 md:col-span-6 md:px-6 md:py-20">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">Kotagede, {kedai.kota}</p>
              <h1 class="mt-5 font-display text-5xl leading-[0.95] tracking-tight md:text-7xl">{kedai.nama}</h1>
              <p class="mt-6 max-w-md font-display text-xl italic leading-snug text-[#1F3D2B]/80 md:text-2xl">{kedai.tagline}</p>
            </div>
            <div class="mt-12 grid grid-cols-1 gap-6 border-t border-[#1F3D2B]/15 pt-6 sm:grid-cols-2">
              <div>
                <p class="text-xs uppercase tracking-widest text-[#1F3D2B]/60">Jam buka</p>
                {kedai.jam.map((j) => (
                  <p class="mt-1 text-sm"><span class="text-[#1F3D2B]/65">{j.hari}</span> <span class="ml-1 font-medium">{j.buka}</span></p>
                ))}
              </div>
              <div class="flex flex-col gap-3 sm:items-end">
                <a href="/menu/" class="inline-flex items-center justify-center rounded-sm bg-[#1F3D2B] px-5 py-3 text-sm font-medium text-[#F6F1E7] transition-colors duration-150 hover:bg-[#C8553D]">Lihat menu</a>
                <a href="/reservasi/" class="inline-flex items-center justify-center rounded-sm border border-[#1F3D2B] px-5 py-3 text-sm font-medium transition-colors duration-150 hover:bg-[#1F3D2B]/10">Pesan meja</a>
              </div>
            </div>
          </div>
          <div class="md:col-span-6 md:border-l md:border-[#1F3D2B]/15">
            <img
              src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=1600&q=80"
              alt="Ruang dalam kedai dengan meja kayu dan jendela besar"
              class="aspect-[4/5] h-full w-full object-cover"
            />
          </div>
        </div>
      </section>

      <!-- Dari dapur kami -->
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <div class="md:col-span-5">
            <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">Dari dapur kami</p>
            <h2 class="mt-4 font-display text-3xl leading-tight md:text-4xl">Masakan yang sama seperti di rumah, kalau rumah Anda punya dapur yang rajin.</h2>
            <p class="mt-6 text-sm leading-relaxed text-[#1F3D2B]/75 md:text-base">{kedai.deskripsi}</p>
            <p class="mt-4 text-sm leading-relaxed text-[#1F3D2B]/75 md:text-base">
              Lauk berganti setiap hari tergantung apa yang bagus di pasar. Yang selalu ada: pecel, ayam goreng lengkuas, dan mendoan. Sisanya tanya saja, kami senang kalau ditanya.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4 md:col-span-7 md:gap-6">
            <img src="https://images.unsplash.com/photo-1603133872878-684f208fb84b?w=800&q=80" alt="Nasi goreng kampung di piring putih" loading="lazy" class="aspect-[3/4] w-full object-cover" />
            <img src="https://images.unsplash.com/photo-1569562211093-4ed0d0758f12?w=800&q=80" alt="Semangkuk mie kuah dengan jeruk nipis dan sambal" loading="lazy" class="mt-10 aspect-[3/4] w-full object-cover" />
          </div>
        </div>
      </section>

      <!-- Menu favorit -->
      <section class="border-y border-[#1F3D2B]/15 bg-[#EFE8D9]">
        <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">Paling sering dipesan</p>
              <h2 class="mt-3 font-display text-3xl md:text-4xl">Enam favorit</h2>
            </div>
            <a href="/menu/" class="text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#C8553D]">Menu lengkap</a>
          </div>
          <div class="mt-8 border-t border-[#1F3D2B]/20 md:max-w-3xl">
            <DaftarMenu item={favorit} tandai={false} />
          </div>
        </div>
      </section>

      <!-- Jam & lokasi -->
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <div class="md:col-span-4">
            <p class="text-xs uppercase tracking-[0.25em] text-[#C8553D]">Datang</p>
            <h2 class="mt-3 font-display text-3xl md:text-4xl">Jam & lokasi</h2>
          </div>
          <dl class="divide-y divide-[#1F3D2B]/15 border-y border-[#1F3D2B]/15 md:col-span-8">
            {kedai.jam.map((j) => (
              <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
                <dt class="text-sm text-[#1F3D2B]/65">{j.hari}</dt>
                <dd class="font-display text-xl sm:col-span-2">{j.buka}</dd>
              </div>
            ))}
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
              <dt class="text-sm text-[#1F3D2B]/65">Alamat</dt>
              <dd class="sm:col-span-2">
                <p class="font-display text-xl">{kedai.alamat}</p>
                <a href={kedai.maps} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#C8553D]">Petunjuk arah</a>
              </dd>
            </div>
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
              <dt class="text-sm text-[#1F3D2B]/65">Catatan</dt>
              <dd class="text-sm leading-relaxed sm:col-span-2">{kedai.catatanJam}</dd>
            </div>
          </dl>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
