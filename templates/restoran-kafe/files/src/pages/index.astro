---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DaftarMenu from '../components/DaftarMenu.astro';
import { kedai, menu, foto } from '../data/kedai';

// Judul dihitung dari data supaya tidak pernah bohong soal jumlahnya.
const favorit = menu.flatMap((k) => k.item.filter((m) => m.favorit)).slice(0, 6);
const angka = ['Nol', 'Satu', 'Dua', 'Tiga', 'Empat', 'Lima', 'Enam'][favorit.length] ?? String(favorit.length);
const separuh = Math.ceil(favorit.length / 2);
const label = 'text-xs font-medium uppercase tracking-[0.2em] text-[#A8432D]';
---
<Base title={`${kedai.nama} — ${kedai.tagline}`} description={kedai.deskripsi}>
  <Fonts />
  <div class="bg-[#F6F1E7] text-[#1F3D2B]">
    <Header />
    <main id="konten">
      <!-- Hero: teks kiri, foto kanan -->
      <section class="border-b border-[#1F3D2B]/15">
        <div class="mx-auto grid max-w-6xl grid-cols-1 md:grid-cols-12">
          <div class="flex flex-col px-4 pb-12 pt-12 md:col-span-6 md:justify-center md:px-6 md:py-16 lg:py-20">
            <p class={label}>Kotagede, {kedai.kota}</p>
            <h1 class="mt-5 font-display text-6xl leading-[0.92] tracking-tight md:text-7xl lg:text-8xl">{kedai.nama}</h1>
            <p class="mt-6 max-w-md font-display text-xl italic leading-snug text-[#1F3D2B]/85 md:text-2xl [text-wrap:balance]">{kedai.tagline}</p>
            <p class="mt-5 max-w-[46ch] text-[15px] leading-relaxed text-[#1F3D2B]/80 [text-wrap:pretty]">
              Kedai kecil di gang samping Pasar Kotagede. Lauk dimasak pagi-pagi, kopi disangrai teman kami di Sleman.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/menu/" class="inline-flex h-12 items-center justify-center rounded-sm bg-[#1F3D2B] px-6 text-sm font-medium text-[#F6F1E7] transition-colors duration-150 hover:bg-[#2C5A3F]">Lihat menu</a>
              <a href="/reservasi/" class="inline-flex h-12 items-center justify-center rounded-sm border border-[#1F3D2B] px-6 text-sm font-medium transition-colors duration-150 hover:bg-[#1F3D2B] hover:text-[#F6F1E7]">Pesan meja</a>
            </div>
            <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-[#1F3D2B]/15 pt-6">
              {kedai.jam.map((j) => (
                <div>
                  <dt class="text-xs uppercase tracking-widest text-[#1F3D2B]/75">{j.hari}</dt>
                  <dd class="mt-1 font-display text-lg tabular-nums md:text-xl">{j.buka}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="md:col-span-6 md:border-l md:border-[#1F3D2B]/15">
            <img
              src={foto.hero}
              alt="Ruang dalam kedai dengan meja kayu dan jendela besar"
              width="1400" height="1600" fetchpriority="high"
              class="aspect-[4/3] w-full object-cover md:aspect-auto md:h-full"
            />
          </div>
        </div>
      </section>

      <!-- Dari dapur kami -->
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
          <div class="md:col-span-5">
            <p class={label}>Dari dapur kami</p>
            <h2 class="mt-4 font-display text-3xl leading-tight md:text-4xl [text-wrap:balance]">Masakan yang sama seperti di rumah, kalau rumah Anda punya dapur yang rajin.</h2>
            <p class="mt-6 max-w-prose text-[15px] leading-relaxed text-[#1F3D2B]/80 md:text-base [text-wrap:pretty]">{kedai.deskripsi}</p>
            <p class="mt-4 max-w-prose text-[15px] leading-relaxed text-[#1F3D2B]/80 md:text-base [text-wrap:pretty]">
              Lauk berganti setiap hari tergantung apa yang bagus di pasar. Yang selalu ada: pecel, ayam goreng lengkuas, dan mendoan. Sisanya tanya saja, kami senang kalau ditanya.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4 md:col-span-6 md:col-start-7 md:gap-6">
            <figure>
              <img src={foto.dapur1} alt="Nasi goreng kampung di piring putih" width="800" height="1067" loading="lazy" decoding="async" class="aspect-[3/4] w-full rounded-sm object-cover" />
              <figcaption class="mt-2 font-display text-sm italic text-[#1F3D2B]/80">Nasi goreng kampung</figcaption>
            </figure>
            <figure class="mt-12">
              <img src={foto.dapur2} alt="Semangkuk mie kuah dengan jeruk nipis dan sambal" width="800" height="1067" loading="lazy" decoding="async" class="aspect-[3/4] w-full rounded-sm object-cover" />
              <figcaption class="mt-2 font-display text-sm italic text-[#1F3D2B]/80">Mie kuah, khusus Sabtu</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- Menu favorit: dua kolom di desktop agar tidak menyisakan ruang kosong -->
      <section class="border-y border-[#1F3D2B]/15 bg-[#EFE8D9]">
        <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class={label}>Paling sering dipesan</p>
              <h2 class="mt-3 font-display text-3xl md:text-4xl">{angka} favorit</h2>
            </div>
            <a href="/menu/" class="inline-flex min-h-[44px] items-center text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#A8432D]">Menu lengkap →</a>
          </div>
          <div class="mt-8 grid grid-cols-1 gap-x-16 border-t border-[#1F3D2B]/20 md:grid-cols-2">
            <DaftarMenu item={favorit.slice(0, separuh)} tandai={false} />
            <div class="border-t border-[#1F3D2B]/10 md:border-t-0">
              <DaftarMenu item={favorit.slice(separuh)} tandai={false} />
            </div>
          </div>
        </div>
      </section>

      <!-- Jam & lokasi -->
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <div class="md:col-span-4">
            <p class={label}>Datang</p>
            <h2 class="mt-3 font-display text-3xl md:text-4xl">Jam &amp; lokasi</h2>
            <a href="/reservasi/" class="mt-6 inline-flex h-12 items-center justify-center rounded-sm bg-[#1F3D2B] px-6 text-sm font-medium text-[#F6F1E7] transition-colors duration-150 hover:bg-[#2C5A3F]">Pesan meja</a>
          </div>
          <dl class="divide-y divide-[#1F3D2B]/15 border-y border-[#1F3D2B]/15 md:col-span-8">
            {kedai.jam.map((j) => (
              <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
                <dt class="text-sm text-[#1F3D2B]/75">{j.hari}</dt>
                <dd class="font-display text-xl tabular-nums sm:col-span-2">{j.buka}</dd>
              </div>
            ))}
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
              <dt class="text-sm text-[#1F3D2B]/75">Alamat</dt>
              <dd class="sm:col-span-2">
                <p class="font-display text-xl">{kedai.alamat}</p>
                <a href={kedai.maps} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#A8432D]">Petunjuk arah</a>
              </dd>
            </div>
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3">
              <dt class="text-sm text-[#1F3D2B]/75">Catatan</dt>
              <dd class="text-sm leading-relaxed sm:col-span-2">{kedai.catatanJam}</dd>
            </div>
          </dl>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
