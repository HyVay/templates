---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { usaha, layanan } from '../data/site';

const tahapan = [
  { no: '01', judul: 'Survei lokasi', isi: 'Pengukuran dan pendataan kondisi bangunan, gratis di area Jabodetabek.' },
  { no: '02', judul: 'RAB & gambar kerja', isi: 'Rincian biaya per item pekerjaan dan gambar yang bisa Anda revisi.' },
  { no: '03', judul: 'Pengerjaan', isi: 'Laporan foto harian lewat WhatsApp, pembayaran mengikuti termin progres.' },
  { no: '04', judul: 'Serah terima', isi: 'Pemeriksaan bersama, perbaikan minor, lalu garansi 1 tahun berjalan.' },
];
---
<Base
  title={`Layanan — ${usaha.nama}`}
  description={`Renovasi, interior, dan bangun baru oleh ${usaha.nama}. Harga transparan dengan RAB rinci dan garansi 1 tahun.`}
>
  <Header />
  <main>
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <h1 class="text-3xl font-semibold text-slate-900 md:text-4xl">Layanan</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 md:text-base">
          Harga di bawah adalah kisaran awal. Angka final mengikuti kondisi bangunan dan material pilihan Anda.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {layanan.map((l) => (
          <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-medium text-slate-900">{l.nama}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{l.ringkas}</p>
            <p class="mt-5 text-sm font-medium text-teal-700">{l.mulai}</p>
            <a
              href="/kontak/"
              class="mt-4 inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-800 transition-colors duration-150 hover:bg-slate-50"
            >
              Tanya layanan ini
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <h2 class="text-2xl font-semibold text-slate-900 md:text-3xl">Cara kerja</h2>
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {tahapan.map((t) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-sm font-semibold text-teal-700">{t.no}</p>
              <h3 class="mt-2 text-base font-medium text-slate-900">{t.judul}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{t.isi}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
