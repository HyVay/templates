---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JudulHalaman from '../components/JudulHalaman.astro';
import { usaha, layanan, tahapan } from '../data/site';
---
<Base
  title={`Layanan — ${usaha.nama}`}
  description={`Renovasi, interior, dan bangun baru oleh ${usaha.nama}. Harga transparan dengan RAB rinci dan garansi 1 tahun.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <JudulHalaman label="Layanan" judul="Apa yang kami kerjakan, dan berapa kisarannya." ringkas="Harga di bawah adalah kisaran awal. Angka final mengikuti kondisi bangunan dan material pilihan Anda, tertulis di RAB." />

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="divide-y divide-[#CFCAC0] border-y border-[#1C1B19]">
        {layanan.map((l, i) => (
          <article class="grid grid-cols-1 gap-6 py-10 md:grid-cols-12 md:gap-10">
            <div class="md:col-span-5">
              <p class="font-mono text-xs text-[#5B5850]">{String(i + 1).padStart(2, '0')} / {String(layanan.length).padStart(2, '0')}</p>
              <h2 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{l.nama}</h2>
              <p class="mt-3 max-w-[44ch] leading-relaxed text-[#45423C]">{l.ringkas}</p>
            </div>
            <div class="md:col-span-4">
              <p class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Termasuk</p>
              <ul class="mt-3 space-y-2">
                {l.termasuk.map((t) => (
                  <li class="flex gap-3 text-[#2E2C28]"><span aria-hidden="true" class="mt-2.5 h-px w-3 shrink-0 bg-[#1D4E89]"></span>{t}</li>
                ))}
              </ul>
            </div>
            <div class="flex flex-col gap-4 md:col-span-3 md:items-end md:text-right">
              <dl class="space-y-3">
                <div><dt class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Kisaran</dt><dd class="mt-1 font-mono text-lg font-medium tabular-nums text-[#1D4E89]">{l.mulai}</dd></div>
                <div><dt class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Durasi umum</dt><dd class="mt-1 font-mono tabular-nums">{l.durasi}</dd></div>
              </dl>
              <a href={`/kontak/?layanan=${encodeURIComponent(l.nama)}`} class="inline-flex h-11 items-center justify-center border border-[#1C1B19] px-5 text-sm font-medium transition-colors duration-150 hover:bg-[#1C1B19] hover:text-white">Tanya layanan ini</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-[#CFCAC0] bg-[#F6F4EF]">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <p class="font-mono text-xs uppercase tracking-widest text-[#1D4E89]">Cara kerja</p>
        <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight md:text-4xl">Dari survei sampai serah terima, empat tahap.</h2>
        <ol class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {tahapan.map((t, i) => (
            <li class="border-t-2 border-[#1C1B19] pt-4">
              <div class="flex items-baseline justify-between">
                <span class="font-display text-3xl font-bold text-[#1D4E89]">{i + 1}</span>
                <span class="font-mono text-xs text-[#5B5850]">{t.waktu}</span>
              </div>
              <h3 class="mt-3 text-lg font-semibold">{t.judul}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[#45423C]">{t.isi}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
  <Footer />
</Base>
