---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JudulHalaman from '../components/JudulHalaman.astro';
import { usaha, keunggulan, angka, tim, foto } from '../data/site';
---
<Base
  title={`Tentang — ${usaha.nama}`}
  description={`Profil ${usaha.nama}: tim, cara kerja, dan komitmen kami pada harga yang transparan.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <JudulHalaman label="Tentang" judul={`Dibangun dari pekerjaan kecil, sejak ${usaha.sejak}.`} ringkas={`${usaha.bidang} di ${usaha.wilayah}. Satu pengawas per proyek, tukang karyawan sendiri, dan RAB yang tertulis sebelum pekerjaan dimulai.`} />

    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:gap-12 md:px-6 md:py-24">
      <figure class="md:col-span-7">
        <img src={foto.tentang} alt="Tim pengawas meninjau lokasi pengecoran dari atas" width="1200" height="900" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
        <figcaption class="mt-3 font-mono text-xs text-[#5B5850]">Pengecoran pelat lantai, proyek ruang usaha di Cibubur.</figcaption>
      </figure>
      <div class="md:col-span-5">
        <p class="text-lg leading-relaxed">Kami mulai dengan satu tim tukang dan pekerjaan dapur rumah tinggal. Pola kerjanya tidak berubah sejak itu: ukur dulu, hitung terbuka, kerjakan dengan orang yang sama.</p>
        <p class="mt-4 leading-relaxed text-[#45423C]">Sekarang tim kami menangani renovasi menyeluruh dan pembangunan ruang usaha, tetapi setiap proyek tetap dipegang satu pengawas yang bisa Anda hubungi langsung.</p>
        <dl class="mt-10 divide-y divide-[#CFCAC0] border-y border-[#1C1B19]">
          {angka.map((a) => (
            <div class="flex items-baseline justify-between py-4">
              <dt class="text-[#45423C]">{a.label}</dt>
              <dd class="font-display text-3xl font-bold tabular-nums">{a.nilai}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="border-y border-[#CFCAC0] bg-[#F6F4EF]">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <p class="font-mono text-xs uppercase tracking-widest text-[#1D4E89]">Tim inti</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">Orang yang akan Anda temui.</h2>
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 md:gap-x-6">
          {tim.map((t) => (
            <li>
              <img src={t.foto} alt={`Potret ${t.nama}`} width="600" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover grayscale" />
              <p class="mt-3 font-display text-lg font-bold tracking-tight">{t.nama}</p>
              <p class="text-sm text-[#45423C]">{t.peran}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:gap-12 md:px-6 md:py-24">
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-widest text-[#1D4E89]">Yang kami pegang</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">Tertulis di kontrak, bukan di brosur.</h2>
      </div>
      <dl class="divide-y divide-[#CFCAC0] border-y border-[#CFCAC0] md:col-span-8">
        {keunggulan.map((k) => (
          <div class="grid grid-cols-1 gap-2 py-6 sm:grid-cols-12 sm:gap-6">
            <dt class="font-display text-xl font-bold tracking-tight sm:col-span-4">{k.judul}</dt>
            <dd class="leading-relaxed text-[#45423C] sm:col-span-8">{k.isi}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
  <Footer />
</Base>
