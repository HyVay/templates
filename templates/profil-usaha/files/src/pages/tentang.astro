---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { usaha, keunggulan } from '../data/site';

const angka = [
  { nilai: '11', label: 'Tahun beroperasi' },
  { nilai: '240+', label: 'Proyek selesai' },
  { nilai: '18', label: 'Tim tetap' },
];

const tim = [
  { nama: 'Bayu Setiawan', peran: 'Pendiri & Site Manager', foto: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&q=80' },
  { nama: 'Rina Halim', peran: 'Desainer Interior', foto: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=600&q=80' },
  { nama: 'Dimas Prakoso', peran: 'Estimator', foto: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=600&q=80' },
];
---
<Base
  title={`Tentang — ${usaha.nama}`}
  description={`Profil ${usaha.nama}: tim, cara kerja, dan komitmen kami pada harga yang transparan.`}
>
  <Header />
  <main>
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <h1 class="text-3xl font-semibold text-slate-900 md:text-4xl">Tentang kami</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 md:text-base">{usaha.deskripsi}</p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2">
        <img
          src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1000&q=80"
          alt="Tim sedang mengerjakan renovasi interior"
          loading="lazy"
          class="h-auto max-w-full rounded-2xl object-cover"
        />
        <div>
          <h2 class="text-2xl font-semibold text-slate-900 md:text-3xl">Dibangun dari pekerjaan kecil</h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
            Kami mulai pada 2014 dengan satu tim tukang dan pekerjaan dapur rumah tinggal. Pola kerjanya tidak
            berubah sejak itu: ukur dulu, hitung terbuka, kerjakan dengan orang yang sama.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
            Sekarang tim kami menangani renovasi menyeluruh dan pembangunan ruang usaha, tetapi setiap proyek tetap
            dipegang satu pengawas yang bisa Anda hubungi langsung.
          </p>
          <dl class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {angka.map((a) => (
              <div>
                <dt class="text-2xl font-semibold tabular-nums text-teal-700">{a.nilai}</dt>
                <dd class="mt-0.5 text-sm text-slate-600">{a.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <h2 class="text-2xl font-semibold text-slate-900 md:text-3xl">Tim</h2>
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {tim.map((t) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
              <img
                src={t.foto}
                alt={`Foto ${t.nama}`}
                loading="lazy"
                class="mx-auto h-24 w-24 rounded-full object-cover"
              />
              <p class="mt-4 text-base font-medium text-slate-900">{t.nama}</p>
              <p class="text-sm text-slate-600">{t.peran}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <h2 class="text-2xl font-semibold text-slate-900 md:text-3xl">Yang kami pegang</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        {keunggulan.map((k) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-base font-medium text-slate-900">{k.judul}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{k.isi}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
