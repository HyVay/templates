---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JudulHalaman from '../components/JudulHalaman.astro';
import { usaha, layanan } from '../data/site';

const input = 'mt-2 block h-12 w-full border border-[#A8A398] bg-white px-3 text-base outline-none transition-colors duration-150 placeholder:text-[#8A857B] focus:border-[#1D4E89]';
const label = 'block text-sm font-medium';
---
<Base
  title={`Kontak — ${usaha.nama}`}
  description={`Hubungi ${usaha.nama} di ${usaha.alamat}. Kirim kebutuhan Anda lewat WhatsApp dan dapatkan estimasi biaya.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <JudulHalaman label="Kontak" judul="Ceritakan pekerjaannya, kami balas dengan estimasi." ringkas="Isi formulir, pesan terbuka di WhatsApp kami lengkap dengan detail yang Anda tulis. Biasanya dibalas di hari yang sama pada jam kerja." />

    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
      <div class="md:col-span-7">
        <form id="kontak-form" class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="nama" class={label}>Nama</label>
            <input id="nama" name="nama" required autocomplete="name" class={input} />
          </div>
          <div>
            <label for="layanan" class={label}>Kebutuhan</label>
            <select id="layanan" name="layanan" class={input}>
              {layanan.map((l) => <option value={l.nama}>{l.nama}</option>)}
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="lokasi" class={label}>Lokasi proyek <span class="font-normal text-[#5B5850]">(kecamatan / kota)</span></label>
            <input id="lokasi" name="lokasi" autocomplete="address-level2" placeholder="Contoh: Cilandak, Jakarta Selatan" class={input} />
          </div>
          <div class="sm:col-span-2">
            <label for="pesan" class={label}>Detail pekerjaan</label>
            <textarea id="pesan" name="pesan" rows="5" required placeholder="Perkiraan luas, kondisi saat ini, target selesai" class={`${input} h-auto py-3`}></textarea>
          </div>
          <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:items-center">
            <button type="submit" class="inline-flex h-12 items-center justify-center bg-[#1D4E89] px-6 text-sm font-medium text-white transition-colors duration-150 hover:bg-[#163D6C]">Kirim via WhatsApp</button>
            <p class="text-sm text-[#5B5850]">Situs ini tidak menyimpan data. Pesan dikirim sebagai chat WhatsApp.</p>
          </div>
          <p id="status" role="status" aria-live="polite" class="text-sm text-[#1D4E89] sm:col-span-2"></p>
        </form>
      </div>

      <aside class="md:col-span-5">
        <dl class="divide-y divide-[#CFCAC0] border-y border-[#1C1B19]">
          <div class="py-5"><dt class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Kantor</dt><dd class="mt-1.5">{usaha.alamat}</dd><dd><a href={usaha.maps} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex min-h-11 items-center text-sm font-medium text-[#1D4E89] underline underline-offset-4">Buka di Google Maps</a></dd></div>
          <div class="py-5"><dt class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Jam kantor</dt><dd class="mt-1.5 tabular-nums">{usaha.jam}</dd></div>
          <div class="py-5"><dt class="font-mono text-xs uppercase tracking-widest text-[#5B5850]">Email</dt><dd><a href={`mailto:${usaha.email}`} class="inline-flex min-h-11 items-center underline underline-offset-4">{usaha.email}</a></dd></div>
        </dl>
        <a href={`https://wa.me/${usaha.telepon}`} target="_blank" rel="noopener noreferrer" class="mt-6 flex h-14 items-center justify-between bg-[#1C1B19] px-5 text-sm font-medium text-white transition-colors duration-150 hover:bg-[#1D4E89]">
          <span>Chat langsung</span><span class="font-mono tabular-nums">+{usaha.telepon}</span>
        </a>
      </aside>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: usaha.telepon }}>
    const form = document.getElementById('kontak-form');
    const pilih = new URLSearchParams(location.search).get('layanan');
    if (pilih) { const s = document.getElementById('layanan'); if ([...s.options].some((o) => o.value === pilih)) s.value = pilih; }
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo, saya ${d.get('nama')}.`,
        `Kebutuhan: ${d.get('layanan')}`,
        `Lokasi: ${d.get('lokasi') || '-'}`,
        `Detail: ${d.get('pesan')}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
      document.getElementById('status').textContent = 'WhatsApp dibuka di tab baru. Kalau tidak muncul, izinkan pop-up lalu kirim lagi.';
    });
  </script>
</Base>
