---
interface Props { label: string; judul: string; ringkas?: string }
const { label, judul, ringkas } = Astro.props;
---
<section class="kisi border-b border-[#CFCAC0]">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 py-14 md:grid-cols-12 md:items-end md:px-6 md:py-20">
    <div class="md:col-span-7">
      <p class="font-mono text-xs uppercase tracking-widest text-[#1D4E89]">{label}</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-6xl">{judul}</h1>
    </div>
    {ringkas && <p class="max-w-[48ch] leading-relaxed text-[#45423C] md:col-span-5">{ringkas}</p>}
  </div>
</section>
