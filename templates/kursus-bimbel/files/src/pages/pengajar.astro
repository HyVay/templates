---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lembaga, pengajar } from '../data/bimbel';
---
<Base
  title={`Pengajar — ${lembaga.nama}`}
  description={`${pengajar.length} pengajar tetap ${lembaga.nama}: mata pelajaran, latar pendidikan, dan sejak kapan mengajar.`}
>
  <Fonts />
  <Header />
  <main class="text-[#14213D]">
    <section class="border-b border-[#14213D]/15">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-[#14213D]/60">Pengajar</p>
        <h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">Pengajar tetap, bukan pengajar lepas.</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#14213D]/70 md:text-base">
          Semua pengajar di sini mengajar penuh waktu. Siswa bertemu orang yang sama sepanjang semester, jadi pengajar tahu persis siapa yang tertinggal di bab mana.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
      <ul class="divide-y divide-[#14213D]/10">
        {pengajar.map((g, i) => (
          <li class="grid grid-cols-1 gap-6 py-10 md:grid-cols-12 md:gap-8">
            <div class="md:col-span-3">
              <img src={g.foto} alt={g.nama} loading="lazy" class="aspect-square w-full max-w-xs rounded-lg object-cover grayscale" />
            </div>
            <div class="md:col-span-8 md:col-start-5">
              <p class="font-mono text-sm text-[#FCA311]">0{i + 1}</p>
              <h2 class="font-display mt-2 text-2xl font-extrabold tracking-tight md:text-3xl">{g.nama}</h2>
              <p class="mt-1 text-sm font-semibold text-[#14213D]/70">{g.mapel}</p>
              <p class="mt-4 max-w-xl text-sm leading-relaxed text-[#14213D]/75 md:text-base">{g.latar}</p>
              <p class="mt-4 font-mono text-xs uppercase tracking-widest text-[#14213D]/50">Mengajar di sini sejak {g.sejak}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Base>
