---
import { lembaga } from '../data/bimbel';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/program/', label: 'Program' },
  { href: '/pengajar/', label: 'Pengajar' },
  { href: '/daftar/', label: 'Pendaftaran' },
];
const here = Astro.url.pathname;
---
<a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-[#14213D] focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:text-white">Lewati ke konten</a>
<header class="sticky top-0 z-50 border-b border-[#14213D]/15 bg-[#FBFAF7]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 md:h-16 md:px-6">
    <a href="/" class="flex items-center gap-2.5 text-[#14213D]">
      <span class="inline-block h-6 w-6 rounded-lg bg-[#FCA311]" aria-hidden="true"></span>
      <span class="font-display text-lg font-extrabold tracking-tight">{lembaga.nama}</span>
    </a>
    <nav aria-label="Utama" class="hidden md:flex md:items-center md:gap-1 lg:gap-3">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'px-2 py-3 text-sm font-medium transition-colors duration-150 hover:text-[#14213D]',
            here === l.href ? 'text-[#14213D] underline decoration-[#FCA311] decoration-2 underline-offset-8' : 'text-[#14213D]/70',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/daftar/"
        class="ml-2 rounded-lg bg-[#14213D] px-4 py-2.5 text-sm font-bold text-white transition-colors duration-150 hover:bg-[#1f2f55]"
      >
        Daftar sekarang
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-[#14213D] transition-colors duration-150 hover:bg-[#14213D]/5 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#14213D]/15 bg-[#FBFAF7] md:hidden">
    <nav aria-label="Utama" class="mx-auto flex max-w-6xl flex-col px-4 pb-4 pt-2">
      {links.map((l) => (
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="block rounded-lg px-2 py-3 text-base font-medium text-[#14213D] transition-colors duration-150 hover:bg-[#14213D]/5 aria-[current=page]:bg-[#FCA311]/15">
          {l.label}
        </a>
      ))}
      <a href="/daftar/" class="mt-3 rounded-lg bg-[#FCA311] px-4 py-3.5 text-center text-sm font-bold text-[#14213D]">Daftar sekarang</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    btn?.setAttribute('aria-label', isOpen ? 'Tutup menu' : 'Buka menu');
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
  });
</script>
