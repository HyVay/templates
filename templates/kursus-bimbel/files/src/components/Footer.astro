---
import { lembaga, pendaftaran } from '../data/bimbel';
---
<footer class="border-t border-[#14213D]/15 bg-[#14213D] text-white">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-2xl font-extrabold tracking-tight">{lembaga.nama}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/70">{lembaga.tagline}. Tahun ajaran {lembaga.tahunAjaran}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-mono text-xs uppercase tracking-widest text-[#FCA311]">Alamat</p>
      <p class="mt-3 text-sm leading-relaxed text-white/85">{lembaga.alamat}</p>
      <p class="mt-2 text-sm text-white/70">{lembaga.jam}</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-mono text-xs uppercase tracking-widest text-[#FCA311]">Hubungi</p>
      <ul class="mt-3 space-y-1.5 text-sm text-white/85">
        <li><a href={`https://wa.me/${lembaga.telepon}`} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:text-[#FCA311]">WhatsApp {lembaga.telepon}</a></li>
        <li><a href={`mailto:${lembaga.email}`} class="transition-colors duration-150 hover:text-[#FCA311]">{lembaga.email}</a></li>
      </ul>
      <p class="mt-5 text-sm text-white/70">{pendaftaran.gelombang} dibuka {pendaftaran.periode}.</p>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-5 text-xs text-white/50 md:px-6">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} {lembaga.nama}</span>
      <span>Kelas kecil, pengajar tetap, laporan bulanan.</span>
    </div>
  </div>
</footer>
