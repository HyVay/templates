---
/**
 * Tabel program: di desktop tabel sungguhan, di HP tiap baris jadi blok bertumpuk.
 * Semua data dari src/data/bimbel.ts.
 */
import { program } from '../data/bimbel';
---
<div class="overflow-hidden rounded-lg border border-[#14213D]/15 bg-white">
  <table class="w-full border-collapse text-left text-sm">
    <thead class="hidden md:table-header-group">
      <tr class="border-b border-[#14213D]/15 bg-[#FBFAF7] font-mono text-xs uppercase tracking-widest text-[#14213D]/60">
        <th scope="col" class="px-5 py-3 font-medium">Program</th>
        <th scope="col" class="px-5 py-3 font-medium">Jenjang</th>
        <th scope="col" class="px-5 py-3 font-medium">Jadwal</th>
        <th scope="col" class="px-5 py-3 text-right font-medium">Biaya</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[#14213D]/10">
      {program.map((p) => (
        <tr class="block p-5 md:table-row md:p-0">
          <td class="block pb-1 md:table-cell md:px-5 md:py-4">
            <a href={`/program/#${p.slug}`} class="font-display text-base font-bold text-[#14213D] transition-colors duration-150 hover:text-[#FCA311] md:text-sm">
              {p.nama}
            </a>
          </td>
          <td class="block text-[#14213D]/70 md:table-cell md:px-5 md:py-4">
            <span class="font-mono text-xs uppercase tracking-widest text-[#14213D]/50 md:hidden">Jenjang · </span>{p.jenjang}
          </td>
          <td class="block text-[#14213D]/70 md:table-cell md:px-5 md:py-4">
            <span class="font-mono text-xs uppercase tracking-widest text-[#14213D]/50 md:hidden">Jadwal · </span>{p.jadwal}
          </td>
          <td class="block pt-2 font-semibold tabular-nums text-[#14213D] md:table-cell md:px-5 md:py-4 md:pt-4 md:text-right">
            {p.biaya}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
