---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap" />
<style is:global>
  body { font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif; background: #ffffff; color: #0b1220; }
  .font-display { font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif; }
  .font-body { font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif; }
</style>
