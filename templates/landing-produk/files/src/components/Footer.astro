---
import { produk } from '../data/produk';
---
<footer class="border-t border-[#0b1220]/10 bg-[#f3f4f2]">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-xl font-extrabold tracking-tight">{produk.nama}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-[#0b1220]/60">{produk.tagline} {produk.versi}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs font-bold uppercase tracking-widest text-[#0b1220]/50">Produk</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a href="/harga/" class="transition-colors duration-150 hover:text-[#ff5a1f]">Harga</a></li>
        <li><a href="/faq/" class="transition-colors duration-150 hover:text-[#ff5a1f]">Pertanyaan umum</a></li>
        <li><a href={produk.playStore} class="transition-colors duration-150 hover:text-[#ff5a1f]">Unduh di Play Store</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="text-xs font-bold uppercase tracking-widest text-[#0b1220]/50">Perusahaan</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>{produk.perusahaan}</li>
        <li class="text-[#0b1220]/60">{produk.alamat}</li>
        <li><a href={`mailto:${produk.email}`} class="transition-colors duration-150 hover:text-[#ff5a1f]">{produk.email}</a></li>
        <li><a href={`https://wa.me/${produk.wa}`} class="transition-colors duration-150 hover:text-[#ff5a1f]">WhatsApp tim penjualan</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[#0b1220]/10 px-4 py-5 md:px-6">
    <p class="mx-auto max-w-6xl text-xs text-[#0b1220]/50">© {new Date().getFullYear()} {produk.perusahaan}</p>
  </div>
</footer>
