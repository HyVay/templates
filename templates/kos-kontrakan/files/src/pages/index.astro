---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarisKamar from '../components/BarisKamar.astro';
import { kos, tipeKamar, fasilitasUmum, fotoLain } from '../data/kos';

const totalKosong = tipeKamar.reduce((n, t) => n + t.sisa, 0);
---
<Base title={`${kos.nama} — ${kos.jenis} di ${kos.kota}`} description={`${kos.tagline} ${kos.deskripsi}`}>
  <Fonts />
  <div class="bg-[#F7F5F0] text-[#1F2A1F]">
    <Header />
    <main>
      <!-- Hero -->
      <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-12 md:grid-cols-12 md:items-center md:px-6 md:py-20">
        <div class="md:col-span-6">
          <p class="font-mono text-xs uppercase tracking-widest text-[#6B7F3A]">{totalKosong} kamar kosong per {kos.pembaruan}</p>
          <h1 class="mt-4 font-display text-4xl font-semibold leading-[1] tracking-tight md:text-6xl">{kos.tagline}</h1>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-[#1F2A1F]/80">{kos.deskripsi}</p>
          <ul class="mt-6 divide-y divide-[#1F2A1F]/10 border-y border-[#1F2A1F]/10">
            {kos.dekat.map((d) => (
              <li class="flex justify-between gap-4 py-2.5 text-sm">
                <span>{d.tempat}</span>
                <span class="shrink-0 text-[#1F2A1F]/60">{d.jarak}</span>
              </li>
            ))}
          </ul>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="/survei/" class="inline-flex h-12 items-center justify-center rounded-lg bg-[#1F2A1F] px-6 text-sm font-medium text-[#F7F5F0] transition-colors duration-150 hover:bg-[#6B7F3A]">Jadwalkan survei</a>
            <a href="/kamar/" class="inline-flex h-12 items-center justify-center rounded-lg border border-[#1F2A1F]/25 px-6 text-sm font-medium transition-colors duration-150 hover:border-[#1F2A1F]">Lihat semua kamar</a>
          </div>
        </div>
        <img src={fotoLain.hero} alt={fotoLain.heroAlt} class="aspect-[4/3] w-full rounded-lg object-cover md:col-span-6" />
      </section>

      <!-- Tipe kamar -->
      <section class="border-y border-[#1F2A1F]/10 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
          <div class="flex items-end justify-between gap-6">
            <h2 class="font-display text-3xl font-semibold leading-tight md:text-4xl">Tiga tipe kamar</h2>
            <a href="/kamar/" class="shrink-0 text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#6B7F3A]">Detail & catatan</a>
          </div>
          <div class="mt-4 divide-y divide-[#1F2A1F]/10">
            {tipeKamar.map((t) => <BarisKamar tipe={t} />)}
          </div>
        </div>
      </section>

      <!-- Fasilitas bersama -->
      <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
        <div class="md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-[#6B7F3A]">Fasilitas bersama</p>
          <h2 class="mt-3 font-display text-3xl font-semibold leading-tight md:text-4xl">Yang dipakai bareng, dirawat bareng.</h2>
          <ul class="mt-6 divide-y divide-[#1F2A1F]/10 border-y border-[#1F2A1F]/10 text-sm">
            {fasilitasUmum.slice(0, 5).map((f) => <li class="py-2.5">{f}</li>)}
          </ul>
          <a href="/fasilitas/" class="mt-4 inline-block text-sm underline underline-offset-4 transition-colors duration-150 hover:text-[#6B7F3A]">Semua fasilitas, aturan, dan biaya tambahan</a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:col-span-7">
          <img src={fotoLain.dapur} alt={fotoLain.dapurAlt} loading="lazy" class="aspect-[3/4] w-full rounded-lg object-cover" />
          <img src={fotoLain.ruangTamu} alt={fotoLain.ruangTamuAlt} loading="lazy" class="mt-10 aspect-[3/4] w-full rounded-lg object-cover" />
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
