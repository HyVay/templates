---
import { kos } from '../data/kos';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/kamar/', label: 'Kamar' },
  { href: '/fasilitas/', label: 'Fasilitas & Aturan' },
  { href: '/survei/', label: 'Survei' },
];
const here = Astro.url.pathname;
---
<a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[60] focus:px-4 focus:py-3 focus:text-sm focus:font-medium focus:bg-[#1F2A1F] focus:text-[#F7F5F0]">Lewati ke konten</a>
<header class="sticky top-0 z-50 border-b border-[#1F2A1F]/10 bg-[#F7F5F0]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 md:h-16 md:px-6">
    <a href="/" class="font-display text-lg font-semibold text-[#1F2A1F] md:text-xl">{kos.nama}</a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors duration-150 hover:text-[#6B7F3A]',
            here === l.href ? 'font-medium text-[#55662C]' : 'text-[#1F2A1F]/80',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/survei/" class="inline-flex h-10 items-center whitespace-nowrap rounded-lg bg-[#1F2A1F] px-4 text-sm font-medium text-[#F7F5F0] transition-colors duration-150 hover:bg-[#3F4D20]">
        Jadwalkan survei
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-[#1F2A1F] transition-colors duration-150 hover:bg-[#1F2A1F]/10 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-[#1F2A1F]/10 bg-[#F7F5F0] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="block border-b border-[#1F2A1F]/10 px-2 py-3 text-base text-[#1F2A1F] transition-colors duration-150 hover:text-[#6B7F3A]">
          {l.label}
        </a>
      ))}
      <a href={`https://wa.me/${kos.telepon}`} target="_blank" rel="noopener noreferrer" class="block px-2 py-3 text-base text-[#55662C]">
        WhatsApp {kos.telepon}
      </a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
