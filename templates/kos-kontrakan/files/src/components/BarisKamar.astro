---
/** Satu tipe kamar sebagai baris: foto kiri, detail + fasilitas + harga kanan, tanpa ruang kosong. */
import { rupiah, type TipeKamar } from '../data/kos';

interface Props { tipe: TipeKamar; detail?: boolean }
const { tipe, detail = false } = Astro.props;
const kosong = tipe.sisa > 0;
---
<article id={tipe.slug} class="grid scroll-mt-24 grid-cols-1 gap-6 py-8 md:grid-cols-12 md:items-center md:gap-10 md:py-10">
  <div class="relative md:col-span-5">
    <img src={tipe.foto} alt={tipe.alt} width="1000" height="750" loading="lazy" decoding="async" class:list={['aspect-[4/3] w-full rounded-lg object-cover', !kosong && 'opacity-80 saturate-50']} />
    {kosong ? (
      <span class="absolute left-3 top-3 rounded-lg bg-[#3F4D20] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#F7F5F0]">Sisa {tipe.sisa} kamar</span>
    ) : (
      <span class="absolute left-3 top-3 rounded-lg bg-[#F7F5F0] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#1F2A1F]">Penuh</span>
    )}
  </div>
  <div class="md:col-span-7">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h3 class="font-display text-2xl font-semibold leading-tight md:text-3xl">{tipe.nama}</h3>
      <p class="font-mono text-xs uppercase tracking-wider text-[#1F2A1F]/75">{tipe.ukuran} · {tipe.jumlah} kamar</p>
    </div>
    <ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-2 text-sm text-[#1F2A1F]/85 sm:grid-cols-2">
      {tipe.fasilitas.map((f) => (
        <li class="flex gap-2.5">
          <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-[#6B7F3A]" aria-hidden="true"></span>
          <span>{f}</span>
        </li>
      ))}
    </ul>
    {detail && tipe.catatan && <p class="mt-4 max-w-prose text-sm leading-relaxed text-[#1F2A1F]/80">{tipe.catatan}</p>}
    <div class="mt-6 flex flex-col gap-4 border-t border-[#1F2A1F]/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p>
        <span class="font-display text-3xl font-semibold tabular-nums">{rupiah(tipe.harga)}</span>
        <span class="text-sm text-[#1F2A1F]/75"> / bulan</span>
      </p>
      <a
        href={`/survei/?tipe=${tipe.slug}`}
        class:list={[
          'inline-flex h-12 items-center justify-center rounded-lg px-6 text-sm font-medium transition-colors duration-150',
          kosong ? 'bg-[#1F2A1F] text-[#F7F5F0] hover:bg-[#3F4D20]' : 'border border-[#1F2A1F]/30 text-[#1F2A1F] hover:border-[#1F2A1F] hover:bg-[#1F2A1F]/5',
        ]}
      >
        {kosong ? 'Jadwalkan survei' : 'Masuk daftar tunggu'}
      </a>
    </div>
  </div>
</article>
