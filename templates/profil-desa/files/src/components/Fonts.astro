---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Spectral', Georgia, serif; }
  .font-body { font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif; }
</style>
