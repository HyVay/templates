---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Spectral', Georgia, serif; }
  .font-body { font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif; }
  h1, h2, h3 { text-wrap: balance; }
  p, li, dd { text-wrap: pretty; }
  /* Fokus keyboard: hijau lumut di latar terang, krem di latar gelap (.on-dark). */
  :focus-visible { outline: 2px solid #2F4A2A; outline-offset: 3px; }
  .on-dark :focus-visible { outline-color: #EEF2E6; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
