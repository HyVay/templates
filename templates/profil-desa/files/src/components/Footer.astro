---
import { desa, dusun } from '../data/desa';
---
<footer class="border-t border-[#2F4A2A]/15 bg-[#2F4A2A] text-[#EEF2E6]">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-3xl font-semibold">{desa.nama}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-widest text-[#EEF2E6]/60">{desa.kecamatan} · {desa.kabupaten}</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[#EEF2E6]/75">{desa.tagline}</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs uppercase tracking-widest text-[#EEF2E6]/60">Dusun</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {dusun.map((d) => <li>{d.nama} <span class="text-[#EEF2E6]/50">· {d.kk} KK</span></li>)}
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="text-xs uppercase tracking-widest text-[#EEF2E6]/60">Kantor desa</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>{desa.alamatKantor}</li>
        <li class="text-[#EEF2E6]/75">{desa.jamKantor}</li>
        <li><a href={desa.maps} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#B86B2C]">Buka di Google Maps</a></li>
        <li><a href={`https://wa.me/${desa.telepon}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#B86B2C]">WhatsApp {desa.telepon}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[#EEF2E6]/15 px-4 py-5 text-xs text-[#EEF2E6]/60 md:px-6">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} Pemerintah {desa.nama}.</span>
      <span class="font-mono">Kode desa {desa.kodeDesa}</span>
    </div>
  </div>
</footer>
