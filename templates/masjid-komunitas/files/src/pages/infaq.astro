---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { masjid, infaq, foto } from '../data/masjid';
---
<Base
  title={`Infaq — ${masjid.nama} ${masjid.lokasiSingkat}`}
  description={`Salurkan infaq ke rekening ${infaq.atasNama}. Dana dipakai untuk operasional, TPA, santunan, dan pemeliharaan masjid, dilaporkan setiap bulan.`}
>
  <Fonts />
  <Header />
  <main id="konten" class="bg-[#F7F3EA] text-[#0F3D2E]">
    <section class="border-b border-[#0F3D2E]/15">
      <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#8A6A1C]">Infaq &amp; sedekah</p>
        <h1 class="font-display mt-2 text-4xl font-bold leading-tight md:text-6xl">Transfer, lalu konfirmasi</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#0F3D2E]/75 md:text-lg">
          Rekening atas nama masjid, bukan perorangan. Laporan pemasukan dan pengeluaran ditempel di papan pengumuman setiap awal bulan dan bisa diminta ke bendahara.
        </p>
      </div>
    </section>

    <section class="border-b border-[#0F3D2E]/15">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-5 py-14 md:grid-cols-12 md:px-8 md:py-20">
        <!-- Rekening -->
        <div class="md:col-span-5">
          <div class="on-dark rounded-sm bg-[#0F3D2E] p-6 text-[#F7F3EA] md:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#D4AF55]">Rekening infaq</p>
            <p class="font-display mt-3 text-2xl font-bold">{infaq.bank}</p>
            <p id="nomor-rekening" class="font-display mt-4 text-4xl font-bold tabular-nums tracking-wide md:text-5xl">{infaq.nomor}</p>
            <p class="mt-2 text-sm text-[#F7F3EA]/75">a.n. {infaq.atasNama}</p>
            <button
              id="salin"
              type="button"
              data-nomor={infaq.nomor}
              class="mt-6 inline-flex h-11 items-center gap-2 rounded-sm bg-[#B8912E] px-5 text-sm font-semibold uppercase tracking-wider text-[#0F3D2E] transition-colors duration-150 hover:bg-[#d1a63a]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="1" />
                <path d="M5 15V5a1 1 0 011-1h10" stroke-linecap="round" />
              </svg>
              <span id="salin-label" aria-live="polite">Salin nomor rekening</span>
            </button>
          </div>
          <img src={foto.infaq} alt="Mushaf Al-Quran di atas meja" width="900" height="675" loading="lazy" decoding="async" class="mt-5 hidden aspect-[4/3] w-full md:block rounded-sm object-cover" />
        </div>

        <!-- Penggunaan -->
        <div class="md:col-span-7 md:pl-6">
          <h2 class="font-display text-3xl font-bold">Ke mana dana disalurkan</h2>
          <ul class="mt-6 divide-y divide-[#0F3D2E]/15 border-y border-[#0F3D2E]/15">
            {infaq.penggunaan.map((p) => (
              <li class="flex items-baseline gap-5 py-5">
                <span class="font-display w-16 shrink-0 text-3xl font-bold tabular-nums text-[#8A6A1C] md:w-24">{p.porsi}</span>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold">{p.pos}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[#0F3D2E]/80">{p.isi}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-[#0F3D2E]/80">
            Porsi di atas adalah pedoman takmir; infaq dengan peruntukan khusus (mis. kurban, renovasi) dicatat terpisah sesuai niat pemberi.
          </p>
        </div>
      </div>
    </section>

    <!-- Konfirmasi -->
    <section>
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-5 py-14 md:grid-cols-12 md:px-8 md:py-20">
        <div class="md:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#8A6A1C]">Konfirmasi transfer</p>
          <h2 class="font-display mt-2 text-3xl font-bold leading-tight">Agar bendahara bisa mencatat atas nama Anda</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#0F3D2E]/80">
            Isi seperlunya. Boleh dikosongkan namanya jika ingin menjadi hamba Allah. Pesan terbuka di WhatsApp bendahara.
          </p>
        </div>
        <form id="form-infaq" class="space-y-4 md:col-span-7">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="nama" class="block text-sm font-semibold">Nama (opsional)</label>
              <input id="nama" name="nama" autocomplete="name" placeholder="Hamba Allah"
                class="mt-1 h-11 w-full rounded-sm border border-[#0F3D2E]/25 bg-white px-3 text-sm outline-none transition-colors duration-150 focus:border-[#0F3D2E]" />
            </div>
            <div>
              <label for="nominal" class="block text-sm font-semibold">Nominal (Rp)</label>
              <input id="nominal" name="nominal" type="number" inputmode="numeric" min="1000" step="1000" required placeholder="100000"
                class="mt-1 h-11 w-full rounded-sm border border-[#0F3D2E]/25 bg-white px-3 text-sm outline-none transition-colors duration-150 focus:border-[#0F3D2E]" />
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="tanggal" class="block text-sm font-semibold">Tanggal transfer</label>
              <input id="tanggal" name="tanggal" type="date" required
                class="mt-1 h-11 w-full rounded-sm border border-[#0F3D2E]/25 bg-white px-3 text-sm outline-none transition-colors duration-150 focus:border-[#0F3D2E]" />
            </div>
            <div>
              <label for="peruntukan" class="block text-sm font-semibold">Peruntukan</label>
              <select id="peruntukan" name="peruntukan"
                class="mt-1 h-11 w-full rounded-sm border border-[#0F3D2E]/25 bg-white px-3 text-sm outline-none transition-colors duration-150 focus:border-[#0F3D2E]">
                <option>Infaq umum</option>
                {infaq.penggunaan.map((p) => <option>{p.pos}</option>)}
                <option>Lainnya (tulis di catatan)</option>
              </select>
            </div>
          </div>
          <div>
            <label for="catatan" class="block text-sm font-semibold">Catatan</label>
            <textarea id="catatan" name="catatan" rows="3" placeholder="Misalnya: infaq atas nama almarhum orang tua"
              class="mt-1 w-full rounded-sm border border-[#0F3D2E]/25 bg-white px-3 py-2.5 text-sm outline-none transition-colors duration-150 focus:border-[#0F3D2E]"></textarea>
          </div>
          <button type="submit"
            class="inline-flex h-12 w-full items-center justify-center rounded-sm bg-[#0F3D2E] px-6 text-sm font-semibold uppercase tracking-wider text-[#F7F3EA] transition-colors duration-150 hover:bg-[#0b2e22] sm:w-auto">
            Kirim konfirmasi via WhatsApp
          </button>
          <p id="status-infaq" role="status" aria-live="polite" class="hidden rounded-sm border-l-2 border-[#B8912E] bg-[#0F3D2E]/5 px-4 py-3 text-sm text-[#0F3D2E]"></p>
          <p class="text-xs text-[#0F3D2E]/75">
            Situs ini statis tanpa basis data; tidak ada pembayaran yang diproses di sini. Konfirmasi dikirim sebagai chat WhatsApp ke bendahara.
          </p>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: masjid.wa }}>
    const salin = document.getElementById('salin');
    const label = document.getElementById('salin-label');
    salin?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(salin.dataset.nomor || '');
        if (label) label.textContent = 'Nomor tersalin';
      } catch {
        if (label) label.textContent = 'Salin manual';
      }
      setTimeout(() => { if (label) label.textContent = 'Salin nomor rekening'; }, 2000);
    });

    const form = document.getElementById('form-infaq');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const nominal = Number(d.get('nominal') || 0).toLocaleString('id-ID');
      const text = [
        'Assalamu’alaikum, konfirmasi infaq:',
        `Nama: ${d.get('nama') || 'Hamba Allah'}`,
        `Nominal: Rp ${nominal}`,
        `Tanggal transfer: ${d.get('tanggal')}`,
        `Peruntukan: ${d.get('peruntukan')}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
      const status = document.getElementById('status-infaq');
      if (status) { status.textContent = 'WhatsApp dibuka di tab baru. Periksa pesannya, lalu tekan kirim.'; status.classList.remove('hidden'); }
    });
  </script>
</Base>
