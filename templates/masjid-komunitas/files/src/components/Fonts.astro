---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600;700&display=swap"
/>
<style is:global>
  body { font-family: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Amiri', Georgia, serif; }
  .font-body { font-family: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif; }
  h1, h2, h3 { text-wrap: balance; }
  p, li, dd { text-wrap: pretty; }
  /* Fokus keyboard: tinta hijau di latar terang, emas muda di latar gelap (.on-dark). */
  :focus-visible { outline: 2px solid #0F3D2E; outline-offset: 3px; }
  .on-dark :focus-visible { outline-color: #E3C26A; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
