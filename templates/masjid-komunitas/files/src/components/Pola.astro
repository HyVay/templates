---
/** Pola geometris islami (bintang delapan) untuk latar. Letakkan di induk `relative overflow-hidden`. */
interface Props { warna?: string; opasitas?: number }
const { warna = '#B8912E', opasitas = 0.18 } = Astro.props;
---
<div class="absolute inset-0 z-0 pointer-events-none">
  <svg class="h-full w-full" aria-hidden="true">
    <defs>
      <pattern id="pola-geometris" width="96" height="96" patternUnits="userSpaceOnUse">
        <g fill="none" stroke={warna} stroke-width="1" opacity={opasitas}>
          <path d="M48 4 L60 36 L92 48 L60 60 L48 92 L36 60 L4 48 L36 36 Z" />
          <path d="M48 20 L68 28 L76 48 L68 68 L48 76 L28 68 L20 48 L28 28 Z" />
          <circle cx="48" cy="48" r="8" />
          <path d="M0 0 L16 16 M96 0 L80 16 M0 96 L16 80 M96 96 L80 80" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#pola-geometris)" />
  </svg>
</div>
