---
import { rupiah, toko, type Produk } from '../data/toko';

interface Props { item: Produk; eager?: boolean }
const { item, eager = false } = Astro.props;

const pesan = `Halo ${toko.nama}, saya mau pesan ${item.nama} (${item.satuan}).`;
const kabari = `Halo ${toko.nama}, tolong kabari saya kalau ${item.nama} sudah tersedia lagi.`;
const wa = (t: string) => `https://wa.me/${toko.telepon}?text=${encodeURIComponent(t)}`;
const level = item.sangrai ?? 0;
---
<article data-kategori={item.kategori} class="flex flex-col border border-[#231A13] bg-[#F8F4EC]">
  <div class="relative border-b border-[#231A13]">
    <img src={item.foto} alt={item.nama} width="800" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async"
      class:list={['aspect-square w-full object-cover', !item.stok && 'opacity-60 grayscale']} />
    <span class="absolute left-0 top-0 bg-[#231A13] px-2.5 py-1 font-mono text-xs uppercase tracking-wider text-[#EFE7DA]">{item.kategori}</span>
    {!item.stok && (
      <span class="absolute bottom-0 right-0 bg-[#2340A8] px-2.5 py-1 font-mono text-xs uppercase tracking-wider text-white">Habis</span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    {item.asal && <p class="font-mono text-xs text-[#6B5D4F]">{item.asal} · {item.proses}</p>}
    <h3 class="mt-1 font-display text-2xl leading-tight">{item.nama}</h3>
    {item.catatan ? (
      <p class="mt-2 text-sm text-[#4A3D31]"><span class="sr-only">Catatan rasa: </span>{item.catatan.join(' · ')}</p>
    ) : (
      <p class="mt-2 text-sm leading-relaxed text-[#4A3D31]">{item.ringkas}</p>
    )}
    {level > 0 && (
      <div class="mt-4 flex items-center gap-3">
        <span class="font-mono text-xs text-[#6B5D4F]">Sangrai</span>
        <span class="flex flex-1 gap-1" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => <span class:list={['h-1.5 flex-1', n <= level ? 'bg-[#231A13]' : 'bg-[#D9CDB9]']}></span>)}
        </span>
        <span class="sr-only">Tingkat sangrai {level} dari 5</span>
        <span class="font-mono text-xs text-[#6B5D4F]" aria-hidden="true">{['', 'terang', 'medium-terang', 'medium', 'medium-gelap', 'gelap'][level]}</span>
      </div>
    )}
    <div aria-hidden="true" class="h-5"></div>
    <div class="mt-auto flex items-baseline justify-between border-t border-dashed border-[#B9AA92] pt-4">
      <p class="text-lg font-semibold tabular-nums">{rupiah(item.harga)}</p>
      <p class="font-mono text-xs text-[#6B5D4F]">{item.satuan}</p>
    </div>
    {item.stok ? (
      <a href={wa(pesan)} target="_blank" rel="noopener noreferrer"
        class="mt-4 inline-flex h-12 items-center justify-center bg-[#231A13] px-4 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#2340A8]">
        Pesan via WhatsApp
      </a>
    ) : (
      <a href={wa(kabari)} target="_blank" rel="noopener noreferrer"
        class="mt-4 inline-flex h-12 items-center justify-center border border-[#231A13] px-4 text-sm font-semibold transition-colors duration-150 hover:bg-[#E2D7C5]">
        Kabari saya saat tersedia
      </a>
    )}
  </div>
</article>
