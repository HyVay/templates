---
import { rupiah, toko, type Produk } from '../data/toko';

interface Props { item: Produk }
const { item } = Astro.props;

const pesan = `Halo ${toko.nama}, saya mau pesan ${item.nama} (${item.satuan}).`;
const waLink = `https://wa.me/${toko.telepon}?text=${encodeURIComponent(pesan)}`;
---
<article
  data-kategori={item.kategori}
  class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white transition-shadow duration-150 hover:shadow-md"
>
  <div class="relative">
    <img
      src={item.foto}
      alt={item.nama}
      loading="lazy"
      class="aspect-[4/3] w-full object-cover"
    />
    {!item.stok && (
      <span class="absolute left-3 top-3 rounded-full bg-stone-900/85 px-2.5 py-1 text-xs font-medium text-white">
        Stok habis
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs uppercase tracking-wider text-amber-700">{item.kategori}</p>
    <h3 class="mt-1 text-base font-medium text-stone-900">{item.nama}</h3>
    <p class="mt-1.5 flex-1 text-sm leading-relaxed text-stone-600">{item.ringkas}</p>
    <div class="mt-4 flex items-baseline justify-between">
      <p class="text-base font-semibold tabular-nums text-stone-900">{rupiah(item.harga)}</p>
      <p class="text-xs text-stone-500">{item.satuan}</p>
    </div>
    {item.stok ? (
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center justify-center rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-amber-800"
      >
        Pesan via WhatsApp
      </a>
    ) : (
      <span class="mt-4 inline-flex items-center justify-center rounded-lg border border-stone-200 px-4 py-2.5 text-sm text-stone-400">
        Belum tersedia
      </span>
    )}
  </div>
</article>
