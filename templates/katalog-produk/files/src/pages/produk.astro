---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KartuProduk from '../components/KartuProduk.astro';
import { toko, produk, kategori } from '../data/toko';
---
<Base
  title={`Produk — ${toko.nama}`}
  description={`Katalog lengkap ${toko.nama}: ${produk.length} produk kopi dan peralatan seduh, pesan langsung via WhatsApp.`}
>
  <Header />
  <main>
    <section class="border-b border-stone-200 bg-stone-50">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <h1 class="text-3xl font-semibold text-stone-900 md:text-4xl">Katalog</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600 md:text-base">
          Harga sudah termasuk kemasan kedap udara. Sebutkan alat seduh Anda saat memesan agar kami sesuaikan gilingannya.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16">
      <!-- Filter kategori: tombol biasa + sedikit script, tanpa framework -->
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori">
        {kategori.map((k, i) => (
          <button
            type="button"
            data-filter={k}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn rounded-full border border-stone-300 px-4 py-2 text-sm text-stone-700 transition-colors duration-150 hover:bg-stone-100 aria-pressed:border-amber-700 aria-pressed:bg-amber-700 aria-pressed:text-white"
          >
            {k}
          </button>
        ))}
      </div>

      <div id="grid" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {produk.map((item) => <KartuProduk item={item} />)}
      </div>

      <p id="kosong" class="hidden py-16 text-center text-sm text-stone-500">
        Tidak ada produk pada kategori ini.
      </p>
    </section>
  </main>
  <Footer />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('#grid [data-kategori]');
    const empty = document.getElementById('kosong');

    const apply = (pilihan: string) => {
      let terlihat = 0;
      cards.forEach((card) => {
        const cocok = pilihan === 'Semua' || card.dataset.kategori === pilihan;
        card.classList.toggle('hidden', !cocok);
        if (cocok) terlihat += 1;
      });
      empty?.classList.toggle('hidden', terlihat > 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply(btn.dataset.filter ?? 'Semua');
      });
    });
  </script>
</Base>
