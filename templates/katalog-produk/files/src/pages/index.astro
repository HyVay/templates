---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KartuProduk from '../components/KartuProduk.astro';
import { toko, produk, langkah, foto } from '../data/toko';

const unggulan = produk.filter((p) => p.stok && p.sangrai).slice(0, 3);
const asal = [...new Set(produk.filter((p) => p.asal).map((p) => p.asal!.split(', ').pop()))];
---
<Base title={`${toko.nama} — ${toko.tagline}`} description={toko.deskripsi}>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#231A13]">
      <div class="grid grid-cols-1 md:grid-cols-12">
        <div class="flex flex-col justify-between gap-10 px-4 py-12 md:col-span-7 md:border-r md:border-[#231A13] md:py-14 md:pl-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] md:pr-12">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[#2340A8]">Roastery kecil · {toko.alamat.split(', ').pop()}</p>
            <h1 class="mt-5 font-display text-5xl leading-[1.02] md:text-[4.25rem]">{toko.tagline}.</h1>
            <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-[#4A3D31]">{toko.deskripsi}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/produk/" class="inline-flex h-12 items-center justify-center bg-[#231A13] px-6 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#2340A8]">Lihat katalog</a>
              <a href={`https://wa.me/${toko.telepon}?text=${encodeURIComponent(`Halo ${toko.nama}, mau tanya stok.`)}`} target="_blank" rel="noopener noreferrer" class="inline-flex h-12 items-center justify-center border border-[#231A13] px-6 text-sm font-semibold transition-colors duration-150 hover:bg-[#E2D7C5]">Tanya stok di WhatsApp</a>
            </div>
          </div>
          <dl class="grid grid-cols-1 border-t border-[#231A13] sm:grid-cols-2">
            <div class="py-4 sm:pr-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#6B5D4F]">Sangrai berikutnya</dt>
              <dd class="mt-1 font-display text-xl" id="sangrai-berikut" data-hari={toko.hariSangrai}>Setiap Senin</dd>
            </div>
            <div class="border-t border-[#D9CDB9] py-4 sm:border-l sm:border-t-0 sm:pl-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#6B5D4F]">Asal biji</dt>
              <dd class="mt-1 font-display text-xl leading-snug">{asal.join(' · ')}</dd>
            </div>
          </dl>
        </div>
        <figure class="md:col-span-5">
          <img src={foto.hero} alt="Tangan menggenggam biji kopi yang baru disangrai" width="1100" height="1300" fetchpriority="high" class="aspect-[4/5] h-full w-full object-cover md:aspect-auto" />
        </figure>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-[#2340A8]">Sedang tersedia</p>
          <h2 class="mt-3 font-display text-4xl md:text-5xl">Paling sering dipesan</h2>
        </div>
        <a href="/produk/" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold underline underline-offset-4 transition-colors duration-150 hover:text-[#2340A8]">Semua {produk.length} produk <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {unggulan.map((item) => <KartuProduk item={item} />)}
      </div>
    </section>

    <section class="border-y border-[#231A13] bg-[#F8F4EC]">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-4">
          <p class="font-mono text-xs uppercase tracking-widest text-[#2340A8]">Cara pesan</p>
          <h2 class="mt-3 font-display text-4xl">Tanpa akun, tanpa keranjang.</h2>
        </div>
        <ol class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:col-span-8">
          {langkah.map((l, i) => (
            <li class="border-t-2 border-[#231A13] pt-4">
              <span class="font-display text-4xl text-[#2340A8]">{i + 1}</span>
              <h3 class="mt-2 font-semibold">{l.judul}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[#4A3D31]">{l.isi}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
      <img src={foto.toko} alt="Meja bar dan rak alat seduh di toko" width="1100" height="825" loading="lazy" decoding="async" class="aspect-[4/3] w-full border border-[#231A13] object-cover md:col-span-6" />
      <div class="md:col-span-5 md:col-start-8">
        <p class="font-mono text-xs uppercase tracking-widest text-[#2340A8]">Mampir</p>
        <h2 class="mt-3 font-display text-4xl">Cicipi dulu di toko.</h2>
        <p class="mt-4 leading-relaxed text-[#4A3D31]">Semua biji yang dijual bisa dicicipi gratis sebagai V60 atau tubruk. Bawa grinder Anda, kami bantu menyetel gilingannya.</p>
        <dl class="mt-6 divide-y divide-[#D9CDB9] border-y border-[#231A13]">
          <div class="flex justify-between gap-4 py-3"><dt class="text-[#6B5D4F]">Alamat</dt><dd class="text-right">{toko.alamat}</dd></div>
          <div class="flex justify-between gap-4 py-3"><dt class="text-[#6B5D4F]">Jam buka</dt><dd class="text-right tabular-nums">{toko.jam}</dd></div>
        </dl>
        <a href={toko.maps} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex h-12 items-center justify-center border border-[#231A13] px-6 text-sm font-semibold transition-colors duration-150 hover:bg-[#E2D7C5]">Buka di Google Maps</a>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    // Hitung tanggal sangrai berikutnya di sisi pengunjung supaya tidak basi setelah situs dibangun.
    const el = document.getElementById('sangrai-berikut');
    if (el) {
      const hari = Number(el.dataset.hari ?? 1);
      const d = new Date();
      d.setDate(d.getDate() + ((hari - d.getDay() + 7) % 7 || 7));
      el.textContent = d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long' });
    }
  </script>
</Base>
