---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { toko, produk, gilingan, foto, rupiah } from '../data/toko';

const input = 'mt-2 block h-12 w-full border border-[#8F806B] bg-[#F8F4EC] px-3 text-base outline-none transition-colors duration-150 placeholder:text-[#8F806B] focus:border-[#2340A8]';
---
<Base
  title={`Pesan & kontak — ${toko.nama}`}
  description={`Alamat, jam buka, dan cara memesan dari ${toko.nama} di ${toko.alamat}.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-[#231A13]">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 py-12 md:grid-cols-12 md:items-end md:px-6 md:py-16">
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-widest text-[#2340A8]">Formulir pesanan</p>
          <h1 class="mt-4 font-display text-5xl md:text-6xl">Susun pesanan, kirim lewat WhatsApp.</h1>
        </div>
        <p class="max-w-[46ch] leading-relaxed text-[#4A3D31] md:col-span-5">Kami balas dengan total harga, ongkir, dan nomor rekening. Pembayaran dikonfirmasi lewat chat yang sama.</p>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
      <form id="pesan-form" class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:col-span-7">
        <div class="sm:col-span-2">
          <label for="produk" class="block text-sm font-semibold">Produk</label>
          <select id="produk" name="produk" class={input}>
            {produk.filter((p) => p.stok).map((p) => <option value={`${p.nama} (${p.satuan})`}>{p.nama} — {p.satuan} · {rupiah(p.harga)}</option>)}
          </select>
        </div>
        <div>
          <label for="jumlah" class="block text-sm font-semibold">Jumlah</label>
          <input id="jumlah" name="jumlah" type="number" min="1" value="1" inputmode="numeric" required class={input} />
        </div>
        <div>
          <label for="gilingan" class="block text-sm font-semibold">Gilingan</label>
          <select id="gilingan" name="gilingan" class={input}>
            {gilingan.map((g) => <option>{g}</option>)}
          </select>
        </div>
        <div>
          <label for="nama" class="block text-sm font-semibold">Nama penerima</label>
          <input id="nama" name="nama" required autocomplete="name" class={input} />
        </div>
        <div>
          <label for="kota" class="block text-sm font-semibold">Kota tujuan</label>
          <input id="kota" name="kota" required autocomplete="address-level2" placeholder="Contoh: Bandung" class={input} />
        </div>
        <div class="sm:col-span-2">
          <label for="catatan" class="block text-sm font-semibold">Catatan <span class="font-normal text-[#6B5D4F]">(opsional)</span></label>
          <textarea id="catatan" name="catatan" rows="3" placeholder="Produk tambahan, alamat lengkap, waktu kirim" class={`${input} h-auto py-3`}></textarea>
        </div>
        <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:items-center">
          <button type="submit" class="inline-flex h-12 items-center justify-center bg-[#231A13] px-6 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#2340A8]">Kirim pesanan via WhatsApp</button>
          <p class="text-sm text-[#6B5D4F]">Tanpa keranjang dan tanpa pembayaran online.</p>
        </div>
        <p id="status" role="status" aria-live="polite" class="text-sm font-medium text-[#2340A8] sm:col-span-2"></p>
      </form>

      <aside class="md:col-span-4 md:col-start-9">
        <img src={foto.toko} alt="Meja bar dan rak alat seduh di toko" width="1100" height="825" loading="lazy" decoding="async" class="aspect-[4/3] w-full border border-[#231A13] object-cover" />
        <dl class="mt-6 divide-y divide-[#D9CDB9] border-y border-[#231A13]">
          <div class="py-4"><dt class="font-mono text-xs uppercase tracking-widest text-[#6B5D4F]">Alamat toko</dt><dd class="mt-1">{toko.alamat}</dd></div>
          <div class="py-4"><dt class="font-mono text-xs uppercase tracking-widest text-[#6B5D4F]">Jam buka</dt><dd class="mt-1 tabular-nums">{toko.jam}</dd></div>
          <div class="py-4"><dt class="font-mono text-xs uppercase tracking-widest text-[#6B5D4F]">Pengiriman</dt><dd class="mt-1">{toko.ongkir}</dd></div>
        </dl>
      </aside>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: toko.telepon, namaToko: toko.nama }}>
    const form = document.getElementById('pesan-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo ${namaToko}, saya ${d.get('nama')} (${d.get('kota')}).`,
        `Pesanan: ${d.get('produk')} x ${d.get('jumlah')}`,
        `Gilingan: ${d.get('gilingan')}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
      document.getElementById('status').textContent = 'WhatsApp dibuka di tab baru. Kalau tidak muncul, izinkan pop-up lalu kirim lagi.';
    });
  </script>
</Base>
