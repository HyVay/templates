---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif; background: #F2F2F0; color: #0A2342; }
  .font-display { font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif; }
  .font-body { font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif; }
</style>
