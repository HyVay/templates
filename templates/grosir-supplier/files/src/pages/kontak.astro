---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { toko } from '../data/grosir';

const input = 'mt-1 w-full border-2 border-[#0A2342]/40 bg-white px-3 py-3 text-sm text-[#0A2342] outline-none transition-colors duration-150 placeholder:text-[#0A2342]/40 focus:border-[#0A2342]';
---
<Base
  title={`Minta Penawaran — ${toko.nama}`}
  description={`Kirim daftar belanja ke ${toko.nama} dan terima total harga, ongkir, serta jadwal kirim lewat WhatsApp.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b-2 border-[#0A2342] bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">Dibalas dalam 1 jam kerja</p>
        <h1 class="mt-3 font-display text-5xl font-bold uppercase leading-none tracking-wide text-[#0A2342] md:text-7xl">Minta penawaran</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0A2342]/75 md:text-base">
          Isi form ini, pesan akan terbuka di WhatsApp lengkap dengan daftar barang yang Anda tulis. Kami balas dengan total, ongkir, dan jadwal kirim.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="md:col-span-7">
          <form id="penawaran-form" class="space-y-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="toko" class="font-mono text-xs uppercase tracking-widest font-medium text-[#0A2342]/85">Nama toko / usaha</label>
                <input autocomplete="organization" id="toko" name="toko" required placeholder="Toko Barokah" class={input} />
              </div>
              <div>
                <label for="nama" class="font-mono text-xs uppercase tracking-widest font-medium text-[#0A2342]/85">Nama Anda</label>
                <input id="nama" name="nama" required placeholder="Nama pemesan" class={input} autocomplete="name" />
              </div>
            </div>
            <div>
              <label for="alamat" class="font-mono text-xs uppercase tracking-widest font-medium text-[#0A2342]/85">Alamat kirim</label>
              <input id="alamat" name="alamat" autocomplete="street-address" required placeholder="Jalan, kelurahan, kecamatan, kota" class={input} />
            </div>
            <div>
              <label for="barang" class="font-mono text-xs uppercase tracking-widest font-medium text-[#0A2342]/85">Daftar barang & jumlah</label>
              <textarea
                id="barang" name="barang" rows="7" required
                placeholder={'Satu baris per barang, contoh:\nMinyak goreng 2 L — 2 karton\nGula pasir 1 kg — 30 kg\nAir mineral 600 ml — 5 karton'}
                class={input}
              ></textarea>
            </div>
            <div>
              <label for="catatan" class="font-mono text-xs uppercase tracking-widest font-medium text-[#0A2342]/85">Catatan (opsional)</label>
              <input id="catatan" name="catatan" placeholder="Jam kirim yang diminta, cara bayar, dll." class={input} />
            </div>
            <button type="submit" class="inline-flex w-full items-center justify-center bg-[#F28C28] px-6 py-4 font-display text-lg font-semibold uppercase tracking-wide text-[#0A2342] transition-colors duration-150 hover:bg-[#0A2342] hover:text-white sm:w-auto">
              Kirim via WhatsApp
            </button>
            <p id="status" role="status" aria-live="polite" class="hidden border-2 border-[#0A2342] bg-white px-4 py-3 text-sm"></p>
          </form>
          <p class="mt-3 text-xs text-[#0A2342]/75">
            Situs ini statis tanpa basis data. Daftar belanja dikirim sebagai chat WhatsApp ke admin gudang.
          </p>
        </div>

        <div class="md:col-span-5">
          <div class="border-2 border-[#0A2342] bg-white">
            <div class="border-b-2 border-[#0A2342] bg-[#0A2342] px-5 py-3 font-mono text-xs uppercase tracking-widest text-white">Gudang & admin</div>
            <dl class="divide-y-2 divide-[#0A2342]/15 px-5">
              <div class="py-4">
                <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Alamat</dt>
                <dd class="mt-1 text-sm leading-relaxed">{toko.alamat}</dd>
              </div>
              <div class="py-4">
                <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Jam</dt>
                <dd class="mt-1">
                  {toko.jam.map((j) => (
                    <p class="flex justify-between gap-4 text-sm"><span class="text-[#0A2342]/70">{j.hari}</span><span class="tabular-nums">{j.jam}</span></p>
                  ))}
                </dd>
              </div>
              <div class="py-4">
                <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">WhatsApp admin</dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums">+{toko.telepon}</dd>
              </div>
            </dl>
          </div>
          <a
            href={`https://wa.me/${toko.telepon}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 flex items-center justify-center gap-2 bg-[#0A2342] px-5 py-4 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors duration-150 hover:bg-[#F28C28] hover:text-[#0A2342]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 2a8 8 0 11-4.1 14.9l-.4-.2-2.9.8.8-2.8-.2-.4A8 8 0 0112 4z" /></svg>
            Chat langsung tanpa form
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script define:vars={{ wa: toko.telepon }}>
    const form = document.getElementById('penawaran-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo, saya ${d.get('nama')} dari ${d.get('toko')}. Mohon penawaran untuk:`,
        '',
        String(d.get('barang')),
        '',
        `Alamat kirim: ${d.get('alamat')}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
      const st = document.getElementById('status');
      if (st) { st.textContent = 'WhatsApp dibuka di tab baru. Tekan kirim di sana; admin membalas dalam 1 jam kerja.'; st.classList.remove('hidden'); }
      const st = document.getElementById('status');
      if (st) { st.textContent = 'WhatsApp dibuka di tab baru. Tekan kirim di sana; kami balas di jam kerja.'; st.classList.remove('hidden'); }
    });
  </script>
</Base>
