---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabelHarga from '../components/TabelHarga.astro';
import { toko, produk, kategori } from '../data/grosir';
---
<Base
  title={`Daftar Harga — ${toko.nama}`}
  description={`Daftar harga grosir ${toko.nama}: ${produk.length} produk dengan harga eceran, per lusin, dan per karton. Pesan via WhatsApp.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b-2 border-[#0A2342] bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">{produk.length} produk · diperbarui tiap Senin</p>
        <h1 class="mt-3 font-display text-5xl font-bold uppercase leading-none tracking-wide text-[#0A2342] md:text-7xl">Daftar harga</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0A2342]/75 md:text-base">
          Tiga tingkat harga: eceran, mulai 12 satuan, dan per karton penuh. MOQ adalah jumlah minimum per produk dalam satu pesanan. Harga belum termasuk ongkir.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori">
        {kategori.map((k, i) => (
          <button
            type="button"
            data-filter={k}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn min-h-[44px] border-2 border-[#0A2342] px-4 py-2 font-display text-base font-semibold uppercase tracking-wide text-[#0A2342] transition-colors duration-150 hover:bg-[#0A2342]/10 aria-pressed:bg-[#0A2342] aria-pressed:text-white"
          >
            {k}
            <span class="ml-1 font-mono text-xs font-normal opacity-75">{k === 'Semua' ? produk.length : produk.filter((p) => p.kategori === k).length}</span>
          </button>
        ))}
      </div>

      <div class="mt-6">
        <TabelHarga items={produk} id="semua" />
      </div>
      <p id="kosong" class="hidden border-2 border-dashed border-[#0A2342]/40 py-14 text-center text-sm text-[#0A2342]/75">
        Belum ada produk di kategori ini.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 border-t-2 border-[#0A2342] pt-8 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">Cara membaca harga</p>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[#0A2342]/80">
            <li><span class="font-semibold text-[#0A2342]">Eceran</span>: beli di bawah 12 satuan.</li>
            <li><span class="font-semibold text-[#0A2342]">≥ 12</span>: harga per satuan jika mengambil 12 satuan atau lebih, tidak harus satu karton.</li>
            <li><span class="font-semibold text-[#0A2342]">≥ 1 karton</span>: harga per satuan jika mengambil kelipatan karton penuh.</li>
            <li>Produk bertanda <span class="font-semibold text-[#0A2342]">stok kosong</span> bisa dipesan dulu, dikirim saat stok masuk.</li>
          </ul>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href="/kontak/" class="inline-flex w-full items-center justify-center bg-[#F28C28] px-6 py-4 font-display text-lg font-semibold uppercase tracking-wide text-[#0A2342] transition-colors duration-150 hover:bg-[#0A2342] hover:text-white md:w-auto">
            Minta penawaran
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const rows = document.querySelectorAll<HTMLElement>('#semua-desktop [data-kategori], #semua-mobile [data-kategori]');
    const empty = document.getElementById('kosong');

    const apply = (pilihan: string) => {
      let terlihat = 0;
      rows.forEach((row) => {
        const cocok = pilihan === 'Semua' || row.dataset.kategori === pilihan;
        row.classList.toggle('hidden', !cocok);
        if (cocok) terlihat += 1;
      });
      empty?.classList.toggle('hidden', terlihat > 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply(btn.dataset.filter ?? 'Semua');
      });
    });
  </script>
</Base>
