---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { toko, langkahOrder, areaKirim, foto } from '../data/grosir';
---
<Base
  title={`Cara Order — ${toko.nama}`}
  description={`Cara memesan di ${toko.nama}: langkah order, minimal pesanan, ongkir per area, metode pembayaran, dan jadwal pengiriman.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b-2 border-[#0A2342] bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">Lima langkah, tanpa aplikasi</p>
        <h1 class="mt-3 font-display text-5xl font-bold uppercase leading-none tracking-wide text-[#0A2342] md:text-7xl">Cara order</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#0A2342]/75 md:text-base">
          Semua pesanan lewat WhatsApp. Tidak ada akun, tidak ada keranjang; satu admin yang sama membalas dari pagi sampai gudang tutup.
        </p>
      </div>
    </section>

    <!-- Langkah -->
    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <ol class="divide-y-2 divide-[#0A2342]/15 border-y-2 border-[#0A2342]">
        {langkahOrder.map((l, i) => (
          <li class="grid grid-cols-1 gap-2 py-6 md:grid-cols-12 md:gap-6">
            <p class="font-display text-4xl font-bold tabular-nums text-[#C76A12] md:col-span-2 md:text-5xl">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-[#0A2342] md:col-span-4">{l.judul}</h2>
            <p class="text-sm leading-relaxed text-[#0A2342]/80 md:col-span-6 md:text-base">{l.isi}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Syarat & ongkir -->
    <section class="border-y-2 border-[#0A2342] bg-white">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
        <div class="md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">Minimal & pembayaran</p>
          <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-wide text-[#0A2342]">Syarat pesanan</h2>
          <dl class="mt-6 divide-y-2 divide-[#0A2342]/15 border-y-2 border-[#0A2342]/40">
            <div class="py-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Minimal pesanan</dt>
              <dd class="mt-1 font-semibold">{toko.minimalOrder}</dd>
            </div>
            <div class="py-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Gratis ongkir</dt>
              <dd class="mt-1 font-semibold">{toko.gratisOngkir}</dd>
            </div>
            <div class="py-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Pembayaran</dt>
              <dd class="mt-1">
                <ul class="space-y-1 text-sm leading-relaxed">
                  {toko.pembayaran.map((p) => <li>{p}</li>)}
                </ul>
              </dd>
            </div>
            <div class="py-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-[#0A2342]/75">Jadwal kirim</dt>
              <dd class="mt-1 text-sm leading-relaxed">{toko.jamKirim}</dd>
            </div>
          </dl>
        </div>
        <div class="md:col-span-7">
          <p class="font-mono text-xs uppercase tracking-widest text-[#9A4F0A]">Ongkir</p>
          <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-wide text-[#0A2342]">Per area</h2>
          <div class="mt-6 border-2 border-[#0A2342]">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="bg-[#0A2342] font-mono text-[11px] uppercase tracking-widest text-white">
                  <th scope="col" class="px-4 py-3 font-medium">Area</th>
                  <th scope="col" class="px-4 py-3 font-medium">Biaya</th>
                  <th scope="col" class="px-4 py-3 text-right font-medium">Estimasi</th>
                </tr>
              </thead>
              <tbody class="divide-y-2 divide-[#0A2342]/15">
                {areaKirim.map((a) => (
                  <tr>
                    <td class="px-4 py-3 font-semibold">{a.area}</td>
                    <td class="px-4 py-3 text-[#0A2342]/80">{a.biaya}</td>
                    <td class="px-4 py-3 text-right font-mono text-xs uppercase tracking-widest">{a.estimasi}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <img width="1200" height="514" decoding="async" src={foto.rak} alt="Rak toko kelontong berisi barang kebutuhan harian" loading="lazy" class="mt-8 aspect-[21/9] w-full border-2 border-[#0A2342] object-cover" />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
      <div class="flex flex-col gap-4 border-2 border-[#0A2342] p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
        <p class="font-display text-2xl font-semibold uppercase tracking-wide text-[#0A2342] md:text-3xl">Sudah punya daftar belanja?</p>
        <a href="/kontak/" class="inline-flex items-center justify-center bg-[#F28C28] px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-[#0A2342] transition-colors duration-150 hover:bg-[#0A2342] hover:text-white">
          Kirim lewat form
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
