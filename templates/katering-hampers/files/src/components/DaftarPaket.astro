---
/** Daftar paket tipografis: nama … harga, isi italic di bawah, minimum pesan mono di kanan isi. */
import { rupiah, type Paket } from '../data/dapur';

interface Props { judul: string; keterangan?: string; items: Paket[]; id?: string }
const { judul, keterangan, items, id } = Astro.props;
---
<section id={id} class="scroll-mt-32">
  <div class="flex items-baseline justify-between gap-4 border-b-2 border-[#3A4A2F] pb-2">
    <h2 class="font-display text-3xl font-semibold md:text-4xl">{judul}</h2>
    <span class="font-mono text-xs uppercase tracking-widest text-[#3A4A2F]/75">{items.length} pilihan</span>
  </div>
  {keterangan && <p class="mt-3 max-w-prose text-sm leading-relaxed text-[#3A4A2F]/80">{keterangan}</p>}
  <ul class="mt-2 divide-y divide-[#3A4A2F]/15">
    {items.map((p) => (
      <li class="py-5">
        <div class="flex items-baseline gap-3">
          <h3 class="min-w-0 font-display text-2xl font-semibold leading-tight">
            {p.nama}
            {p.favorit && <span class="ml-2 align-middle font-body text-[11px] font-semibold uppercase tracking-widest text-[#8C2F39]">Favorit</span>}
          </h3>
          <span class="min-w-[1.5rem] flex-1 translate-y-[-5px] border-b border-dotted border-[#3A4A2F]/40" aria-hidden="true"></span>
          <span class="shrink-0 font-display text-xl font-semibold tabular-nums md:text-2xl">
            {rupiah(p.harga)}<span class="font-body text-sm font-normal text-[#3A4A2F]/75"> / {p.satuan}</span>
          </span>
        </div>
        <div class="mt-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <p class="max-w-xl font-display text-base italic leading-snug text-[#3A4A2F]/85 [text-wrap:pretty]">{p.isi}</p>
          <p class="shrink-0 font-mono text-xs uppercase tracking-wider text-[#3A4A2F]/75">min. {p.minimal}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
