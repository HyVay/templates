---
import { dapur, poMusiman } from '../data/dapur';
---
<footer class="border-t border-[#3A4A2F]/15 bg-[#3A4A2F] text-[#FCFAF5]">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6">
    <div class="md:col-span-5">
      <p class="font-display text-3xl font-semibold">{dapur.nama}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#FCFAF5]/75">{dapur.tagline}</p>
      <p class="mt-4 text-sm text-[#FCFAF5]/75">{dapur.jamPesan}</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs uppercase tracking-widest text-[#FCFAF5]/60">{poMusiman.judul}</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>{poMusiman.tutup}</li>
        <li>{poMusiman.kirim}</li>
        <li class="text-[#FCFAF5]/75">{poMusiman.catatan}</li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="text-xs uppercase tracking-widest text-[#FCFAF5]/60">Hubungi</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>{dapur.alamat}</li>
        <li><a href={`https://wa.me/${dapur.telepon}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#E8B4B8]">WhatsApp {dapur.telepon}</a></li>
        <li><a href={`https://instagram.com/${dapur.instagram}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors duration-150 hover:text-[#E8B4B8]">@{dapur.instagram}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[#FCFAF5]/15 px-4 py-5 text-xs text-[#FCFAF5]/60 md:px-6">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 sm:flex-row sm:justify-between">
      <span>© {new Date().getFullYear()} {dapur.nama}, {dapur.kota}.</span>
      <span>{dapur.dp}</span>
    </div>
  </div>
</footer>
