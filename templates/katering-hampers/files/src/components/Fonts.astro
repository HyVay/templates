---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Mulish:wght@400;500;600&display=swap" />
<style is:global>
  body { font-family: 'Mulish', ui-sans-serif, system-ui, sans-serif; }
  .font-display { font-family: 'Cormorant Garamond', Georgia, serif; }
  .font-body { font-family: 'Mulish', ui-sans-serif, system-ui, sans-serif; }
</style>
