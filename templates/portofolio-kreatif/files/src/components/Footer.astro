---
import { profil } from '../data/portofolio';
const link = 'inline-block py-1.5 transition-opacity duration-150 hover:opacity-60';
---
<footer class="border-t border-[#141414]/15">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 py-14 sm:grid-cols-2 md:grid-cols-12 md:px-8">
    <div class="sm:col-span-2 md:col-span-6">
      <p class="font-display text-3xl italic">{profil.nama}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-[#141414]/70">{profil.profesi} di {profil.kota} sejak {profil.sejak}. Keluarga, pernikahan intim, dan produk UMKM.</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs uppercase tracking-widest text-[#141414]/70">Hubungi</p>
      <ul class="mt-3 text-sm">
        <li><a href={`https://wa.me/${profil.telepon}`} target="_blank" rel="noopener noreferrer" class={`${link} underline underline-offset-4`}>WhatsApp</a></li>
        <li><a href={`mailto:${profil.email}`} class={`${link} underline underline-offset-4`}>{profil.email}</a></li>
        <li><a href={`https://instagram.com/${profil.instagram}`} target="_blank" rel="noopener noreferrer" class={`${link} underline underline-offset-4`}>@{profil.instagram}</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="text-xs uppercase tracking-widest text-[#141414]/70">Halaman</p>
      <ul class="mt-3 text-sm">
        <li><a href="/karya/" class={link}>Karya</a></li>
        <li><a href="/tentang/" class={link}>Tentang</a></li>
        <li><a href="/kontak/" class={link}>Kontak & paket</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-7xl border-t border-[#141414]/10 px-4 py-6 text-xs leading-relaxed text-[#141414]/70 md:px-8">
    © {new Date().getFullYear()} {profil.nama}. Semua foto dilindungi hak cipta; hubungi untuk izin pemakaian.
  </div>
</footer>
