---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, paket } from '../data/portofolio';

const input = 'mt-1 w-full border-b border-[#141414]/30 bg-transparent px-0 py-3 text-base outline-none transition-colors duration-150 focus:border-[#141414]';
---
<Base title={`Kontak & paket — ${profil.nama}`} description={`Paket sesi foto ${profil.nama}: keluarga, pernikahan intim, dan produk. Pesan tanggal lewat WhatsApp.`}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-20">
      <h1 class="font-display text-5xl italic leading-[0.95] tracking-tight md:text-7xl">Kontak & paket</h1>

      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
        <section class="md:col-span-6">
          <h2 class="text-xs uppercase tracking-widest text-[#141414]/60">Paket</h2>
          <ul class="mt-4 divide-y divide-[#141414]/15 border-y border-[#141414]/15">
            {paket.map((p) => (
              <li class="py-5">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-display text-2xl">{p.nama}</span>
                  <span class="shrink-0 text-sm">{p.harga}</span>
                </div>
                <p class="mt-1 max-w-md text-sm leading-relaxed text-[#141414]/70">{p.isi}</p>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-[#141414]/70">
            Di luar Jabodetabek ditambah biaya perjalanan sesuai lokasi. Tanggal dianggap terpesan setelah uang muka 30%.
          </p>
        </section>

        <section class="md:col-span-6">
          <h2 class="text-xs uppercase tracking-widest text-[#141414]/60">Pesan tanggal</h2>
          <form id="kontak-form" class="mt-4 space-y-5">
            <div>
              <label for="nama" class="text-sm">Nama</label>
              <input id="nama" name="nama" required placeholder="Nama Anda" class={input} />
            </div>
            <div>
              <label for="jenis" class="text-sm">Jenis sesi</label>
              <select id="jenis" name="jenis" class={input}>
                {paket.map((p) => <option value={p.nama}>{p.nama}</option>)}
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="tanggal" class="text-sm">Tanggal</label>
                <input id="tanggal" name="tanggal" type="date" required class={input} />
              </div>
              <div>
                <label for="lokasi" class="text-sm">Lokasi</label>
                <input id="lokasi" name="lokasi" placeholder="Kecamatan / kota" class={input} />
              </div>
            </div>
            <div>
              <label for="catatan" class="text-sm">Catatan</label>
              <textarea id="catatan" name="catatan" rows="3" placeholder="Jumlah orang, suasana yang diinginkan, referensi" class={input}></textarea>
            </div>
            <button type="submit" class="w-full bg-[#141414] px-6 py-3 text-sm text-[#FAFAF9] transition-opacity duration-150 hover:opacity-80 sm:w-auto">
              Kirim via WhatsApp
            </button>
            <p class="text-xs text-[#141414]/60">
              Situs ini tidak menyimpan data. Isian dikirim sebagai pesan WhatsApp ke {profil.telepon}; saya balas dalam satu hari kerja.
            </p>
          </form>
        </section>
      </div>
    </main>
    <Footer />
  </div>

  <script define:vars={{ wa: profil.telepon, nama: profil.nama }}>
    const form = document.getElementById('kontak-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = [
        `Halo ${nama}, saya ${d.get('nama')}.`,
        `Jenis sesi: ${d.get('jenis')}`,
        `Tanggal: ${d.get('tanggal')}`,
        `Lokasi: ${d.get('lokasi') || '-'}`,
        `Catatan: ${d.get('catatan') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</Base>
