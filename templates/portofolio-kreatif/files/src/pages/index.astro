---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, karya, heroFoto, paket, src } from '../data/portofolio';

// Satu foto per jenis sesi, dipasangkan dengan paketnya (urutan sama dengan `paket`).
const jenis = [
  { kategori: 'Keluarga', paket: paket[0] },
  { kategori: 'Pernikahan', paket: paket[1] },
  { kategori: 'Produk', paket: paket[2] },
].map((j) => ({ ...j, karya: karya.find((k) => k.kategori === j.kategori) }));
---
<Base title={`${profil.nama} — ${profil.profesi}, ${profil.kota}`} description={profil.kalimat}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main id="konten">
      <!-- Hero: satu kalimat besar, lalu foto lebar -->
      <section class="mx-auto max-w-7xl px-4 pb-10 pt-10 md:px-8 md:pb-14 md:pt-20">
        <h1 class="max-w-5xl text-balance font-display text-[2.75rem] italic leading-[0.95] tracking-tight sm:text-6xl md:text-7xl lg:text-8xl">{profil.kalimat}</h1>
        <div class="mt-8 flex flex-col gap-6 border-t border-[#141414]/15 pt-6 sm:flex-row sm:items-center sm:justify-between md:mt-12">
          <dl class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
            <div class="flex gap-2"><dt class="text-[#141414]/70">Basis</dt><dd>{profil.kota}</dd></div>
            <div class="flex gap-2"><dt class="text-[#141414]/70">Sejak</dt><dd class="tabular-nums">{profil.sejak}</dd></div>
            <div class="flex gap-2"><dt class="text-[#141414]/70">Karya</dt><dd class="tabular-nums">{karya.length} proyek terpilih</dd></div>
          </dl>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <a href="/kontak/#pesan" class="bg-[#141414] px-6 py-3.5 text-center text-sm text-[#FAFAF9] transition-opacity duration-150 hover:opacity-80">Pesan tanggal</a>
            <a href="/karya/" class="py-3 text-center text-sm underline underline-offset-4 transition-opacity duration-150 hover:opacity-60">Lihat galeri</a>
          </div>
        </div>
      </section>
      <img
        src={src(heroFoto, 2400, 1030)}
        width="2400"
        height="1030"
        fetchpriority="high"
        alt="Keluarga besar berjalan bergandengan di tepi pantai saat matahari terbenam"
        class="aspect-[4/3] w-full object-cover sm:aspect-[21/9]"
      />

      <!-- Indeks karya -->
      <section class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24" aria-labelledby="indeks">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="indeks" class="font-display text-3xl italic md:text-5xl">Indeks karya</h2>
          <a href="/karya/" class="shrink-0 py-2 text-sm underline underline-offset-4 transition-opacity duration-150 hover:opacity-60">Galeri lengkap</a>
        </div>
        <ol class="mt-8 divide-y divide-[#141414]/15 border-y border-[#141414]/15">
          {karya.map((k, i) => (
            <li>
              <a href={`/karya/#karya-${i + 1}`} class="group flex items-center gap-4 py-3 transition-colors duration-150 hover:bg-[#141414]/[0.03] md:grid md:grid-cols-12 md:gap-6 md:py-3">
                <span class="w-6 shrink-0 font-mono text-xs tabular-nums text-[#141414]/70 md:col-span-1 md:w-auto">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex min-w-0 flex-1 flex-col md:contents">
                  <span class="font-display text-xl leading-tight md:col-span-5 md:text-2xl">{k.judul}</span>
                  <span class="mt-1 text-xs text-[#141414]/70 md:col-span-2 md:mt-0 md:uppercase md:tracking-widest">{k.kategori}<span class="md:hidden"> · {k.lokasi}, {k.tahun}</span></span>
                  <span class="hidden text-sm text-[#141414]/70 md:col-span-3 md:block">{k.lokasi}, <span class="tabular-nums">{k.tahun}</span></span>
                </span>
                <img
                  src={src(k.foto, 160, 200)}
                  width="160"
                  height="200"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-12 shrink-0 object-cover grayscale transition duration-150 group-hover:grayscale-0 md:col-span-1 md:ml-auto md:w-14"
                />
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Tiga jenis sesi, masing-masing dengan paketnya -->
      <section class="border-t border-[#141414]/15" aria-labelledby="sesi">
        <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="sesi" class="font-display text-3xl italic md:text-5xl">Tiga jenis sesi</h2>
            <a href="/kontak/" class="shrink-0 py-2 text-sm underline underline-offset-4 transition-opacity duration-150 hover:opacity-60">Rincian paket</a>
          </div>
          <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6">
            {jenis.map((j) => j.karya && (
              <a href="/kontak/#pesan" class="group block">
                <img
                  src={src(j.karya.foto, 800, 1000)}
                  width="800"
                  height="1000"
                  alt={j.karya.judul}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover transition-opacity duration-150 group-hover:opacity-85"
                />
                <div class="mt-4 flex items-baseline justify-between gap-4 border-b border-[#141414]/15 pb-3">
                  <p class="font-display text-2xl">{j.paket.nama}</p>
                  <p class="shrink-0 text-sm tabular-nums">{j.paket.harga}</p>
                </div>
                <p class="mt-3 text-pretty text-sm leading-relaxed text-[#141414]/70">{j.paket.isi}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Penutup -->
      <section class="border-t border-[#141414]/15">
        <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-16 md:flex-row md:items-end md:justify-between md:px-8 md:py-24">
          <p class="max-w-3xl text-balance font-display text-4xl italic leading-[1.05] md:text-6xl">Punya tanggal? Ceritakan suasananya, saya balas dalam satu hari kerja.</p>
          <a href="/kontak/#pesan" class="shrink-0 bg-[#141414] px-6 py-3.5 text-center text-sm text-[#FAFAF9] transition-opacity duration-150 hover:opacity-80">Pesan tanggal</a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
