---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, karya, heroFoto } from '../data/portofolio';
---
<Base title={`${profil.nama} — ${profil.profesi}, ${profil.kota}`} description={profil.kalimat}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main>
      <!-- Hero: satu kalimat besar, lalu foto lebar -->
      <section class="mx-auto max-w-7xl px-4 pb-10 pt-12 md:px-8 md:pb-14 md:pt-24">
        <h1 class="max-w-5xl font-display text-5xl italic leading-[0.95] tracking-tight md:text-7xl lg:text-8xl">{profil.kalimat}</h1>
        <div class="mt-8 flex flex-col gap-2 text-sm text-[#141414]/60 sm:flex-row sm:gap-8 md:mt-12">
          <span>{profil.profesi}, {profil.kota}</span>
          <span>Sejak {profil.sejak}</span>
          <span>Pesan sesi lewat <a href="/kontak/" class="text-[#141414] underline underline-offset-4 transition-opacity duration-150 hover:opacity-50">WhatsApp</a></span>
        </div>
      </section>
      <img src={heroFoto} alt="Keluarga berjalan bergandengan di tepi pantai saat matahari terbenam" class="aspect-[21/9] w-full object-cover" />

      <!-- Indeks karya -->
      <section class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-3xl italic md:text-4xl">Indeks karya</h2>
          <a href="/karya/" class="text-sm underline underline-offset-4 transition-opacity duration-150 hover:opacity-50">Lihat galeri</a>
        </div>
        <ol class="mt-8 divide-y divide-[#141414]/15 border-y border-[#141414]/15">
          {karya.map((k, i) => (
            <li>
              <a href="/karya/" class="group flex flex-col gap-1 py-4 transition-opacity duration-150 hover:opacity-70 md:grid md:grid-cols-12 md:items-center md:gap-6 md:py-5">
                <span class="flex items-baseline gap-4 md:contents">
                  <span class="font-mono text-xs text-[#141414]/50 md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
                  <span class="font-display text-xl md:col-span-5 md:text-2xl">{k.judul}</span>
                </span>
                <span class="flex gap-4 pl-9 text-xs text-[#141414]/60 md:contents md:pl-0">
                  <span class="uppercase tracking-widest md:col-span-2">{k.kategori}</span>
                  <span class="md:col-span-3">{k.lokasi}, {k.tahun}</span>
                </span>
                <span class="hidden md:col-span-1 md:block">
                  <img src={k.foto} alt="" loading="lazy" class="ml-auto aspect-square w-14 object-cover opacity-0 transition-opacity duration-150 group-hover:opacity-100" />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Tiga foto, tiga kategori -->
      <section class="mx-auto max-w-7xl px-4 pb-16 md:px-8 md:pb-24">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6">
          {['Keluarga', 'Pernikahan', 'Produk'].map((kat) => {
            const k = karya.find((x) => x.kategori === kat)!;
            return (
              <a href="/karya/" class="group block">
                <img src={k.foto} alt={k.judul} loading="lazy" class="aspect-[3/4] w-full object-cover transition-opacity duration-150 group-hover:opacity-80" />
                <p class="mt-3 text-xs uppercase tracking-widest text-[#141414]/60">{kat}</p>
                <p class="mt-1 font-display text-xl">{k.judul}</p>
              </a>
            );
          })}
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
