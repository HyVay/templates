---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, klien, peralatan } from '../data/portofolio';
---
<Base title={`Tentang — ${profil.nama}`} description={`${profil.nama}, ${profil.profesi} di ${profil.kota} sejak ${profil.sejak}. Cara kerja, klien, dan peralatan.`}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-20">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-5">
          <img src={profil.potret} alt={`Potret ${profil.nama}`} class="aspect-[3/4] w-full object-cover" />
        </div>
        <div class="md:col-span-7">
          <h1 class="font-display text-5xl italic leading-[0.95] tracking-tight md:text-7xl">Tentang</h1>
          <div class="mt-8 max-w-xl space-y-5 text-base leading-relaxed text-[#141414]/80">
            {profil.tentang.map((p) => <p>{p}</p>)}
          </div>
          <dl class="mt-12 grid grid-cols-1 gap-8 border-t border-[#141414]/15 pt-8 sm:grid-cols-2">
            <div>
              <dt class="text-xs uppercase tracking-widest text-[#141414]/60">Pernah bekerja untuk</dt>
              <dd class="mt-3 space-y-1 font-display text-xl">
                {klien.map((k) => <p>{k}</p>)}
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-[#141414]/60">Peralatan</dt>
              <dd class="mt-3 space-y-1 text-sm text-[#141414]/80">
                {peralatan.map((p) => <p>{p}</p>)}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Base>
