---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, klien, peralatan, src } from '../data/portofolio';
---
<Base title={`Tentang — ${profil.nama}`} description={`${profil.nama}, ${profil.profesi} di ${profil.kota} sejak ${profil.sejak}. Cara kerja, klien, dan peralatan.`}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main id="konten" class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-20">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-5">
          <div class="md:sticky md:top-24">
            <img src={src(profil.potret, 1000, 1333)} width="1000" height="1333" fetchpriority="high" alt={`Potret ${profil.nama}`} class="aspect-[3/4] w-full bg-[#141414]/5 object-cover" />
            <p class="mt-3 text-xs text-[#141414]/70">{profil.nama}, {profil.kota}</p>
          </div>
        </div>
        <div class="md:col-span-7">
          <h1 class="font-display text-6xl italic leading-[0.95] tracking-tight md:text-8xl">Tentang</h1>
          <p class="mt-8 max-w-xl text-balance font-display text-2xl leading-snug md:text-3xl">{profil.kalimat}</p>
          <div class="mt-8 max-w-[60ch] space-y-5 text-pretty text-base leading-relaxed text-[#141414]/80">
            {profil.tentang.map((p) => <p>{p}</p>)}
          </div>
          <dl class="mt-12 grid grid-cols-1 gap-10 border-t border-[#141414]/15 pt-8 sm:grid-cols-2">
            <div>
              <dt class="text-xs uppercase tracking-widest text-[#141414]/70">Pernah bekerja untuk</dt>
              <dd class="mt-3">
                <ul class="divide-y divide-[#141414]/10 font-display text-xl">
                  {klien.map((k) => <li class="py-1.5">{k}</li>)}
                </ul>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-[#141414]/70">Peralatan</dt>
              <dd class="mt-3">
                <ul class="divide-y divide-[#141414]/10 text-sm text-[#141414]/80">
                  {peralatan.map((p) => <li class="py-2.5">{p}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
          <div class="mt-12 flex flex-col gap-3 border-t border-[#141414]/15 pt-8 sm:flex-row sm:items-center">
            <a href="/kontak/#pesan" class="bg-[#141414] px-6 py-3.5 text-center text-sm text-[#FAFAF9] transition-opacity duration-150 hover:opacity-80">Pesan tanggal</a>
            <a href="/karya/" class="py-3 text-center text-sm underline underline-offset-4 transition-opacity duration-150 hover:opacity-60 sm:px-4">Lihat karya</a>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Base>
