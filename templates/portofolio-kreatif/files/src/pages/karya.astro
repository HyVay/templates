---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profil, karya, kategori, src } from '../data/portofolio';

const rasio = { tinggi: 'aspect-[3/4]', kotak: 'aspect-square', lebar: 'aspect-[4/3]' };
const ukuran = { tinggi: [900, 1200], kotak: [900, 900], lebar: [900, 675] } as const;
const jumlah = (k: string) => (k === 'Semua' ? karya.length : karya.filter((x) => x.kategori === k).length);
---
<Base title={`Karya — ${profil.nama}`} description={`${karya.length} karya pilihan ${profil.nama}: foto keluarga, pernikahan intim, dan produk UMKM di ${profil.kota} dan sekitarnya.`}>
  <Fonts />
  <div class="bg-[#FAFAF9] text-[#141414]">
    <Header />
    <main id="konten" class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-20">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <h1 class="font-display text-6xl italic leading-[0.95] tracking-tight md:text-8xl">Karya</h1>
        <div class="-mx-1 flex flex-wrap gap-x-2" role="group" aria-label="Filter kategori">
          {kategori.map((k, i) => (
            <button
              type="button"
              data-filter={k}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="filter-btn min-h-11 border-b border-transparent px-1 text-sm text-[#141414]/70 transition-colors duration-150 hover:text-[#141414] aria-pressed:border-[#141414] aria-pressed:text-[#141414] sm:px-2"
            >
              {k} <span class="font-mono text-xs tabular-nums">{jumlah(k)}</span>
            </button>
          ))}
        </div>
      </div>

      <p id="status-filter" class="sr-only" aria-live="polite"></p>

      <div id="grid" class="mt-10 columns-1 gap-6 sm:columns-2 lg:columns-3">
        {karya.map((k, i) => (
          <figure id={`karya-${i + 1}`} data-kategori={k.kategori} class="mb-10 scroll-mt-24 break-inside-avoid">
            <img
              src={src(k.foto, ukuran[k.bentuk][0], ukuran[k.bentuk][1])}
              width={ukuran[k.bentuk][0]}
              height={ukuran[k.bentuk][1]}
              alt={k.judul}
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
              class:list={['w-full bg-[#141414]/5 object-cover', rasio[k.bentuk]]}
            />
            <figcaption class="mt-3">
              <span class="flex items-baseline justify-between gap-4">
                <span class="font-display text-xl leading-tight">{k.judul}</span>
                <span class="shrink-0 font-mono text-xs tabular-nums text-[#141414]/70">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <span class="mt-1 block text-xs uppercase tracking-widest text-[#141414]/70">{k.kategori} · {k.lokasi} · <span class="tabular-nums">{k.tahun}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p id="kosong" class="hidden py-16 text-center text-sm text-[#141414]/70">Belum ada karya di kategori ini.</p>

      <div class="mt-10 flex flex-col gap-4 border-t border-[#141414]/15 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-2xl italic md:text-3xl">Suka yang Anda lihat?</p>
        <a href="/kontak/#pesan" class="bg-[#141414] px-6 py-3.5 text-center text-sm text-[#FAFAF9] transition-opacity duration-150 hover:opacity-80">Pesan tanggal</a>
      </div>
    </main>
    <Footer />
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('#grid [data-kategori]');
    const empty = document.getElementById('kosong');
    const status = document.getElementById('status-filter');
    const apply = (pilihan: string) => {
      let terlihat = 0;
      items.forEach((el) => {
        const cocok = pilihan === 'Semua' || el.dataset.kategori === pilihan;
        el.classList.toggle('hidden', !cocok);
        if (cocok) terlihat += 1;
      });
      empty?.classList.toggle('hidden', terlihat > 0);
      if (status) status.textContent = `${terlihat} karya ditampilkan`;
    };
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply(btn.dataset.filter ?? 'Semua');
      });
    });
  </script>
</Base>
