---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabelProgram from '../components/TabelProgram.astro';
import { sekolah, caraMengajar, guru, ppdb, foto, src } from '../data/sekolah';
---
<Base title={`${sekolah.nama} — ${sekolah.jenjang} di ${sekolah.kota}`} description={`${sekolah.nama}, ${sekolah.jenjang} di ${sekolah.kota} sejak ${sekolah.berdiri}. Belajar lewat bermain di sentra, dua guru per kelompok. PPDB ${ppdb.tahun} dibuka.`}>
  <Fonts />
  <Header />
  <main id="konten">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 pb-14 pt-12 md:grid-cols-12 md:items-center md:px-6 md:pb-24 md:pt-20">
        <div class="md:col-span-6">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#B4501A]">{sekolah.jenjang} · {sekolah.kota}</p>
          <h1 class="font-display mt-4 text-balance text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-6xl">Belajar sambil bermain, dengan guru yang sama sepanjang tahun.</h1>
          <p class="mt-6 max-w-lg text-base leading-relaxed text-[#1F4E79]/75 md:text-lg">{sekolah.ringkas}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/ppdb/" class="inline-flex items-center justify-center rounded-2xl bg-[#F28C38] px-6 py-3 text-sm font-bold text-[#13324F] transition-colors duration-150 hover:bg-[#F5A15B]">Info PPDB {ppdb.tahun}</a>
            <a href="/program/" class="inline-flex items-center justify-center rounded-2xl border-2 border-[#1F4E79]/25 px-6 py-3 text-sm font-bold transition-colors duration-150 hover:bg-[#1F4E79]/5">Lihat program</a>
          </div>
        </div>
        <div class="md:col-span-6">
          <div class="relative">
            <span class="pointer-events-none absolute -right-3 -top-3 z-0 h-24 w-24 rounded-full bg-[#F28C38] md:-right-6 md:-top-6 md:h-32 md:w-32" aria-hidden="true"></span>
            <img src={src(foto.hero, 1200, 900)} width="1200" height="900" fetchpriority="high" alt="Guru mendampingi anak membaca di meja kelas" class="relative z-10 aspect-[4/3] w-full rounded-2xl bg-[#1F4E79]/10 object-cover" />
          </div>
          <p class="mt-3 text-xs text-[#1F4E79]/75">Sentra bahasa, kelompok TK A. Dua guru untuk 16 anak.</p>
        </div>
      </div>
    </section>

    <!-- Program -->
    <section class="border-t border-[#1F4E79]/15">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#B4501A]">Program</p>
            <h2 class="font-display mt-2 text-3xl font-semibold md:text-4xl">Tiga kelompok usia</h2>
          </div>
          <a href="/program/" class="text-sm font-bold underline decoration-[#F28C38] decoration-2 underline-offset-4 py-2 transition-colors duration-150 hover:text-[#B4501A]">Jadwal harian lengkap</a>
        </div>
        <div class="mt-8"><TabelProgram /></div>
      </div>
    </section>

    <!-- Cara mengajar -->
    <section class="border-t border-[#1F4E79]/15 bg-white/60">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-5 md:self-start md:sticky md:top-24">
          <p class="text-xs font-bold uppercase tracking-widest text-[#B4501A]">Cara kami mengajar</p>
          <h2 class="font-display mt-2 text-3xl font-semibold leading-tight md:text-4xl">Empat hal yang kami pegang</h2>
          <div class="mt-8 grid grid-cols-2 gap-3">
            <img src={src(foto.kegiatan, 600, 600)} width="600" height="600" alt="Tangan anak-anak menggambar dengan spidol warna" loading="lazy" decoding="async" class="aspect-square w-full rounded-2xl object-cover" />
            <img src={src(foto.alat, 600, 600)} width="600" height="600" alt="Huruf-huruf kayu di meja bermain" loading="lazy" decoding="async" class="mt-8 aspect-square w-full rounded-2xl object-cover" />
          </div>
        </div>
        <ol class="divide-y divide-[#1F4E79]/10 md:col-span-7">
          {caraMengajar.map((c, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 py-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1F4E79] font-display text-base font-semibold text-white">{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-semibold">{c.judul}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-[#1F4E79]/75 md:text-base">{c.isi}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Guru -->
    <section class="border-t border-[#1F4E79]/15">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#B4501A]">Guru</p>
            <h2 class="font-display mt-2 text-3xl font-semibold md:text-4xl">Guru tetap, bukan bergilir</h2>
          </div>
          <a href="/guru/" class="text-sm font-bold underline decoration-[#F28C38] decoration-2 underline-offset-4 py-2 transition-colors duration-150 hover:text-[#B4501A]">Kenali {guru.length} guru kami</a>
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3">
          {guru.slice(0, 3).map((g) => (
            <li>
              <img src={src(g.foto, 600, 600)} width="600" height="600" alt={`Potret ${g.nama}`} loading="lazy" decoding="async" class="aspect-square w-full rounded-2xl bg-[#1F4E79]/10 object-cover" />
              <p class="font-display mt-3 text-lg font-semibold leading-tight">{g.nama}</p>
              <p class="text-sm text-[#1F4E79]/75">{g.peran}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PPDB -->
    <section class="border-t border-[#1F4E79]/15 bg-[#1F4E79] text-white">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
        <div class="md:col-span-8">
          <p class="text-xs font-bold uppercase tracking-widest text-[#F7B27A]">PPDB {ppdb.tahun}</p>
          <h2 class="font-display mt-2 text-3xl font-semibold leading-tight md:text-5xl">{ppdb.gelombang[0].nama} dibuka {ppdb.gelombang[0].periode.split(' – ')[0]}</h2>
          <p class="mt-3 text-sm text-white/70 md:text-base">{ppdb.gelombang[0].catatan}. {ppdb.observasi}</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/ppdb/" class="inline-flex items-center justify-center rounded-2xl bg-[#F28C38] px-8 py-4 text-sm font-bold text-[#13324F] transition-colors duration-150 hover:bg-[#F5A15B]">Daftar sekarang</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
