---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabelProgram from '../components/TabelProgram.astro';
import { sekolah, caraMengajar, guru, ppdb, foto } from '../data/sekolah';
---
<Base title={`${sekolah.nama} — ${sekolah.jenjang} di ${sekolah.kota}`} description={`${sekolah.nama}, ${sekolah.jenjang} di ${sekolah.kota} sejak ${sekolah.berdiri}. Belajar lewat bermain di sentra, dua guru per kelompok. PPDB ${ppdb.tahun} dibuka.`}>
  <Fonts />
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
        <span class="absolute -left-16 -top-16 h-48 w-48 rounded-full bg-[#F28C38]/15 md:-left-10 md:top-24 md:h-40 md:w-40"></span>
      </div>
      <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 pb-14 pt-12 md:grid-cols-12 md:items-center md:px-6 md:pb-24 md:pt-20">
        <div class="md:col-span-6">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#F28C38]">{sekolah.jenjang} · {sekolah.kota}</p>
          <h1 class="font-display mt-4 text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-6xl">Belajar sambil bermain, dengan guru yang sama sepanjang tahun.</h1>
          <p class="mt-6 max-w-lg text-base leading-relaxed text-[#1F4E79]/75 md:text-lg">{sekolah.ringkas}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/ppdb/" class="inline-flex items-center justify-center rounded-2xl bg-[#F28C38] px-6 py-3 text-sm font-bold text-white transition-colors duration-150 hover:bg-[#d9772a]">Info PPDB {ppdb.tahun}</a>
            <a href="/program/" class="inline-flex items-center justify-center rounded-2xl border-2 border-[#1F4E79]/25 px-6 py-3 text-sm font-bold transition-colors duration-150 hover:bg-[#1F4E79]/5">Lihat program</a>
          </div>
        </div>
        <div class="md:col-span-6">
          <img src={foto.hero} alt="Anak-anak membaca buku bersama di meja kelas" class="aspect-[4/3] w-full rounded-2xl object-cover" />
          <p class="mt-3 text-xs text-[#1F4E79]/55">Sentra bahasa, kelompok TK A. Dua guru untuk 16 anak.</p>
        </div>
      </div>
    </section>

    <!-- Program -->
    <section class="border-t border-[#1F4E79]/15">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#F28C38]">Program</p>
            <h2 class="font-display mt-2 text-3xl font-semibold md:text-4xl">Tiga kelompok usia</h2>
          </div>
          <a href="/program/" class="text-sm font-bold underline decoration-[#F28C38] decoration-2 underline-offset-4 transition-colors duration-150 hover:text-[#F28C38]">Jadwal harian lengkap</a>
        </div>
        <div class="mt-8"><TabelProgram /></div>
      </div>
    </section>

    <!-- Cara mengajar -->
    <section class="border-t border-[#1F4E79]/15 bg-white/60">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-5">
          <p class="text-xs font-bold uppercase tracking-widest text-[#F28C38]">Cara kami mengajar</p>
          <h2 class="font-display mt-2 text-3xl font-semibold leading-tight md:text-4xl">Empat hal yang kami pegang</h2>
          <div class="mt-8 grid grid-cols-2 gap-3">
            <img src={foto.kegiatan} alt="Tangan anak-anak menggambar dengan spidol warna" loading="lazy" class="aspect-square w-full rounded-2xl object-cover" />
            <img src={foto.alat} alt="Huruf-huruf kayu di meja bermain" loading="lazy" class="mt-8 aspect-square w-full rounded-2xl object-cover" />
          </div>
        </div>
        <ol class="divide-y divide-[#1F4E79]/10 md:col-span-7">
          {caraMengajar.map((c, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 py-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1F4E79] font-display text-base font-semibold text-white">{i + 1}</span>
              <div>
                <h3 class="font-display text-xl font-semibold">{c.judul}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-[#1F4E79]/75 md:text-base">{c.isi}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Guru -->
    <section class="border-t border-[#1F4E79]/15">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#F28C38]">Guru</p>
            <h2 class="font-display mt-2 text-3xl font-semibold md:text-4xl">Lima guru tetap</h2>
          </div>
          <a href="/guru/" class="text-sm font-bold underline decoration-[#F28C38] decoration-2 underline-offset-4 transition-colors duration-150 hover:text-[#F28C38]">Semua guru</a>
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3">
          {guru.slice(0, 3).map((g) => (
            <li>
              <img src={g.foto} alt={`Potret ${g.nama}`} loading="lazy" class="aspect-square w-full rounded-2xl object-cover" />
              <p class="font-display mt-3 text-lg font-semibold leading-tight">{g.nama}</p>
              <p class="text-sm text-[#1F4E79]/65">{g.peran}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PPDB -->
    <section class="border-t border-[#1F4E79]/15 bg-[#1F4E79] text-white">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
        <div class="md:col-span-8">
          <p class="text-xs font-bold uppercase tracking-widest text-[#F28C38]">PPDB {ppdb.tahun}</p>
          <h2 class="font-display mt-2 text-3xl font-semibold leading-tight md:text-5xl">{ppdb.gelombang[0].nama} dibuka {ppdb.gelombang[0].periode.split(' – ')[0]}</h2>
          <p class="mt-3 text-sm text-white/70 md:text-base">{ppdb.gelombang[0].catatan}. {ppdb.observasi}</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/ppdb/" class="inline-flex items-center justify-center rounded-2xl bg-[#F28C38] px-8 py-4 text-sm font-bold text-white transition-colors duration-150 hover:bg-[#d9772a]">Daftar sekarang</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
