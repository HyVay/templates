---
/** Program per kelompok usia: tabel di desktop, blok bertumpuk di HP. */
import { program, rupiah } from '../data/sekolah';
---
<div class="hidden overflow-hidden rounded-2xl border border-[#1F4E79]/15 bg-white md:block">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-[#1F4E79]/15 bg-[#FFF7E8] text-xs font-bold uppercase tracking-widest text-[#1F4E79]/60">
      <tr>
        <th scope="col" class="px-5 py-3">Kelompok</th>
        <th scope="col" class="px-4 py-3">Usia</th>
        <th scope="col" class="px-4 py-3">Hari</th>
        <th scope="col" class="px-4 py-3">Jam</th>
        <th scope="col" class="px-4 py-3">Guru : anak</th>
        <th scope="col" class="px-5 py-3 text-right">SPP / bulan</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[#1F4E79]/10">
      {program.map((p) => (
        <tr>
          <th scope="row" class="font-display px-5 py-4 text-lg font-semibold">{p.nama}</th>
          <td class="px-4 py-4">{p.usia}</td>
          <td class="px-4 py-4">{p.hari}</td>
          <td class="px-4 py-4 tabular-nums">{p.jam}</td>
          <td class="px-4 py-4 tabular-nums">{p.rasio}</td>
          <td class="px-5 py-4 text-right font-bold tabular-nums">{rupiah(p.spp)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<ul class="divide-y divide-[#1F4E79]/10 rounded-2xl border border-[#1F4E79]/15 bg-white md:hidden">
  {program.map((p) => (
    <li class="p-5">
      <div class="flex items-baseline justify-between gap-3">
        <p class="font-display text-xl font-semibold">{p.nama}</p>
        <p class="text-sm font-bold tabular-nums">{rupiah(p.spp)}<span class="font-normal text-[#1F4E79]/55">/bln</span></p>
      </div>
      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
        {[['Usia', p.usia], ['Hari', p.hari], ['Jam', p.jam], ['Guru : anak', p.rasio]].map(([k, v]) => (
          <div class="border-b border-dotted border-[#1F4E79]/15 py-1">
            <dt class="text-xs text-[#1F4E79]/55">{k}</dt>
            <dd class="tabular-nums">{v}</dd>
          </div>
        ))}
      </dl>
    </li>
  ))}
</ul>
