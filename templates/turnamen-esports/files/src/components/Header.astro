---
import { turnamen } from '../data/turnamen';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/bracket/', label: 'Bracket' },
  { href: '/peraturan/', label: 'Peraturan' },
  { href: '/daftar/', label: 'Daftar' },
];
const here = Astro.url.pathname;
---
<a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[60] focus:bg-[#D92525] focus:px-4 focus:py-3 focus:font-display focus:text-sm focus:font-bold focus:uppercase focus:text-white">Langsung ke konten</a>
<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0A0F1E]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 md:h-16 md:px-6">
    <a href="/" class="font-display text-base font-bold uppercase tracking-wide text-white md:text-lg">
      PKS <span class="text-[#FF3D3D]">2026</span>
    </a>
    <nav class="hidden md:flex md:items-center md:gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={here === l.href ? 'page' : undefined}
          class:list={[
            'font-display text-sm font-semibold uppercase tracking-wider transition-colors duration-150 hover:text-white',
            here === l.href ? 'text-white underline decoration-[#FF3D3D] decoration-2 underline-offset-8' : 'text-white/60',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/daftar/"
        class="font-display bg-[#D92525] inline-flex min-h-[40px] items-center px-4 text-sm font-bold uppercase tracking-wider text-white transition-colors duration-150 hover:bg-[#B91C1C]"
      >
        Daftar tim
      </a>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-11 w-11 items-center justify-center text-white transition-colors duration-150 hover:bg-white/10 md:hidden"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-[#0A0F1E] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {links.map((l) => (
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="font-display block border-l-2 border-transparent px-2 py-3 aria-[current=page]:border-[#FF3D3D] aria-[current=page]:text-[#FF3D3D] text-base font-semibold uppercase tracking-wider text-white transition-colors duration-150 hover:bg-white/5">
          {l.label}
        </a>
      ))}
      <a href="/daftar/" class="font-display mt-3 flex min-h-[48px] items-center justify-center bg-[#D92525] text-sm font-bold uppercase tracking-wider text-white">Daftar tim · sisa {turnamen.sisaSlot} slot</a>
      <p class="mt-3 px-2 pb-2 text-xs text-white/60">{turnamen.nama}</p>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const set = (isOpen: boolean) => {
    btn?.setAttribute('aria-expanded', String(isOpen));
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
