---
/**
 * Bagan playoff 8 tim: QF → SF → Final, diisi dari data/turnamen.ts.
 * Desktop: tiga kolom dengan garis penghubung antar babak. HP: bertumpuk per babak.
 */
import { bracket, type Pertandingan } from '../data/turnamen';

const babak: { kode: string; judul: string; keterangan: string; laga: Pertandingan[] }[] = [
  { kode: 'QF', judul: 'Perempat final', keterangan: 'Bo3 · Sabtu 14.00', laga: bracket.qf },
  { kode: 'SF', judul: 'Semifinal', keterangan: 'Bo3 · Sabtu 19.00', laga: bracket.sf },
  { kode: 'F', judul: 'Grand final', keterangan: 'Bo5 · Minggu 16.00', laga: bracket.final },
];

/** Laga dikelompokkan berpasangan; tiap pasangan mengalir ke satu laga di babak berikutnya. */
const pasang = (laga: Pertandingan[]) =>
  laga.length === 1 ? [laga] : laga.reduce<Pertandingan[][]>((acc, m, i) => (i % 2 ? acc[acc.length - 1].push(m) : acc.push([m]), acc), []);

const dimainkan = (m: Pertandingan) => m.skorA !== null && m.skorB !== null;
const menang = (m: Pertandingan, sisi: 'a' | 'b') =>
  dimainkan(m) && (sisi === 'a' ? (m.skorA as number) > (m.skorB as number) : (m.skorB as number) > (m.skorA as number));
---
<div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-6">
  {babak.map((b, i) => {
    const adaLanjut = i < babak.length - 1;
    let nomor = 0;
    return (
      <section class="flex flex-col" aria-labelledby={`babak-${b.kode}`}>
        <div class="border-b-2 border-[#FF3D3D] pb-2">
          <h2 id={`babak-${b.kode}`} class="font-display text-lg font-bold uppercase tracking-wide">{b.judul}</h2>
          <p class="font-mono text-xs uppercase tracking-widest text-white/60">{b.keterangan}</p>
        </div>
        <div class="mt-4 flex flex-1 flex-col gap-3 md:mt-2 md:gap-0">
          {pasang(b.laga).map((grup) => (
            <ol
              class:list={[
                'relative flex flex-col gap-3 md:flex-1 md:justify-around md:gap-0',
                adaLanjut && grup.length === 2 &&
                  'md:before:pointer-events-none md:before:absolute md:before:-right-3 md:before:bottom-1/4 md:before:top-1/4 md:before:w-3 md:before:border-y md:before:border-r md:before:border-white/25',
              ]}
            >
              {grup.map((m) => {
                nomor += 1;
                return (
                  <li
                    class:list={[
                      'relative border border-white/15 bg-[#0F1629] md:my-2',
                      i > 0 && 'md:after:pointer-events-none md:after:absolute md:after:right-full md:after:top-1/2 md:after:w-3 md:after:border-t md:after:border-white/25',
                      adaLanjut && grup.length === 1 && 'md:before:absolute md:before:left-full md:before:top-1/2 md:before:w-3 md:before:border-t md:before:border-white/25',
                    ]}
                  >
                    <p class="flex items-center justify-between border-b border-white/10 px-3 py-1.5 font-mono text-[11px] uppercase tracking-widest text-white/60">
                      <span>{b.kode}{b.laga.length > 1 ? nomor : ''}</span>
                      <span class:list={[dimainkan(m) ? '' : 'text-[#FF3D3D]']}>{dimainkan(m) ? 'Selesai' : 'Belum dimainkan'}</span>
                    </p>
                    {(['a', 'b'] as const).map((sisi) => (
                      <div
                        class:list={[
                          'flex items-center justify-between gap-3 border-l-2 px-3 py-2.5',
                          sisi === 'a' ? 'border-b border-b-white/10' : '',
                          menang(m, sisi) ? 'border-l-[#FF3D3D] text-white' : 'border-l-transparent',
                          dimainkan(m) && !menang(m, sisi) ? 'text-white/65' : 'text-white',
                        ]}
                      >
                        <span class:list={['truncate text-sm', menang(m, sisi) ? 'font-semibold' : '', m[sisi].startsWith('Menunggu') && 'italic text-white/60']}>
                          {m[sisi]}{menang(m, sisi) && <span class="sr-only"> (menang)</span>}
                        </span>
                        <span class:list={['font-display w-6 shrink-0 text-right text-lg font-bold tabular-nums', menang(m, sisi) ? 'text-[#FF3D3D]' : '']}>
                          {dimainkan(m) ? m[sisi === 'a' ? 'skorA' : 'skorB'] : '–'}
                        </span>
                      </div>
                    ))}
                  </li>
                );
              })}
            </ol>
          ))}
        </div>
      </section>
    );
  })}
</div>
