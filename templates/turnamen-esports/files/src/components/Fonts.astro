---
// Font dimuat dari Google Fonts. Ganti family di sini dan di .font-display/.font-body.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Rubik:wght@400;500&display=swap" />
<style is:global>
  body { font-family: 'Rubik', ui-sans-serif, system-ui, sans-serif; background: #0A0F1E; color: #F4F6FA; }
  .font-display { font-family: 'Chakra Petch', 'Arial Narrow', sans-serif; }
  .font-body { font-family: 'Rubik', ui-sans-serif, system-ui, sans-serif; }
</style>
