---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { turnamen, hadiah, format, jadwal, rupiah, foto } from '../data/turnamen';

const totalHadiah = hadiah.reduce((s, h) => s + h.nominal, 0);
const stub = [
  { label: 'Tanggal', nilai: turnamen.tanggalTeks },
  { label: 'Venue', nilai: turnamen.venue },
  { label: 'Biaya daftar', nilai: `${rupiah(turnamen.biayaDaftar)} / tim` },
  { label: 'Slot tersisa', nilai: `${turnamen.sisaSlot} dari ${turnamen.jumlahTim} tim` },
];
---
<Base
  title={`${turnamen.nama} — Turnamen ${turnamen.game}`}
  description={`${turnamen.nama}: turnamen ${turnamen.game} ${turnamen.jumlahTim} tim di ${turnamen.kota}, ${turnamen.tanggalTeks}. Total hadiah ${rupiah(totalHadiah)}. Daftar via WhatsApp.`}
>
  <Fonts />
  <Header />
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pb-12 pt-14 md:px-6 md:pb-20 md:pt-24">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#FF3D3D]">
        {turnamen.game} · {turnamen.jumlahTim} tim · {turnamen.edisi}
      </p>
      <h1 class="font-display mt-5 text-5xl font-bold uppercase leading-[0.9] tracking-tight sm:text-6xl md:text-8xl">
        Piala Komunitas<br />Semarang <span class="text-[#FF3D3D]">2026</span>
      </h1>
      <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
        <p class="max-w-xl text-base leading-relaxed text-white/70 md:col-span-7 md:text-lg">{turnamen.ringkas}</p>
        <div class="border-l-2 border-[#FF3D3D] pl-5 md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-white/50">Total hadiah</p>
          <p class="font-display mt-1 text-4xl font-bold tabular-nums sm:text-5xl md:text-6xl">{rupiah(totalHadiah)}</p>
          <p class="mt-2 text-sm text-white/60">Juara 1, 2, 3, dan MVP. Dibayar tunai di panggung, hari ketiga.</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="/daftar/" class="font-display inline-flex items-center justify-center bg-[#FF3D3D] px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-colors duration-150 hover:bg-[#e03030]">Daftar tim</a>
            <a href="/bracket/" class="font-display inline-flex items-center justify-center border border-white/30 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-colors duration-150 hover:bg-white/10">Lihat bracket</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Ticket stub -->
    <section class="border-y border-white/10">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 divide-white/10 md:grid-cols-4 md:divide-x">
        {stub.map((s) => (
          <div class="border-b border-white/10 px-4 py-5 md:border-b-0 md:px-6">
            <dt class="font-mono text-[11px] uppercase tracking-widest text-white/40">{s.label}</dt>
            <dd class="font-display mt-1 text-base font-semibold uppercase tracking-wide">{s.nilai}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Foto -->
    <section class="relative overflow-hidden border-b border-white/10">
      <img src={foto.hero} alt="Suasana arena turnamen dengan layar besar dan pemain di depan PC" class="aspect-[16/9] w-full object-cover grayscale md:aspect-[21/9]" />
      <p class="absolute bottom-0 left-0 bg-[#0A0F1E] px-4 py-2 font-mono text-xs uppercase tracking-widest text-white/70 md:px-6">
        Panggung utama · {turnamen.venue}
      </p>
    </section>

    <!-- Format -->
    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <p class="font-mono text-xs uppercase tracking-widest text-[#FF3D3D]">Format</p>
          <h2 class="font-display mt-3 text-3xl font-bold uppercase leading-none md:text-4xl">Tiga babak, tiga hari</h2>
        </div>
        <ol class="grid grid-cols-1 gap-8 md:col-span-8 md:grid-cols-3 md:gap-6">
          {format.map((f, i) => (
            <li class="border-t border-white/20 pt-4">
              <span class="font-display text-3xl font-bold text-[#FF3D3D]">0{i + 1}</span>
              <h3 class="font-display mt-3 text-lg font-bold uppercase tracking-wide">{f.judul}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{f.isi}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Hadiah -->
    <section class="border-y border-white/10 bg-white/[0.03]">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <p class="font-mono text-xs uppercase tracking-widest text-[#FF3D3D]">Hadiah</p>
        <h2 class="font-display mt-3 text-3xl font-bold uppercase leading-none md:text-4xl">Pembagian hadiah</h2>
        <ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
          {hadiah.map((h) => (
            <li class="grid grid-cols-1 gap-2 py-5 sm:grid-cols-12 sm:items-baseline sm:gap-4">
              <p class="font-display text-lg font-semibold uppercase tracking-wide sm:col-span-4">{h.posisi}</p>
              <p class="font-display text-3xl font-bold tabular-nums sm:col-span-4 md:text-4xl">{rupiah(h.nominal)}</p>
              <p class="text-sm text-white/55 sm:col-span-4">{h.tambahan}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Jadwal -->
    <section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <p class="font-mono text-xs uppercase tracking-widest text-[#FF3D3D]">Jadwal</p>
      <h2 class="font-display mt-3 text-3xl font-bold uppercase leading-none md:text-4xl">Rundown</h2>
      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
        {jadwal.map((h) => (
          <div class="border-t-2 border-white/20 pt-4">
            <p class="font-display text-xl font-bold uppercase">{h.hari}</p>
            <p class="font-mono text-xs uppercase tracking-widest text-white/50">{h.tanggal}</p>
            <ul class="mt-4 divide-y divide-white/10">
              {h.sesi.map((s) => (
                <li class="flex gap-4 py-2.5 text-sm">
                  <span class="w-12 shrink-0 font-mono text-[#FF3D3D]">{s.jam}</span>
                  <span class="text-white/80">{s.apa}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/10">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-6 px-4 py-14 md:grid-cols-12 md:px-6">
        <div class="md:col-span-8">
          <h2 class="font-display text-3xl font-bold uppercase leading-none md:text-5xl">Sisa {turnamen.sisaSlot} slot tim</h2>
          <p class="mt-3 text-sm text-white/60 md:text-base">Pendaftaran ditutup {turnamen.batasDaftar}, atau lebih cepat bila kuota {turnamen.jumlahTim} tim penuh.</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a href="/daftar/" class="font-display inline-flex items-center justify-center bg-[#FF3D3D] px-8 py-4 text-sm font-bold uppercase tracking-wider text-white transition-colors duration-150 hover:bg-[#e03030]">Daftar sekarang</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
