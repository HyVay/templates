---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Bracket from '../components/Bracket.astro';
import { turnamen } from '../data/turnamen';
---
<Base
  title={`Bracket — ${turnamen.nama}`}
  description={`Bagan playoff 8 besar ${turnamen.nama}: perempat final, semifinal, dan grand final ${turnamen.game}, diperbarui setelah tiap pertandingan.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#FF3D3D]">Playoff 8 besar</p>
        <h1 class="font-display mt-4 text-5xl font-bold uppercase leading-[0.9] md:text-7xl">Bracket</h1>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-white/65 md:text-base">
          Diperbarui panitia setelah tiap pertandingan selesai. Skor adalah jumlah game yang dimenangkan dalam satu seri. Tim yang kalah di semifinal memperebutkan juara 3 pada hari ketiga.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
      <Bracket />
      <p class="mt-8 flex items-center gap-3 text-sm text-white/65"><span class="inline-block h-4 w-0.5 bg-[#FF3D3D]" aria-hidden="true"></span>Garis merah menandai pemenang tiap laga.</p>
    </section>

    <section class="border-t border-white/10">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 md:grid-cols-12 md:px-6 md:py-16">
        <div class="md:col-span-5">
          <p class="font-mono text-xs uppercase tracking-widest text-[#FF3D3D]">Cara lolos playoff</p>
          <p class="mt-3 max-w-[52ch] text-[15px] leading-relaxed text-white/75 md:text-base">
            Dua tim teratas tiap grup lolos. Bila poin sama, urutan ditentukan head-to-head, lalu selisih waktu kemenangan. Hasil fase grup lengkap ditempel di papan venue dan diunggah ke Instagram {turnamen.instagram}.
          </p>
        </div>
        <dl class="divide-y divide-white/10 border-y border-white/10 md:col-span-7">
          {[
            { k: 'Bo3', v: 'Best of three. Tim pertama yang menang 2 game lolos ke babak berikutnya.' },
            { k: 'Bo5', v: 'Best of five, khusus grand final. Juara adalah tim pertama yang menang 3 game.' },
            { k: 'Juara 3', v: 'Dua tim yang kalah di semifinal bertanding Bo3 pada hari ketiga, sebelum grand final.' },
            { k: 'Jeda', v: 'Antar-game maksimal 5 menit. Tim yang terlambat 10 menit dinyatakan kalah WO.' },
          ].map((r) => (
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-12 sm:gap-4">
              <dt class="font-display text-base font-bold uppercase tracking-wide text-[#FF3D3D] sm:col-span-3">{r.k}</dt>
              <dd class="text-sm leading-relaxed text-white/75 sm:col-span-9">{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</Base>
