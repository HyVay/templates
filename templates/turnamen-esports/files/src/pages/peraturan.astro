---
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { turnamen, peraturan } from '../data/turnamen';

let nomor = 0;
---
<Base
  title={`Peraturan — ${turnamen.nama}`}
  description={`Peraturan ${turnamen.nama}: roster, jalannya pertandingan, perangkat, sportivitas, dan sanksi. Dibaca kapten sebelum technical meeting.`}
>
  <Fonts />
  <Header />
  <main id="konten">
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#FF3D3D]">Wajib dibaca kapten</p>
        <h1 class="font-display mt-4 text-5xl font-bold uppercase leading-[0.9] md:text-7xl">Peraturan</h1>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-white/65 md:text-base">
          Versi ini berlaku untuk {turnamen.nama}. Perubahan diumumkan saat technical meeting dan di grup WhatsApp kapten.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
      {peraturan.map((bagian) => (
        <div class="grid grid-cols-1 gap-4 border-t border-white/15 py-8 md:grid-cols-12 md:gap-8">
          <h2 class="font-display text-2xl font-bold uppercase leading-none md:col-span-4 md:text-3xl">{bagian.judul}</h2>
          <ol class="divide-y divide-white/10 md:col-span-8">
            {bagian.poin.map((p) => {
              nomor += 1;
              return (
                <li class="grid grid-cols-[3rem_1fr] gap-3 py-4">
                  <span class="font-display text-xl font-bold text-[#FF3D3D]">{String(nomor).padStart(2, '0')}</span>
                  <p class="text-sm leading-relaxed text-white/80 md:text-base">{p}</p>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>
  </main>
  <Footer />
</Base>
